# Per-worktree port config. Copy to .env.ports and assign unique values.
# Local launchers require explicit ports; they do not fall back to shared defaults.
GATEWAY_PORT=7777
METRO_PORT=7677
VITE_PORT=5174

# Optional Command Center UI configuration. These are deployment/local-machine
# values; Farmslot must not guess phone-reachable URLs from the browser URL.
# Browser UI -> gateway. Usually blank in local dev because Vite proxies /ws.
# VITE_FARMSLOT_GATEWAY_URL=ws://localhost:${GATEWAY_PORT}/ws
# Companion on same Wi-Fi -> gateway.
# VITE_FARMSLOT_PAIRING_GATEWAY_URL=ws://your-host.local:${GATEWAY_PORT}/ws
# Companion over the internet -> gateway.
# VITE_FARMSLOT_REMOTE_GATEWAY_URL=wss://your-gateway.example.com/ws
