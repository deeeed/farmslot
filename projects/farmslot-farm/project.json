{
  "$schema": "../../schemas/project.schema.json",
  "name": "farmslot-farm",
  "type": "monorepo",
  "default_branch": "main",
  "default_safety_tier": "dangerous",
  "primary_repo": "/Users/deeeed/dev/farmslot",
  "worktree_base": "/Users/deeeed/dev/farmslot-wt",
  "paths": {
    "runtime_dir": ".sandbox/farmslot-farm/agent",
    "artifact_dir": ".sandbox/farmslot-farm/task"
  },
  "defaults": {
    "fix": {
      "runner": "claude",
      "model": "sonnet"
    },
    "feature": {
      "runner": "claude",
      "model": "sonnet"
    },
    "review": {
      "runner": "claude",
      "model": "opus"
    }
  },
  "hooks": {
    "post_merge_install": "cd apps/command-center && yarn install",
    "preflight": "cd apps/command-center && yarn typecheck",
    "health_check": "bash {{repo}}/projects/farmslot-farm/setup/sandbox-dev.sh health --gateway-port {{port}}",
    "dev_server_check": "bash {{repo}}/projects/farmslot-farm/setup/sandbox-dev.sh health --gateway-port {{port}}",
    "teardown": "bash {{repo}}/projects/farmslot-farm/setup/sandbox-dev.sh stop --gateway-port {{port}}"
  },
  "prepare": {
    "default": "sandbox",
    "profiles": {
      "sandbox": {
        "label": "Worktree sandbox — sync + start gateway (tsx watch)",
        "description": "Git sync, deps, then boot this checkout's gateway and Vite UI on the slot port. Use for ff-* worktree sandboxes. Typecheck is not run here — use profile full when you need it before dispatch.",
        "phases": ["git", "fixtures", "deps", "preflight", "health"],
        "hooks": {
          "preflight": "bash {{repo}}/projects/farmslot-farm/setup/sandbox-dev.sh start --gateway-port {{port}}"
        }
      },
      "attach": {
        "label": "Reuse running gateway",
        "description": "Health-check only when gateway is already up (main operator / farmdev).",
        "phases": ["health"],
        "requires": ["dev_server_up", "health_ok"],
        "fallback": "sandbox"
      },
      "full": {
        "label": "Sync + typecheck (no gateway lifecycle)",
        "description": "Git sync and typecheck without starting or restarting the gateway process.",
        "phases": ["git", "fixtures", "deps", "preflight", "health"],
        "hooks": {
          "preflight": "cd apps/command-center && yarn typecheck",
          "health_check": "cd apps/command-center && yarn typecheck && echo ok"
        }
      }
    }
  },
  "health": {
    "dev_server_name": "Gateway",
    "dev_server_log": ".sandbox/farmslot-farm/agent/sandbox-dev.log"
  },
  "fixtures": {
    "templates": [
      {
        "dst": ".sandbox/farmslot-farm/claude/CLAUDE.local.md",
        "compose": {
          "var": "FLOW_TYPE",
          "variants": {
            "": {
              "file": "CLAUDE.local.base.md"
            },
            "fix-bug": {
              "includes": ["CLAUDE.local.agent.fix-bug.md", "CLAUDE.local.base.md"]
            },
            "new-feature": {
              "includes": ["CLAUDE.local.agent.feature.md", "CLAUDE.local.base.md"]
            },
            "review-pr": {
              "includes": ["CLAUDE.local.agent.review-pr.md", "CLAUDE.local.base.md"]
            }
          }
        }
      }
    ]
  },
  "external": {
    "mock_mode": true,
    "fixtures_dir": "test-data"
  },
  "self_review": {
    "enabled": false
  },
  "publication_review": {
    "fix-bug": {
      "minimum_independent_reviews": 1
    },
    "dev": {
      "minimum_independent_reviews": 0
    }
  },
  "platforms": {
    "cli": {
      "device_check": "true"
    }
  },
  "resources": {
    "dev-server": {
      "type": "dev-server",
      "label": "Gateway",
      "streamable": false,
      "controllable": true,
      "watch": {
        "type": "port-listen",
        "port": "{{port}}"
      },
      "hooks": {
        "health": "bash {{repo}}/projects/farmslot-farm/setup/sandbox-dev.sh health --gateway-port {{port}}",
        "shutdown": "bash {{repo}}/projects/farmslot-farm/setup/sandbox-dev.sh stop --gateway-port {{port}}"
      }
    }
  },
  "task_dir": ".sandbox/farmslot-farm/worker-task"
}