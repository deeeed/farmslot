{
  "$schema": "../../schemas/project.schema.json",
  "name": "farmslot-farm",
  "type": "monorepo",
  "default_branch": "main",
  "default_safety_tier": "dangerous",
  "primary_repo": "/Users/deeeed/dev/farmslot",
  "artifacts_repo": "deeeed/farmslot-artifacts",
  "worktree_base": "/Users/deeeed/dev/farmslot-wt",
  "slot_tracking_branch": "wt/{{session}}",
  "apps": ["command-center", "companion"],
  "paths": {
    "runtime_dir": ".sandbox/farmslot-farm/agent",
    "artifact_dir": ".sandbox/farmslot-farm/task"
  },
  "defaults": {
    "fix": {
      "runner": "claude",
      "model": "sonnet"
    },
    "feature": {
      "runner": "claude",
      "model": "sonnet"
    },
    "review": {
      "runner": "claude",
      "model": "sonnet"
    }
  },
  "hooks": {
    "post_merge_install": "yarn install",
    "preflight": "cd apps/command-center && yarn typecheck",
    "health_check": "FARMSLOT_SLOT_REPO={{repo}} bash {{primary_repo}}/projects/farmslot-farm/setup/sandbox-dev.sh health --gateway-port {{port}}",
    "dev_server_check": "FARMSLOT_SLOT_REPO={{repo}} bash {{primary_repo}}/projects/farmslot-farm/setup/sandbox-dev.sh health --gateway-port {{port}}",
    "teardown": "FARMSLOT_SLOT_REPO={{repo}} bash {{primary_repo}}/projects/farmslot-farm/setup/sandbox-dev.sh stop --gateway-port {{port}}",
    "setup": "cd apps/companion && yarn install",
    "recipe_action_manifest": "cat {{farmslot_dir}}/docs/examples/recipes/farmslot-v1.action-manifest.json",
    "recipe_doctor": "FARMSLOT_SLOT_REPO={{repo}} node {{primary_repo}}/apps/command-center/scripts/agentic/recipe-doctor.mjs --cdp-port {{cdp_port}} --gateway-port {{port}} --slot-id {{slot_id}} --project-root {{repo}} --json",
    "recipe_run": "bash {{primary_repo}}/projects/farmslot-farm/setup/validate-recipe.sh --recipe {{recipe_path}} --artifacts-dir {{artifacts_dir}} --runtime-dir {{runtime_dir}} --platform {{platform}} --cdp-port {{cdp_port}} --gateway-port {{port}} --metro-port {{port}} --simulator {{simulator}} --adb-serial {{adb_serial}} --slot-id {{slot_id}} --run-id={{run_id}} --recipe-run-id={{recipe_run_id}}"
  },
  "prepare": {
    "default": "sandbox",
    "profiles": {
      "sandbox": {
        "label": "Worktree sandbox — sync + start gateway (tsx watch)",
        "description": "Git sync, deps, then boot this checkout's gateway and Vite UI on the slot port. Use for ff-* worktree sandboxes. Typecheck is not run here — use profile typecheck when you need it before dispatch.",
        "phases": ["git", "fixtures", "deps", "preflight", "health"],
        "hooks": {
          "preflight": "FARMSLOT_SLOT_REPO={{repo}} bash {{primary_repo}}/projects/farmslot-farm/setup/sandbox-dev.sh start --gateway-port {{port}}"
        }
      },
      "attach": {
        "label": "Reuse running gateway",
        "description": "Health-check only when gateway is already up (main operator / farmdev).",
        "phases": ["health"],
        "requires": ["dev_server_up", "health_ok"],
        "fallback": "sandbox"
      },
      "typecheck": {
        "label": "Sync + typecheck (no gateway lifecycle)",
        "description": "Git sync and typecheck without starting or restarting the gateway process.",
        "phases": ["git", "fixtures", "deps", "preflight", "health"],
        "hooks": {
          "preflight": "cd apps/command-center && yarn typecheck",
          "health_check": "cd apps/command-center && yarn typecheck && echo ok"
        }
      },
      "full": {
        "label": "Alias for typecheck (legacy farmslot-farm name)",
        "description": "Backward-compatible name for the typecheck-only prepare profile.",
        "phases": ["git", "fixtures", "deps", "preflight", "health"],
        "hooks": {
          "preflight": "cd apps/command-center && yarn typecheck",
          "health_check": "cd apps/command-center && yarn typecheck && echo ok"
        }
      },
      "companion-warm": {
        "label": "Companion warm — Metro + dev client",
        "description": "Boot isolated simulator when configured, start Metro on the derived slot port, and verify gateway pairing URL. No native rebuild.",
        "phases": ["git", "fixtures", "deps", "preflight", "health"],
        "hooks": {
          "preflight": "FARMSLOT_SLOT_REPO={{repo}} bash {{primary_repo}}/projects/farmslot-farm/setup/companion-prepare.sh warm --slot-port {{port}} --platform {{platform}} --simulator {{simulator}} --adb-serial {{adb_serial}}",
          "health_check": "FARMSLOT_SLOT_REPO={{repo}} bash {{primary_repo}}/projects/farmslot-farm/setup/companion-prepare.sh health --slot-port {{port}} --platform {{platform}}",
          "dev_server_check": "FARMSLOT_SLOT_REPO={{repo}} bash {{primary_repo}}/projects/farmslot-farm/setup/companion-prepare.sh health --slot-port {{port}} --platform {{platform}}"
        },
        "fallback": "companion-full"
      },
      "companion-full": {
        "label": "Companion full — native build + Metro",
        "description": "Native rebuild via expo run when simulator or adb is configured, then warm Metro health.",
        "phases": ["git", "fixtures", "deps", "preflight", "health"],
        "hooks": {
          "preflight": "FARMSLOT_SLOT_REPO={{repo}} bash {{primary_repo}}/projects/farmslot-farm/setup/companion-prepare.sh full --slot-port {{port}} --platform {{platform}} --simulator {{simulator}} --adb-serial {{adb_serial}}",
          "health_check": "FARMSLOT_SLOT_REPO={{repo}} bash {{primary_repo}}/projects/farmslot-farm/setup/companion-prepare.sh health --slot-port {{port}} --platform {{platform}} && cd apps/companion && yarn typecheck"
        }
      },
      "sandbox-companion": {
        "label": "Gateway sandbox + companion warm",
        "description": "Start this checkout's gateway on the slot port, then boot companion Metro (derived port) for cross-surface tasks.",
        "phases": ["git", "fixtures", "deps", "preflight", "health"],
        "hooks": {
          "preflight": "FARMSLOT_SLOT_REPO={{repo}} bash {{primary_repo}}/projects/farmslot-farm/setup/sandbox-companion.sh --gateway-port {{port}} --simulator {{simulator}} --adb-serial {{adb_serial}}",
          "health_check": "FARMSLOT_SLOT_REPO={{repo}} bash {{primary_repo}}/projects/farmslot-farm/setup/sandbox-dev.sh health --gateway-port {{port}}"
        }
      }
    }
  },
  "recipe_run_supports_playback_slow": true,
  "recipe_run_supports_video_recording": true,
  "health": {
    "dev_server_name": "Gateway",
    "dev_server_log": ".sandbox/farmslot-farm/agent/sandbox-dev.log"
  },
  "fixtures": {
    "templates": [
      {
        "src": "runtime/recipe-quality.md",
        "dst": "{{runtime_dir}}/recipe-quality.md"
      },
      {
        "src": "runtime/review-quality.md",
        "dst": "{{runtime_dir}}/review-quality.md"
      },
      {
        "dst": ".sandbox/farmslot-farm/claude/CLAUDE.local.md",
        "compose": {
          "var": "FLOW_TYPE",
          "variants": {
            "": {
              "file": "CLAUDE.local.base.md"
            },
            "fix-bug": {
              "includes": ["CLAUDE.local.agent.fix-bug.md", "CLAUDE.local.agent.companion-mobile.md", "CLAUDE.local.base.md"]
            },
            "dev": {
              "includes": ["CLAUDE.local.agent.companion-mobile.md", "CLAUDE.local.base.md"]
            },
            "new-feature": {
              "includes": ["CLAUDE.local.agent.feature.md", "CLAUDE.local.base.md"]
            },
            "review-pr": {
              "includes": ["CLAUDE.local.agent.review-pr.md", "CLAUDE.local.base.md"]
            },
            "companion-mobile": {
              "includes": ["CLAUDE.local.agent.companion-mobile.md", "CLAUDE.local.base.md"]
            }
          }
        }
      }
    ]
  },
  "external": {
    "mock_mode": true,
    "fixtures_dir": "test-data"
  },
  "self_review": {
    "enabled": false,
    "review_timeout_min": 75
  },
  "ci": {
    "enabled": true,
    "repo": "deeeed/farmslot"
  },
  "publication_review": {
    "fix-bug": {
      "minimum_independent_reviews": 1
    },
    "dev": {
      "minimum_independent_reviews": 0
    }
  },
  "platforms": {
    "cli": {
      "device_check": "true"
    },
    "ios": {
      "device_check": "xcrun simctl list devices booted 2>/dev/null | grep -q '{{simulator}}'",
      "recycle": "xcrun simctl shutdown '{{simulator}}'"
    },
    "android": {
      "device_check": "adb -s {{adb_serial}} get-state 2>/dev/null | grep -q device",
      "recycle": "adb -s {{adb_serial}} shell pm clear net.siteed.farmslot.companion.development"
    }
  },
  "resources": {
    "dev-server": {
      "type": "dev-server",
      "label": "Gateway",
      "streamable": false,
      "controllable": true,
      "watch": {
        "type": "port-listen",
        "port": "{{port}}"
      },
      "hooks": {
        "health": "FARMSLOT_SLOT_REPO={{repo}} bash {{primary_repo}}/projects/farmslot-farm/setup/sandbox-dev.sh health --gateway-port {{port}}",
        "shutdown": "FARMSLOT_SLOT_REPO={{repo}} bash {{primary_repo}}/projects/farmslot-farm/setup/sandbox-dev.sh stop --gateway-port {{port}}"
      }
    },
    "ios-sim": {
      "type": "device",
      "platform": "ios",
      "label": "iOS Sim",
      "streamable": true,
      "controllable": true,
      "watch": {
        "type": "process-poll",
        "cmd": "xcrun simctl list devices booted 2>/dev/null | grep -q '{{simulator}}'"
      },
      "hooks": {
        "health": "xcrun simctl list devices booted 2>/dev/null | grep -q '{{simulator}}'",
        "boot": "xcrun simctl boot '{{simulator}}'",
        "shutdown": "xcrun simctl shutdown '{{simulator}}'"
      }
    },
    "android-device": {
      "type": "device",
      "platform": "android",
      "label": "Android Device",
      "streamable": true,
      "controllable": true,
      "watch": {
        "type": "process-poll",
        "cmd": "adb -s {{adb_serial}} get-state 2>/dev/null | grep -q device"
      },
      "hooks": {
        "health": "adb -s {{adb_serial}} get-state 2>/dev/null | grep -q device",
        "shutdown": "true"
      }
    }
  },
  "task_dir": ".sandbox/farmslot-farm/worker-task",
  "vars": {
    "recipe_runner_resolve_cmd": "{{primary_repo}}/apps/command-center/scripts/agentic/run-recipe.mjs",
    "recipe_manifest_path": "{{farmslot_dir}}/docs/examples/recipes/farmslot-v1.action-manifest.json",
    "recipe_validate_wrapper": "{{primary_repo}}/projects/farmslot-farm/setup/validate-recipe.sh",
    "recipe_sync_evidence_cmd": "bash {{primary_repo}}/projects/farmslot-farm/setup/sync-recipe-evidence.sh",
    "recipe_quality_path": "{{runtime_dir}}/recipe-quality.md",
    "review_quality_path": "{{runtime_dir}}/review-quality.md",
    "recipe_example_banner": "{{farmslot_dir}}/docs/examples/recipes/farmslot/demo-red-banner.recipe.json"
  },
  "worker_terminal": {
    "requireSignal": true,
    "whenPresent": [
      {
        "path": "artifacts/recipe.json",
        "alsoRequire": ["artifacts/recipe-coverage.md", "artifacts/evidence-manifest.json"],
        "requireRecipeQuality": true,
        "requireRecipeCoverage": true
      }
    ]
  }
}
