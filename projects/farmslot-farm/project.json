{
  "$schema": "../../schemas/project.schema.json",
  "name": "farmslot-farm",
  "type": "monorepo",
  "default_branch": "main",
  "default_safety_tier": "dangerous",
  "primary_repo": "/Users/deeeed/dev/farmslot",
  "artifacts_repo": "deeeed/farmslot-artifacts",
  "worktree_base": "/Users/deeeed/dev/farmslot-wt",
  "slot_tracking_branch": "wt/{{session}}",
  "apps": ["command-center", "companion"],
  "paths": {
    "runtime_dir": ".sandbox/farmslot-farm/agent",
    "artifact_dir": ".sandbox/farmslot-farm/task"
  },
  "static_review": {
    "instruction_files": ["runtime/review-quality.md"]
  },
  "node_support": {
    "paths": ["projects/farmslot-farm/setup"]
  },
  "defaults": {
    "fix": {
      "runner": "claude",
      "model": "sonnet"
    },
    "feature": {
      "runner": "claude",
      "model": "sonnet"
    },
    "review": {
      "runner": "claude",
      "model": "sonnet"
    }
  },
  "hooks": {
    "post_merge_install": "yarn install",
    "preflight": "cd apps/command-center && yarn typecheck",
    "health_check": "FARMSLOT_SLOT_REPO={{repo}} bash {{repo}}/projects/farmslot-farm/setup/sandbox-dev.sh health --gateway-port {{port}}",
    "dev_server_check": "FARMSLOT_SLOT_REPO={{repo}} bash {{repo}}/projects/farmslot-farm/setup/sandbox-dev.sh health --gateway-port {{port}}",
    "teardown": "FARMSLOT_SLOT_REPO={{repo}} bash {{repo}}/projects/farmslot-farm/setup/sandbox-dev.sh stop --gateway-port {{port}}",
    "setup": "cd apps/companion && yarn install",
    "recipe_action_manifest": "cat {{farmslot_dir}}/docs/examples/recipes/farmslot-v1.action-manifest.json",
    "recipe_doctor": "FARMSLOT_SLOT_REPO={{repo}} node {{repo}}/apps/command-center/scripts/agentic/recipe-doctor.mjs --cdp-port {{cdp_port}} --gateway-port {{port}} --slot-id {{slot_id}} --project-root {{repo}} --json",
    "recipe_run": "bash {{repo}}/projects/farmslot-farm/setup/validate-recipe.sh --recipe {{recipe_path}} --artifacts-dir {{artifacts_dir}} --runtime-dir {{runtime_dir}} --platform {{platform}} --cdp-port {{cdp_port}} --gateway-port {{port}} --metro-port {{metro_port}} --simulator {{simulator}} --adb-serial {{adb_serial}} --slot-id {{slot_id}} --run-id={{run_id}} --recipe-run-id={{recipe_run_id}}"
  },
  "prepare": {
    "core": {
      "label": "Core prepare — state work only",
      "description": "Sync checkout state, fixtures, and dependencies without starting Gateway/UI, Chrome/CDP, Metro, Companion, simulators, or devices.",
      "phases": ["git", "fixtures", "deps"]
    },
    "compatibility_profile": "sandbox",
    "default": "sandbox",
    "profiles": {
      "sandbox": {
        "label": "Worktree sandbox — sync + start gateway (tsx watch)",
        "description": "Git sync, deps, then boot this checkout's gateway and Vite UI on the slot port. Use for ff-* worktree sandboxes. Typecheck is not run here — use profile typecheck when you need it before dispatch.",
        "phases": ["git", "fixtures", "deps", "preflight", "health"],
        "hooks": {
          "preflight": "FARMSLOT_SLOT_REPO={{repo}} bash {{repo}}/projects/farmslot-farm/setup/sandbox-dev.sh start --gateway-port {{port}}"
        }
      },
      "attach": {
        "label": "Reuse running gateway",
        "description": "Health-check only when gateway is already up (main operator / farmdev).",
        "phases": ["health"],
        "requires": ["dev_server_up", "health_ok"],
        "fallback": "sandbox"
      },
      "typecheck": {
        "label": "Sync + typecheck (no gateway lifecycle)",
        "description": "Git sync and typecheck without starting or restarting the gateway process.",
        "phases": ["git", "fixtures", "deps", "preflight", "health"],
        "hooks": {
          "preflight": "cd apps/command-center && yarn typecheck",
          "health_check": "cd apps/command-center && yarn typecheck && echo ok"
        }
      },
      "companion-warm": {
        "label": "Companion warm — Metro + dev client",
        "description": "Boot isolated simulator when configured, start Metro on the slot-configured port, and verify the slot-configured gateway URL. No native rebuild.",
        "phases": ["git", "fixtures", "deps", "preflight", "health"],
        "hooks": {
          "preflight": "FARMSLOT_SLOT_REPO={{repo}} bash {{node_support_dir}}/projects/farmslot-farm/setup/companion-prepare.sh warm --gateway-port {{port}} --metro-port {{metro_port}} --platform {{platform}} --simulator {{simulator}} --adb-serial {{adb_serial}}",
          "health_check": "FARMSLOT_SLOT_REPO={{repo}} bash {{node_support_dir}}/projects/farmslot-farm/setup/companion-prepare.sh health --gateway-port {{port}} --metro-port {{metro_port}} --platform {{platform}}",
          "dev_server_check": "FARMSLOT_SLOT_REPO={{repo}} bash {{node_support_dir}}/projects/farmslot-farm/setup/companion-prepare.sh health --gateway-port {{port}} --metro-port {{metro_port}} --platform {{platform}}"
        },
        "fallback": "companion-full"
      },
      "companion-full": {
        "label": "Companion full — native build + Metro",
        "description": "Native rebuild via expo run when simulator or adb is configured, then warm Metro health.",
        "phases": ["git", "fixtures", "deps", "preflight", "health"],
        "hooks": {
          "preflight": "FARMSLOT_SLOT_REPO={{repo}} bash {{node_support_dir}}/projects/farmslot-farm/setup/companion-prepare.sh full --gateway-port {{port}} --metro-port {{metro_port}} --platform {{platform}} --simulator {{simulator}} --adb-serial {{adb_serial}}",
          "health_check": "FARMSLOT_SLOT_REPO={{repo}} bash {{node_support_dir}}/projects/farmslot-farm/setup/companion-prepare.sh health --gateway-port {{port}} --metro-port {{metro_port}} --platform {{platform}} && cd apps/companion && yarn typecheck"
        }
      },
      "sandbox-companion": {
        "label": "Gateway sandbox + companion warm",
        "description": "Start this checkout's gateway and Companion Metro on their slot-configured ports for cross-surface tasks.",
        "phases": ["git", "fixtures", "deps", "preflight", "health"],
        "hooks": {
          "preflight": "FARMSLOT_SLOT_REPO={{repo}} bash {{node_support_dir}}/projects/farmslot-farm/setup/sandbox-companion.sh --gateway-port {{port}} --metro-port {{metro_port}} --simulator {{simulator}} --adb-serial {{adb_serial}}",
          "health_check": "FARMSLOT_SLOT_REPO={{repo}} bash {{node_support_dir}}/projects/farmslot-farm/setup/sandbox-dev.sh health --gateway-port {{port}}"
        }
      }
    }
  },
  "recipe_run_supports_playback_slow": true,
  "recipe_run_supports_video_recording": true,
  "health": {
    "dev_server_name": "Gateway",
    "dev_server_log": ".sandbox/farmslot-farm/agent/sandbox-dev.log"
  },
  "fixtures": {
    "templates": [
      {
        "src": "runtime/recipe-quality.md",
        "dst": "{{runtime_dir}}/recipe-quality.md"
      },
      {
        "src": "runtime/review-quality.md",
        "dst": "{{runtime_dir}}/review-quality.md"
      },
      {
        "dst": ".sandbox/farmslot-farm/claude/CLAUDE.local.md",
        "compose": {
          "var": "FLOW_TYPE",
          "variants": {
            "": {
              "file": "CLAUDE.local.base.md"
            },
            "fix-bug": {
              "includes": [
                "CLAUDE.local.agent.fix-bug.md",
                "CLAUDE.local.agent.companion-mobile.md",
                "CLAUDE.local.base.md"
              ]
            },
            "dev": {
              "includes": ["CLAUDE.local.agent.companion-mobile.md", "CLAUDE.local.base.md"]
            },
            "new-feature": {
              "includes": ["CLAUDE.local.agent.feature.md", "CLAUDE.local.base.md"]
            },
            "review-pr": {
              "includes": ["CLAUDE.local.agent.review-pr.md", "CLAUDE.local.base.md"]
            },
            "companion-mobile": {
              "includes": ["CLAUDE.local.agent.companion-mobile.md", "CLAUDE.local.base.md"]
            }
          }
        }
      }
    ]
  },
  "external": {
    "mock_mode": true,
    "fixtures_dir": "test-data"
  },
  "self_review": {
    "enabled": false,
    "max_retries": 3,
    "review_timeout_min": 75
  },
  "ci": {
    "enabled": true,
    "repo": "deeeed/farmslot"
  },
  "publication_review": {
    "fix-bug": {
      "minimum_independent_reviews": 1
    },
    "dev": {
      "minimum_independent_reviews": 0
    }
  },
  "platforms": {
    "cli": {
      "device_check": "true"
    },
    "ios": {
      "device_check": "xcrun simctl list devices booted 2>/dev/null | grep -q '{{simulator}}'",
      "recycle": "xcrun simctl shutdown '{{simulator}}'"
    },
    "android": {
      "device_check": "adb -s {{adb_serial}} get-state 2>/dev/null | grep -q device",
      "recycle": "adb -s {{adb_serial}} shell pm clear net.siteed.farmslot.companion.development"
    }
  },
  "slot_actions": {
    "gateway-ui-retain": {
      "label": "Return Gateway/UI to slot lifecycle",
      "description": "Releases capability ownership; the existing slot lifecycle remains responsible for the control-plane process.",
      "command": "true",
      "refresh": ["resources"]
    },
    "browser-cdp-start": {
      "label": "Start Browser / CDP",
      "command": "FARMSLOT_SLOT_REPO={{repo}} bash {{repo}}/projects/farmslot-farm/setup/runtime-capability-browser.sh start --cdp-port {{cdp_port}} --ui-url http://localhost:{{vite_port}}/",
      "timeoutMs": 30000,
      "refresh": ["resources"]
    },
    "browser-cdp-health": {
      "label": "Check Browser / CDP",
      "command": "FARMSLOT_SLOT_REPO={{repo}} bash {{repo}}/projects/farmslot-farm/setup/runtime-capability-browser.sh health --cdp-port {{cdp_port}}",
      "refresh": ["resources"]
    },
    "browser-cdp-stop": {
      "label": "Stop Browser / CDP",
      "command": "FARMSLOT_SLOT_REPO={{repo}} bash {{repo}}/projects/farmslot-farm/setup/runtime-capability-browser.sh stop --cdp-port {{cdp_port}}",
      "timeoutMs": 30000,
      "refresh": ["resources"]
    },
    "companion-metro-start": {
      "label": "Start Companion / Metro",
      "command": "FARMSLOT_SLOT_REPO={{repo}} bash {{repo}}/projects/farmslot-farm/setup/companion-prepare.sh warm --gateway-port {{port}} --metro-port {{metro_port}} --platform cli",
      "timeoutMs": 180000,
      "refresh": ["resources"]
    },
    "companion-metro-health": {
      "label": "Check Companion / Metro",
      "command": "FARMSLOT_SLOT_REPO={{repo}} bash {{repo}}/projects/farmslot-farm/setup/companion-prepare.sh health --gateway-port {{port}} --metro-port {{metro_port}} --platform cli",
      "refresh": ["resources"]
    },
    "companion-metro-stop": {
      "label": "Stop Companion / Metro",
      "command": "FARMSLOT_SLOT_REPO={{repo}} bash {{repo}}/projects/farmslot-farm/setup/companion-prepare.sh stop --gateway-port {{port}} --metro-port {{metro_port}} --platform cli",
      "timeoutMs": 30000,
      "refresh": ["resources"]
    },
    "recording-ready": {
      "label": "Check recording helper",
      "command": "command -v capture-helper >/dev/null",
      "refresh": ["resources"]
    },
    "recording-release": {
      "label": "Release recording reservation",
      "command": "true",
      "refresh": ["resources"]
    },
    "native-client-install-ios": {
      "label": "Install Companion dev client",
      "command": "FARMSLOT_SLOT_REPO={{repo}} bash {{repo}}/projects/farmslot-farm/setup/companion-prepare.sh full --gateway-port {{port}} --metro-port {{metro_port}} --platform ios --simulator {{simulator}}",
      "timeoutMs": 1200000,
      "refresh": ["resources"]
    },
    "native-client-health-ios": {
      "label": "Check Companion dev client",
      "command": "xcrun simctl get_app_container '{{simulator}}' net.siteed.farmslot.development app >/dev/null",
      "refresh": ["resources"]
    },
    "native-client-retain-ios": {
      "label": "Retain installed Companion dev client",
      "description": "Releases the installation lease without uninstalling the reusable dev client.",
      "command": "true",
      "refresh": ["resources"]
    }
  },
  "resources": {
    "dev-server": {
      "type": "dev-server",
      "label": "Gateway",
      "streamable": false,
      "controllable": true,
      "watch": {
        "type": "port-listen",
        "port": "{{port}}"
      },
      "hooks": {
        "boot": "FARMSLOT_SLOT_REPO={{repo}} bash {{repo}}/projects/farmslot-farm/setup/sandbox-dev.sh start --gateway-port {{port}}",
        "health": "FARMSLOT_SLOT_REPO={{repo}} bash {{repo}}/projects/farmslot-farm/setup/sandbox-dev.sh health --gateway-port {{port}}",
        "shutdown": "FARMSLOT_SLOT_REPO={{repo}} bash {{repo}}/projects/farmslot-farm/setup/sandbox-dev.sh stop --gateway-port {{port}}"
      }
    },
    "browser-cdp": {
      "type": "browser",
      "label": "Browser / CDP",
      "streamable": true,
      "controllable": true,
      "watch": {
        "type": "port-listen",
        "port": "{{cdp_port}}"
      },
      "hooks": {
        "boot": "FARMSLOT_SLOT_REPO={{repo}} bash {{repo}}/projects/farmslot-farm/setup/runtime-capability-browser.sh start --cdp-port {{cdp_port}} --ui-url http://localhost:{{vite_port}}/",
        "health": "FARMSLOT_SLOT_REPO={{repo}} bash {{repo}}/projects/farmslot-farm/setup/runtime-capability-browser.sh health --cdp-port {{cdp_port}}",
        "shutdown": "FARMSLOT_SLOT_REPO={{repo}} bash {{repo}}/projects/farmslot-farm/setup/runtime-capability-browser.sh stop --cdp-port {{cdp_port}}"
      }
    },
    "companion-metro": {
      "type": "dev-server",
      "label": "Companion / Metro",
      "streamable": false,
      "controllable": true,
      "watch": {
        "type": "port-listen",
        "port": "{{metro_port}}"
      },
      "hooks": {
        "boot": "FARMSLOT_SLOT_REPO={{repo}} bash {{repo}}/projects/farmslot-farm/setup/companion-prepare.sh warm --gateway-port {{port}} --metro-port {{metro_port}} --platform cli",
        "health": "FARMSLOT_SLOT_REPO={{repo}} bash {{repo}}/projects/farmslot-farm/setup/companion-prepare.sh health --gateway-port {{port}} --metro-port {{metro_port}} --platform cli",
        "shutdown": "FARMSLOT_SLOT_REPO={{repo}} bash {{repo}}/projects/farmslot-farm/setup/companion-prepare.sh stop --gateway-port {{port}} --metro-port {{metro_port}} --platform cli"
      }
    },
    "ios-sim": {
      "type": "device",
      "platform": "ios",
      "label": "iOS Sim",
      "streamable": true,
      "controllable": true,
      "watch": {
        "type": "process-poll",
        "provider": "ios-simulator-inventory",
        "target": "{{simulator}}",
        "cmd": "xcrun simctl list devices booted 2>/dev/null | grep -q '{{simulator}}'"
      },
      "hooks": {
        "health": "xcrun simctl list devices booted 2>/dev/null | grep -q '{{simulator}}'",
        "boot": "xcrun simctl boot '{{simulator}}'",
        "shutdown": "xcrun simctl shutdown '{{simulator}}'"
      }
    },
    "android-device": {
      "type": "device",
      "platform": "android",
      "label": "Android Device",
      "streamable": true,
      "controllable": true,
      "watch": {
        "type": "process-poll",
        "cmd": "adb -s {{adb_serial}} get-state 2>/dev/null | grep -q device"
      },
      "hooks": {
        "health": "adb -s {{adb_serial}} get-state 2>/dev/null | grep -q device",
        "shutdown": "true"
      }
    }
  },
  "runtime_capabilities": {
    "providers": {
      "sandbox-gateway-ui": {
        "label": "Sandbox Gateway / UI",
        "description": "Starts and checks the slot's project-owned Gateway and Vite UI bundle.",
        "version": "1",
        "share_policy": "shared",
        "cost": {
          "class": "medium",
          "resources": [
            { "id": "gateway-port", "access": "shared", "kind": "port" },
            { "id": "vite-port", "access": "shared", "kind": "port" }
          ]
        },
        "actions": {
          "acquire": { "kind": "resource", "resource_id": "dev-server", "action": "boot" },
          "health": { "kind": "resource", "resource_id": "dev-server", "action": "health" },
          "release": { "kind": "slot-action", "action_id": "gateway-ui-retain" }
        },
        "affected_resources": [
          { "resource_id": "dev-server", "ownership": "slot-lifecycle", "release_effect": "retain" }
        ],
        "release_effects": [
          "Gateway/UI capability ownership is removed",
          "The slot lifecycle retains the control-plane process until slot teardown"
        ],
        "retention": { "operator-wait": "retain", "terminal": "stop" }
      },
      "browser-cdp": {
        "label": "Browser / CDP",
        "description": "Owns the dedicated Chrome profile and CDP port used for visual proof.",
        "version": "1",
        "share_policy": "exclusive",
        "cost": {
          "class": "high",
          "resources": [
            { "id": "cdp-port", "access": "exclusive", "kind": "port" },
            { "id": "chrome", "access": "exclusive", "kind": "process" }
          ]
        },
        "actions": {
          "acquire": { "kind": "slot-action", "action_id": "browser-cdp-start" },
          "health": { "kind": "slot-action", "action_id": "browser-cdp-health" },
          "release": { "kind": "slot-action", "action_id": "browser-cdp-stop" }
        },
        "affected_resources": [
          { "resource_id": "browser-cdp", "ownership": "capability", "release_effect": "stop" }
        ],
        "release_effects": [
          "The lease owner can no longer drive the CDP session",
          "Chrome remains reusable only until the explicit keep-warm deadline"
        ],
        "keep_warm_ms": 600000,
        "retention": { "operator-wait": "warm", "terminal": "stop" }
      },
      "companion-metro": {
        "label": "Companion / Metro",
        "description": "Starts the slot-scoped Expo Metro session without booting a device.",
        "version": "1",
        "share_policy": "shared",
        "cost": {
          "class": "high",
          "resources": [
            { "id": "metro-port", "access": "shared", "kind": "port" },
            { "id": "metro", "access": "shared", "kind": "process" }
          ]
        },
        "actions": {
          "acquire": { "kind": "slot-action", "action_id": "companion-metro-start" },
          "health": { "kind": "slot-action", "action_id": "companion-metro-health" },
          "release": { "kind": "slot-action", "action_id": "companion-metro-stop" }
        },
        "affected_resources": [
          { "resource_id": "companion-metro", "ownership": "capability", "release_effect": "stop" }
        ],
        "release_effects": ["The final shared lease stops the slot-scoped Metro tmux session"],
        "retention": { "operator-wait": "stop", "terminal": "stop" }
      },
      "ios-simulator": {
        "label": "iOS Simulator",
        "description": "Boots the simulator declared by this slot after Metro is leased.",
        "version": "1",
        "dependencies": ["companion-metro"],
        "share_policy": "exclusive",
        "cost": {
          "class": "high",
          "resources": [{ "id": "ios-simulator", "access": "exclusive", "kind": "device" }]
        },
        "parameters": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "platform": { "const": "ios" },
            "udid": { "type": "string", "pattern": "^[A-Za-z0-9._:][A-Za-z0-9._:-]*$" },
            "simulator": { "type": "string", "pattern": "^[A-Za-z0-9._:][A-Za-z0-9._:-]*$" }
          }
        },
        "actions": {
          "acquire": { "kind": "resource", "resource_id": "ios-sim", "action": "boot" },
          "health": { "kind": "resource", "resource_id": "ios-sim", "action": "health" },
          "release": { "kind": "resource", "resource_id": "ios-sim", "action": "shutdown" }
        },
        "affected_resources": [
          { "resource_id": "ios-sim", "ownership": "capability", "release_effect": "stop" }
        ],
        "release_effects": [
          "The simulator is shut down",
          "Its Metro dependency is released only when no other lease needs it"
        ]
      },
      "android-device": {
        "label": "Android Device",
        "description": "Reserves and checks the adb device declared by this slot after Metro is leased.",
        "version": "1",
        "dependencies": ["companion-metro"],
        "share_policy": "exclusive",
        "cost": {
          "class": "high",
          "resources": [{ "id": "android-device", "access": "exclusive", "kind": "device" }]
        },
        "parameters": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "platform": { "const": "android" },
            "avd": { "type": "string", "pattern": "^[A-Za-z0-9._:][A-Za-z0-9._:-]*$" },
            "adb_serial": { "type": "string", "pattern": "^[A-Za-z0-9._:][A-Za-z0-9._:-]*$" }
          }
        },
        "actions": {
          "acquire": { "kind": "resource", "resource_id": "android-device", "action": "health" },
          "health": { "kind": "resource", "resource_id": "android-device", "action": "health" },
          "release": { "kind": "resource", "resource_id": "android-device", "action": "shutdown" }
        },
        "affected_resources": [
          {
            "resource_id": "android-device",
            "ownership": "capability",
            "release_effect": "retain"
          }
        ],
        "release_effects": [
          "The adb reservation is released without clearing another slot's app data",
          "Its Metro dependency is reference-counted independently"
        ]
      },
      "companion-native-client-ios": {
        "label": "Companion native dev client (iOS)",
        "description": "Installs the development client only after the simulator and Metro dependencies are leased.",
        "version": "1",
        "dependencies": ["ios-simulator"],
        "share_policy": "exclusive",
        "cost": {
          "class": "high",
          "resources": [
            { "id": "ios-native-build", "access": "exclusive", "kind": "process" },
            { "id": "companion-install", "access": "exclusive", "kind": "device" }
          ]
        },
        "parameters": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "platform": { "const": "ios" },
            "udid": { "type": "string", "pattern": "^[A-Za-z0-9._:][A-Za-z0-9._:-]*$" },
            "simulator": { "type": "string", "pattern": "^[A-Za-z0-9._:][A-Za-z0-9._:-]*$" }
          }
        },
        "actions": {
          "acquire": { "kind": "slot-action", "action_id": "native-client-install-ios" },
          "health": { "kind": "slot-action", "action_id": "native-client-health-ios" },
          "release": { "kind": "slot-action", "action_id": "native-client-retain-ios" }
        },
        "affected_resources": [],
        "release_effects": [
          "The native-build lease is released",
          "The installed dev client remains reusable; simulator and Metro dependencies release normally"
        ]
      },
      "recording": {
        "label": "Screen recording",
        "description": "Reserves the project recording helper for publication evidence.",
        "version": "1",
        "share_policy": "exclusive",
        "parameters": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
