{
  "$schema": "../../schemas/project.schema.json",
  "name": "farmslot",
  "type": "monorepo",
  "default_branch": "main",
  "default_safety_tier": "dangerous",
  "primary_repo": "/Users/deeeed/dev/farmslot",
  "worktree_base": "/Users/deeeed/dev/farmslot-wt",
  "apps": ["command-center", "companion"],
  "paths": {
    "runtime_dir": ".sandbox/farmslot/agent",
    "artifact_dir": ".sandbox/farmslot/task"
  },
  "defaults": {
    "fix": {
      "runner": "claude",
      "model": "sonnet"
    },
    "feature": {
      "runner": "claude",
      "model": "sonnet"
    },
    "review": {
      "runner": "claude",
      "model": "opus"
    }
  },
  "hooks": {
    "post_merge_install": "yarn install",
    "preflight": "cd apps/command-center && yarn typecheck",
    "health_check": "bash {{repo}}/projects/farmslot/setup/sandbox-dev.sh health --gateway-port {{port}}",
    "dev_server_check": "bash {{repo}}/projects/farmslot/setup/sandbox-dev.sh health --gateway-port {{port}}",
    "teardown": "bash {{repo}}/projects/farmslot/setup/sandbox-dev.sh stop --gateway-port {{port}}",
    "setup": "cd apps/companion && yarn install",
    "recipe_run": "bash apps/companion/scripts/agentic/validate-recipe.sh --recipe {{recipe_path}} --artifacts-dir {{artifacts_dir}} --runtime-dir {{runtime_dir}} --platform {{platform}} --metro-port {{port}} --simulator {{simulator}} --adb-serial {{adb_serial}}"
  },
  "prepare": {
    "default": "sandbox",
    "profiles": {
      "sandbox": {
        "label": "Worktree sandbox — sync + start gateway (tsx watch)",
        "description": "Git sync, deps, then boot this checkout's gateway and Vite UI on the slot port. Use for ff-* worktree sandboxes. Typecheck is not run here — use profile typecheck when you need it before dispatch.",
        "phases": ["git", "fixtures", "deps", "preflight", "health"],
        "hooks": {
          "preflight": "bash {{repo}}/projects/farmslot/setup/sandbox-dev.sh start --gateway-port {{port}}"
        }
      },
      "attach": {
        "label": "Reuse running gateway",
        "description": "Health-check only when gateway is already up (main operator / farmdev).",
        "phases": ["health"],
        "requires": ["dev_server_up", "health_ok"],
        "fallback": "sandbox"
      },
      "typecheck": {
        "label": "Sync + typecheck (no gateway lifecycle)",
        "description": "Git sync and typecheck without starting or restarting the gateway process.",
        "phases": ["git", "fixtures", "deps", "preflight", "health"],
        "hooks": {
          "preflight": "cd apps/command-center && yarn typecheck",
          "health_check": "cd apps/command-center && yarn typecheck && echo ok"
        }
      },
      "companion-warm": {
        "label": "Companion warm — Metro + dev client",
        "description": "Boot isolated simulator when configured, start Metro on the slot port, and verify gateway pairing URL. No native rebuild.",
        "phases": ["git", "fixtures", "deps", "preflight", "health"],
        "hooks": {
          "preflight": "cd apps/companion && METRO_PORT={{port}} IOS_SIMULATOR={{simulator}} ADB_SERIAL={{adb_serial}} bash scripts/agentic/prepare-profile.sh warm",
          "health_check": "lsof -nP -iTCP:{{port}} -sTCP:LISTEN -t >/dev/null 2>&1",
          "dev_server_check": "lsof -nP -iTCP:{{port}} -sTCP:LISTEN -t >/dev/null 2>&1"
        },
        "requires": ["dev_server_up"],
        "fallback": "companion-full"
      },
      "companion-full": {
        "label": "Companion full — native build + Metro",
        "description": "Native rebuild via expo run when simulator or adb is configured, then warm Metro health.",
        "phases": ["git", "fixtures", "deps", "preflight", "health"],
        "hooks": {
          "preflight": "cd apps/companion && METRO_PORT={{port}} IOS_SIMULATOR={{simulator}} ADB_SERIAL={{adb_serial}} bash scripts/agentic/prepare-profile.sh full",
          "health_check": "lsof -nP -iTCP:{{port}} -sTCP:LISTEN -t >/dev/null 2>&1 && cd apps/companion && yarn typecheck"
        }
      },
      "stack-dogfood": {
        "label": "Gateway sandbox + companion warm",
        "description": "Start this checkout's gateway on the slot port, then boot companion Metro (derived port) for cross-surface dogfood.",
        "phases": ["git", "fixtures", "deps", "preflight", "health"],
        "hooks": {
          "preflight": "bash {{repo}}/projects/farmslot/setup/stack-dogfood.sh --gateway-port {{port}} --simulator {{simulator}} --adb-serial {{adb_serial}}",
          "health_check": "bash {{repo}}/projects/farmslot/setup/sandbox-dev.sh health --gateway-port {{port}}"
        }
      }
    }
  },
  "recipe_run_supports_playback_slow": false,
  "health": {
    "dev_server_name": "Gateway",
    "dev_server_log": ".sandbox/farmslot/agent/sandbox-dev.log"
  },
  "fixtures": {
    "templates": [
      {
        "dst": ".sandbox/farmslot/claude/CLAUDE.local.md",
        "compose": {
          "var": "FLOW_TYPE",
          "variants": {
            "": {
              "file": "CLAUDE.local.base.md"
            },
            "fix-bug": {
              "includes": ["CLAUDE.local.agent.fix-bug.md", "CLAUDE.local.agent.companion-mobile.md", "CLAUDE.local.base.md"]
            },
            "dev": {
              "includes": ["CLAUDE.local.agent.companion-mobile.md", "CLAUDE.local.base.md"]
            },
            "new-feature": {
              "includes": ["CLAUDE.local.agent.feature.md", "CLAUDE.local.base.md"]
            },
            "review-pr": {
              "includes": ["CLAUDE.local.agent.review-pr.md", "CLAUDE.local.base.md"]
            },
            "companion-mobile": {
              "includes": ["CLAUDE.local.agent.companion-mobile.md", "CLAUDE.local.base.md"]
            }
          }
        }
      }
    ]
  },
  "external": {
    "mock_mode": true,
    "fixtures_dir": "test-data"
  },
  "self_review": {
    "enabled": false
  },
  "publication_review": {
    "fix-bug": {
      "minimum_independent_reviews": 1
    },
    "dev": {
      "minimum_independent_reviews": 0
    }
  },
  "platforms": {
    "cli": {
      "device_check": "true"
    },
    "ios": {
      "device_check": "xcrun simctl list devices booted 2>/dev/null | grep -q '{{simulator}}'",
      "recycle": "xcrun simctl shutdown '{{simulator}}'"
    },
    "android": {
      "device_check": "adb -s {{adb_serial}} get-state 2>/dev/null | grep -q device",
      "recycle": "adb -s {{adb_serial}} shell pm clear net.siteed.farmslot.companion.development"
    }
  },
  "resources": {
    "dev-server": {
      "type": "dev-server",
      "label": "Gateway",
      "streamable": false,
      "controllable": true,
      "watch": {
        "type": "port-listen",
        "port": "{{port}}"
      },
      "hooks": {
        "health": "bash {{repo}}/projects/farmslot/setup/sandbox-dev.sh health --gateway-port {{port}}",
        "shutdown": "bash {{repo}}/projects/farmslot/setup/sandbox-dev.sh stop --gateway-port {{port}}"
      }
    },
    "ios-sim": {
      "type": "device",
      "platform": "ios",
      "label": "iOS Sim",
      "streamable": true,
      "controllable": true,
      "watch": {
        "type": "process-poll",
        "cmd": "xcrun simctl list devices booted 2>/dev/null | grep -q '{{simulator}}'"
      },
      "hooks": {
        "health": "xcrun simctl list devices booted 2>/dev/null | grep -q '{{simulator}}'",
        "boot": "xcrun simctl boot '{{simulator}}'",
        "shutdown": "xcrun simctl shutdown '{{simulator}}'"
      }
    },
    "android-device": {
      "type": "device",
      "platform": "android",
      "label": "Android Device",
      "streamable": true,
      "controllable": true,
      "watch": {
        "type": "process-poll",
        "cmd": "adb -s {{adb_serial}} get-state 2>/dev/null | grep -q device"
      },
      "hooks": {
        "health": "adb -s {{adb_serial}} get-state 2>/dev/null | grep -q device",
        "shutdown": "true"
      }
    }
  },
  "task_dir": ".sandbox/farmslot/worker-task"
}