# Central sandbox root for fake/demo runner isolation
.sandbox/
.observability

# Git worktrees checked out inside the repo (never repo source)
.worktrees/
.claude/
.omx/
**/.omx/
**/.omc/

# Docs and slides generated output
apps/docs/.docusaurus
apps/docs/.docusaurus/
apps/docs/build/

# Private promotion/presentation material lives outside this publicable repo.
presentation/

# Local release-cut proposals (reviewed before --execute)
.release-cut/

# Package build output
packages/*/dist/
services/*/dist/
pool/*.bak.*

# Installed-workspace artifacts (only appear if FARMSLOT_WORKSPACE points at a checkout)
