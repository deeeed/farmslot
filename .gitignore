# Project configs are nested git repos — ignored by parent, detected by VS Code
projects/*/
!projects/README.md

# Pool configs contain machine hostnames, SSH users, paths — keep private
pool/*.json
!pool/example.json
!pool/farmslot-demo.json

# Generated runtime artifacts and overlays; never commit transient Farmslot state.
.artifact-cache/
temp/
.agent/
# Codex runner provisioning (config.toml + hooks.json) written into the repo
# root at dispatch by scripts/install-runner-observability.mjs — never commit.
.codex/

# Co-pilot session history (raw JSON, transient)
copilot/sessions/
copilot/memory/
copilot/notified-decisions.json

# Runtime state
.farm-status.json
.monitor_state.json
.dispatch-queue.json
.farm-cache/
.roadmap/
.backlog.json
.backlog/
.work-graphs/

# Run archives (per-run folders with artifacts, tasks, run records)
projects/*/runs/

# Root workspace artifacts (yarn 4 monorepo)
# No trailing slash — must ignore symlinks named node_modules (worktree shortcut mistake).
/node_modules
**/node_modules
/.yarn

**.DS_Store
.claude/scheduled_tasks.lock

# Python cache
__pycache__/

# Local reference clones for LLM scoring (shallow clones of repo_url)
projects/*/.src/

# Scoring results (contain ticket titles/descriptions from private trackers)
projects/*/scores/

# Secrets
.env.sonar.local
.env
.env.ports
.env.local-auth
**/.chrome-farmslot/
.runs/
.task/
.backups/

# Session work tracker (local only)
WORK.md

