# Gateway environment variables
# Copy to .env and fill in values

# Jira — optional, only for project integrations that use Jira.
# project.json can map projects to their own token env var names.
JIRA_EMAIL=
JIRA_API_TOKEN=

# Anthropic — only needed if using direct API (not CLI pipe)
# ANTHROPIC_API_KEY=

# SonarQube / SonarCloud — optional local quality integration.
# Prefer copying .env.sonar.example to .env.sonar.local for private values.
SONAR_HOST_URL=https://sonarcloud.io
SONAR_PROJECT_KEY=
# Optional SonarCloud organization slug.
SONAR_ORGANIZATION=farmslot
SONAR_TOKEN=
