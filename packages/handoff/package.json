{
  "name": "@farmslot/handoff",
  "version": "0.1.0",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "handoff": "dist/bin/handoff.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./spec": {
      "types": "./dist/spec/index.d.ts",
      "import": "./dist/spec/index.js",
      "default": "./dist/spec/index.js"
    },
    "./validate": {
      "types": "./dist/validate/index.d.ts",
      "import": "./dist/validate/index.js",
      "default": "./dist/validate/index.js"
    },
    "./scrub": {
      "types": "./dist/scrub/index.d.ts",
      "import": "./dist/scrub/index.js",
      "default": "./dist/scrub/index.js"
    },
    "./learning-package": {
      "types": "./dist/learning-package/index.d.ts",
      "import": "./dist/learning-package/index.js",
      "default": "./dist/learning-package/index.js"
    },
    "./resolve": {
      "types": "./dist/resolve/index.d.ts",
      "import": "./dist/resolve/index.js",
      "default": "./dist/resolve/index.js"
    },
    "./task-io": {
      "types": "./dist/task-io/index.d.ts",
      "import": "./dist/task-io/index.js",
      "default": "./dist/task-io/index.js"
    },
    "./pr-publish": {
      "types": "./dist/pr-publish/index.d.ts",
      "import": "./dist/pr-publish/index.js",
      "default": "./dist/pr-publish/index.js"
    },
    "./schemas/*": "./schemas/*"
  },
  "scripts": {
    "typecheck": "tsc --noEmit --project tsconfig.json",
    "test": "node ../../scripts/quality/run-tsx-tests.mjs --cwd . --tsconfig tsconfig.json test",
    "format": "prettier --write --ignore-path ../../.prettierignore .",
    "format:check": "prettier --check --ignore-path ../../.prettierignore .",
    "lint": "eslint \"src/**/*.ts\" \"test/**/*.ts\"",
    "lint:fix": "eslint \"src/**/*.ts\" \"test/**/*.ts\" --fix",
    "quality": "prettier --check --ignore-path ../../.prettierignore . && eslint \"src/**/*.ts\" \"test/**/*.ts\" && tsc --noEmit --project tsconfig.json && yarn build && yarn test",
    "build": "rm -rf dist && tsc --project tsconfig.build.json",
    "prepack": "cd ../.. && node scripts/quality/check-farmslot-package-readiness.mjs --require-changelog --packages @farmslot/handoff && yarn workspace @farmslot/handoff build",
    "prepublishOnly": "node ../../scripts/quality/check-farmslot-package-readiness.mjs --publish --packages @farmslot/handoff"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "eslint": "^10.3.0",
    "prettier": "^3.8.3",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deeeed/farmslot.git",
    "directory": "packages/handoff"
  },
  "bugs": {
    "url": "https://github.com/deeeed/farmslot/issues"
  },
  "license": "MIT",
  "homepage": "https://farmslot.io/docs/guides/learning-package",
  "keywords": [
    "farmslot",
    "handoff",
    "learning-package",
    "scrub",
    "validation",
    "agentic-engineering"
  ],
  "files": [
    "README.md",
    "LICENSE",
    "CHANGELOG.md",
    "schemas/**/*.json",
    "templates/**/*.md",
    "dist/**/*.js",
    "dist/**/*.d.ts",
    "dist/**/*.d.ts.map",
    "dist/**/*.js.map"
  ],
  "publishConfig": {
    "access": "public"
  }
}
