{
  "name": "@farmslot/adapter-web",
  "version": "0.6.9",
  "description": "Web platform adapter for Farmslot recipes: resolve and launch an isolated Chromium, own its CDP port, load unpacked extensions, and keep macOS focus.",
  "type": "commonjs",
  "exports": {
    "./browser-cdp": {
      "types": "./dist/browser-cdp.d.cts",
      "default": "./src/browser-cdp.cjs"
    },
    "./browser-resolver": {
      "types": "./dist/browser-resolver.d.cts",
      "default": "./src/browser-resolver.cjs"
    },
    "./chrome-args": {
      "types": "./dist/chrome-args.d.cts",
      "default": "./src/chrome-args.cjs"
    },
    "./dapp": {
      "types": "./dist/dapp/index.d.cts",
      "default": "./src/dapp/index.cjs"
    },
    "./extension-id": {
      "types": "./dist/extension-id.d.cts",
      "default": "./src/extension-id.cjs"
    },
    "./launch-browser": {
      "types": "./dist/launch-browser.d.cts",
      "default": "./src/launch-browser.cjs"
    },
    "./macos-focus": {
      "types": "./dist/macos-focus.d.cts",
      "default": "./src/macos-focus.cjs"
    },
    "./network-observer": {
      "types": "./dist/network-observer.d.cts",
      "default": "./src/network-observer.cjs"
    },
    "./origin": {
      "types": "./dist/origin.d.cts",
      "default": "./src/origin.cjs"
    },
    "./package.json": "./package.json",
    "./page-target": {
      "types": "./dist/page-target.d.cts",
      "default": "./src/page-target.cjs"
    },
    "./performance-observer": {
      "types": "./dist/performance-observer.d.cts",
      "default": "./src/performance-observer.cjs"
    },
    "./playwright-cdp": {
      "types": "./dist/playwright-cdp.d.cts",
      "default": "./src/playwright-cdp.cjs"
    },
    "./slot-title": {
      "types": "./dist/slot-title.d.cts",
      "default": "./src/slot-title.cjs"
    },
    "./validation-launch-supervisor": {
      "types": "./dist/validation-launch-supervisor.d.cts",
      "default": "./src/validation-launch-supervisor.cjs"
    },
    "./validation-process-ownership": {
      "types": "./dist/validation-process-ownership.d.cts",
      "default": "./src/validation-process-ownership.cjs"
    },
    "./web-dapp": {
      "types": "./dist/web-dapp/index.d.mts",
      "default": "./src/web-dapp/index.mjs"
    }
  },
  "scripts": {
    "typecheck": "yarn workspace @farmslot/adapter-sdk build && tsc --noEmit --project tsconfig.json && yarn build && tsc --project tsconfig.consumer.json",
    "test": "node --test \"test/*.test.cjs\" \"test/*.test.mjs\"",
    "format": "prettier --write --ignore-path ../../.prettierignore .",
    "format:check": "prettier --check --ignore-path ../../.prettierignore .",
    "lint": "eslint \"src/**/*.cjs\" \"src/**/*.mjs\" \"test/**/*.cjs\" \"test/**/*.mjs\" \"test/**/*.ts\"",
    "lint:fix": "eslint \"src/**/*.cjs\" \"src/**/*.mjs\" \"test/**/*.cjs\" \"test/**/*.mjs\" \"test/**/*.ts\" --fix",
    "quality": "prettier --check --ignore-path ../../.prettierignore . && eslint \"src/**/*.cjs\" \"src/**/*.mjs\" \"test/**/*.cjs\" \"test/**/*.mjs\" \"test/**/*.ts\" && yarn typecheck && yarn test",
    "build": "yarn workspace @farmslot/adapter-sdk build && rm -rf dist && tsc --project tsconfig.build.json",
    "prepack": "cd ../.. && node scripts/quality/check-farmslot-package-readiness.mjs --require-changelog --packages @farmslot/adapter-web && yarn workspace @farmslot/adapter-web build",
    "prepublishOnly": "node ../../scripts/quality/check-farmslot-package-readiness.mjs --publish --packages @farmslot/adapter-web"
  },
  "dependencies": {
    "@farmslot/adapter-sdk": "workspace:*",
    "@farmslot/recipe-runner": "workspace:*",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "eslint": "^10.3.0",
    "prettier": "^3.8.3",
    "typescript": "^5.6.0",
    "viem": "^2.54.3"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deeeed/farmslot.git",
    "directory": "packages/adapter-web"
  },
  "bugs": {
    "url": "https://github.com/deeeed/farmslot/issues"
  },
  "license": "MIT",
  "homepage": "https://farmslot.io/docs/reference/adapter-web",
  "keywords": [
    "farmslot",
    "recipe",
    "adapter",
    "chrome",
    "cdp",
    "agentic-engineering"
  ],
  "engines": {
    "node": ">=22.15.0"
  },
  "files": [
    "README.md",
    "LICENSE",
    "CHANGELOG.md",
    "src/**/*.cjs",
    "src/**/*.mjs",
    "dist/**/*.d.cts",
    "dist/**/*.d.mts"
  ],
  "publishConfig": {
    "access": "public"
  }
}
