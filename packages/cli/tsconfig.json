{
  "extends": "../../apps/command-center/tsconfig.base.json",
  "compilerOptions": {
    "paths": {
      "@farmslot/agent-runtime": ["../agent-runtime/src/index.ts"],
      "@farmslot/agent-runtime/*": ["../agent-runtime/src/*"],
      "@farmslot/credential-store": ["../credential-store/src/index.ts"],
      "@farmslot/recipe-harness": ["../recipe-harness/src/index.ts"],
      "@farmslot/recipe-harness/*": ["../recipe-harness/src/*"],
      "@farmslot/protocol": ["../protocol/src/index.ts"],
      "@farmslot/protocol/*": ["../protocol/src/*"],
      "@farmslot/run-bundle": ["../run-bundle/src/index.ts"],
      "@farmslot/slot-config": ["../slot-config/src/index.ts"],
      "@farmslot/slot-config/*": ["../slot-config/src/*"]
    },
    "jsx": "react-jsx"
  },
  "include": ["src/**/*.ts", "src/**/*.tsx"]
}
