{
  "name": "@farmslot/cli",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "bin": {
    "farmslot": "./bin/farmslot.mjs"
  },
  "scripts": {
    "farmslot": "tsx src/entry.ts",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint \"src/**/*.ts\"",
    "lint:fix": "eslint \"src/**/*.ts\" --fix",
    "quality": "prettier --check . && eslint \"src/**/*.ts\" && tsc --noEmit && yarn test",
    "test": "node ../../scripts/quality/run-tsx-tests.mjs --cwd . --tsconfig tsconfig.json src"
  },
  "dependencies": {
    "@clack/prompts": "^1.7.0",
    "@farmslot/protocol": "workspace:*",
    "@farmslot/recipe-harness": "workspace:*",
    "@farmslot/run-bundle": "workspace:*",
    "commander": "^12.0.0",
    "ink": "^7.1.0",
    "qrcode": "^1.5.4",
    "react": "^19.2.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^19.2.0",
    "@types/ws": "^8.5.0",
    "eslint": "^10.3.0",
    "ink-testing-library": "^4",
    "prettier": "^3.8.3",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  },
  "license": "MIT"
}
