{
  "name": "@farmslot/cli",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "bin": {
    "farmslot": "./bin/farmslot.mjs"
  },
  "scripts": {
    "farmslot": "tsx src/entry.ts",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint \"src/**/*.ts\"",
    "lint:fix": "eslint \"src/**/*.ts\" --fix",
    "quality": "prettier --check . && eslint \"src/**/*.ts\" && tsc --noEmit && yarn test",
    "test": "node ../../scripts/quality/run-tsx-tests.mjs --cwd . --tsconfig tsconfig.json src"
  },
  "dependencies": {
    "@farmslot/protocol": "workspace:*",
    "@farmslot/recipe-harness": "workspace:*",
    "commander": "^12.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "eslint": "^10.3.0",
    "prettier": "^3.8.3",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}
