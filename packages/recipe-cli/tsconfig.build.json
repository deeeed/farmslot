{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "rootDir": "src",
    "paths": {
      "@farmslot/protocol": ["../protocol/dist/index.d.ts"],
      "@farmslot/protocol/*": ["../protocol/dist/*"],
      "@farmslot/recipe-runner": ["../recipe-runner/dist/index.d.ts"],
