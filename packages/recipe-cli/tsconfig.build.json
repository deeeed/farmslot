{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "rootDir": "src",
    "paths": {
      "@farmslot/agent-runtime": ["../agent-runtime/dist/index.d.ts"],
      "@farmslot/protocol": ["../protocol/dist/index.d.ts"],
      "@farmslot/protocol/*": ["../protocol/dist/*"],
      "@farmslot/recipe-harness": ["../recipe-harness/dist/index.d.ts"],
      "@farmslot/recipe-harness/cli": ["../recipe-harness/dist/cli/index.d.ts"],
