{
  "name": "@farmslot/recipe-cli",
  "version": "0.13.0",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "farmslot-recipe": "./bin/farmslot-recipe.mjs"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./harness": {
      "types": "./dist/harness/index.d.ts",
      "import": "./dist/harness/index.js",
      "default": "./dist/harness/index.js"
    }
  },
  "scripts": {
    "typecheck": "tsc --noEmit --project tsconfig.json",
    "test": "node ../../scripts/quality/run-tsx-tests.mjs --cwd . --tsconfig tsconfig.json test",
    "format": "prettier --write --ignore-path ../../.prettierignore .",
    "format:check": "prettier --check --ignore-path ../../.prettierignore .",
    "lint": "eslint \"src/**/*.ts\" \"test/**/*.ts\"",
    "lint:fix": "eslint \"src/**/*.ts\" \"test/**/*.ts\" --fix",
    "quality": "prettier --check --ignore-path ../../.prettierignore . && eslint \"src/**/*.ts\" \"test/**/*.ts\" && tsc --noEmit --project tsconfig.json && yarn build && yarn test",
    "build": "yarn workspace @farmslot/recipe-runner build && yarn workspace @farmslot/agent-runtime build && yarn workspace @farmslot/adapter-sdk build && rm -rf dist && tsc --project tsconfig.build.json",
    "prepack": "cd ../.. && node scripts/quality/check-farmslot-package-readiness.mjs --require-changelog --packages @farmslot/recipe-cli && yarn workspace @farmslot/recipe-cli build",
    "prepublishOnly": "node ../../scripts/quality/check-farmslot-package-readiness.mjs --publish --packages @farmslot/recipe-cli"
  },
  "dependencies": {
    "@farmslot/adapter-sdk": "workspace:*",
    "@farmslot/agent-runtime": "workspace:*",
    "@farmslot/protocol": "workspace:*",
    "@farmslot/recipe-runner": "workspace:*",
    "commander": "^12.0.0",
    "es-module-lexer": "2.3.1",
    "esbuild": "0.28.1",
    "semver": "^7.7.3"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "eslint": "^10.3.0",
    "prettier": "^3.8.3",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deeeed/farmslot.git",
    "directory": "packages/recipe-cli"
  },
  "bugs": {
    "url": "https://github.com/deeeed/farmslot/issues"
  },
  "license": "MIT",
  "homepage": "https://farmslot.io/docs/reference/recipe-discovery",
  "keywords": [
    "farmslot",
    "recipe",
    "recipe-cli",
    "discovery",
    "agentic-engineering"
  ],
  "files": [
    "README.md",
    "LICENSE",
    "bin/**/*.mjs",
    "dist/**/*.js",
    "dist/**/*.d.ts",
    "dist/**/*.d.ts.map",
    "dist/**/*.js.map"
  ],
  "publishConfig": {
    "access": "public"
  }
}
