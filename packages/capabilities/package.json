{
  "name": "@farmslot/capabilities",
  "version": "0.1.0",
  "description": "Machine-local capability primitives (fs-watch, screen capture) shared by the node (primary owner) and the gateway (local fallback when no node) — ADR-046.",
  "type": "module",
  "main": "src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./fs-watch": "./src/fs-watch.ts",
    "./screen-frame": "./src/screen-frame.ts",
    "./screen-h264": "./src/screen-h264.ts"
  },
  "scripts": {
    "test": "node ../../scripts/quality/run-tsx-tests.mjs --cwd . --tsconfig tsconfig.json src",
    "typecheck": "tsc --noEmit --project tsconfig.json",
    "quality": "yarn test && yarn typecheck"
  },
  "dependencies": {
    "@farmslot/protocol": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}
