{
  "name": "@farmslot/expo-recipe",
  "version": "0.1.2",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "farmslot-expo-recipe": "./bin/farmslot-expo-recipe.mjs"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "typecheck": "tsc --noEmit --project tsconfig.json",
    "build": "yarn workspace @farmslot/protocol build && yarn workspace @farmslot/recipe-harness build && rm -rf dist && tsc --project tsconfig.build.json",
    "test": "tsx --tsconfig tsconfig.json --test src/expo-recipe.test.ts src/metro-recipe-bridge-transport.test.ts",
    "format": "prettier --write --ignore-path ../../.prettierignore .",
    "format:check": "prettier --check --ignore-path ../../.prettierignore .",
    "lint": "eslint \"src/**/*.ts\" \"templates/src/farmslot/**/*.{ts,tsx}\"",
    "quality": "prettier --check --ignore-path ../../.prettierignore . && eslint \"src/**/*.ts\" \"templates/src/farmslot/**/*.{ts,tsx}\" && tsc --noEmit --project tsconfig.json && yarn build && yarn test",
    "prepack": "yarn build",
    "prepublishOnly": "node ../../scripts/quality/check-farmslot-package-readiness.mjs --publish --packages @farmslot/expo-recipe"
  },
  "dependencies": {
    "@farmslot/protocol": "workspace:*",
    "@farmslot/recipe-harness": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "eslint": "^10.3.0",
    "prettier": "^3.8.3",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deeeed/farmslot.git",
    "directory": "packages/expo-recipe"
  },
  "bugs": {
    "url": "https://github.com/deeeed/farmslot/issues"
  },
  "license": "MIT",
  "homepage": "https://farmslot.io/docs/guides/expo-recipe",
  "keywords": [
    "farmslot",
    "expo",
    "react-native",
    "recipe",
    "validation",
    "agentic-engineering"
  ],
  "files": [
    "README.md",
    "LICENSE",
    "bin/**/*.mjs",
    "dist/**/*.js",
    "dist/**/*.d.ts",
    "dist/**/*.d.ts.map",
    "dist/**/*.js.map",
    "templates/**/*"
  ],
  "publishConfig": {
    "access": "public"
  }
}
