{
  "$schema": "https://farmslot.io/schemas/action-manifest-v1.schema.json",
  "actions": {
    "command": {
      "description": "Run a project-local command during setup, diagnostics, or headless proof. Prefer UI actions only when the recipe must prove visible interaction.",
      "schema": {
        "type": "object",
        "properties": {
          "cmd": {
            "type": "string"
          },
          "timeout_ms": {
            "type": "integer"
          },
          "cwd": {
            "type": "string"
          },
          "allow_failure": {
            "type": "boolean"
          }
        },
        "required": ["cmd"],
        "additionalProperties": false
      },
      "examples": [
        {
          "action": "command",
          "intent": "Prepare the project state needed for this proof.",
          "cmd": "true",
          "next": "done"
        }
      ]
    },
    "assert_output": {
      "description": "Assert stdout or stderr from a previous command node.",
      "schema": {
        "type": "object",
        "properties": {
          "source": {
            "type": "string"
          },
          "stream": {
            "type": "string"
          },
          "contains": {
            "type": "string"
          },
          "match": {
            "type": "string"
          },
          "assert": {
            "type": "object",
            "additionalProperties": true
          }
        },
        "required": ["source"],
        "additionalProperties": false
      },
      "examples": [
        {
          "action": "assert_output",
          "intent": "Confirm the recorded output satisfies the requested condition.",
          "source": "command",
          "contains": "ready",
          "next": "done"
        }
      ]
    },
    "wait": {
      "description": "Pause briefly for asynchronous setup work. Keep waits short and prefer deterministic assertions.",
      "schema": {
        "type": "object",
        "properties": {
          "duration_ms": {
            "type": "integer"
          }
        },
        "required": ["duration_ms"],
        "additionalProperties": false
      },
      "examples": [
        {
          "action": "wait",
          "intent": "Allow the requested asynchronous state to settle.",
          "duration_ms": 1,
          "next": "done"
        }
      ]
    },
    "ui.press": {
      "description": "Press a native accessibility target on the assigned simulator or device.",
      "schema": {
        "type": "object",
        "properties": {
          "test_id": {
            "type": "string"
          },
          "text": {
            "type": "string"
          },
          "selector": {
            "type": "string"
          }
        },
        "additionalProperties": false
      },
      "examples": [
        {
          "action": "ui.press",
          "intent": "Activate the requested visible control.",
          "test_id": "example-control",
          "next": "done"
        }
      ]
    },
    "ui.set_input": {
      "description": "Set text on a native input. Values remain part of retained recipe artifacts, so recipes must not contain secrets.",
      "schema": {
        "type": "object",
        "properties": {
          "test_id": {
            "type": "string"
          },
          "value": {
            "type": "string"
          }
        },
        "additionalProperties": false
      },
      "examples": [
        {
          "action": "ui.set_input",
          "intent": "Provide the requested value in the visible form.",
          "test_id": "example-input",
          "value": "example",
          "next": "done"
        }
      ]
    },
    "ui.scroll": {
      "description": "Scroll the assigned native simulator or device and wait for stability.",
      "schema": {
        "type": "object",
        "additionalProperties": false
      },
      "examples": [
        {
          "action": "ui.scroll",
          "intent": "Expose the requested content for visible review.",
          "next": "done"
        }
      ]
    },
    "ui.swipe": {
      "description": "Swipe from a test-id target or explicit screen coordinates in one cardinal direction.",
      "adapters": ["android", "ios"],
      "schema": {
        "type": "object",
        "properties": {
          "target": {
            "type": ["string", "object"],
            "properties": { "x": { "type": "number" }, "y": { "type": "number" } },
            "required": ["x", "y"],
            "additionalProperties": false
          },
          "direction": { "type": "string", "enum": ["up", "down", "left", "right"] },
          "distance": { "type": "number", "minimum": 1 },
          "duration_ms": { "type": "integer", "minimum": 1 },
          "timeout_ms": { "type": "integer", "minimum": 1 },
          "settle": { "type": "boolean" }
        },
        "required": ["target", "direction", "distance", "duration_ms"],
        "additionalProperties": false
      },
      "examples": [
        {
          "action": "ui.swipe",
          "intent": "Swipe the requested visible surface.",
          "target": "example-scrollable",
          "direction": "up",
          "distance": 240,
          "duration_ms": 300,
          "next": "done"
        }
      ]
    },
    "ui.pan": {
      "description": "Stream a continuous pointer path from a test-id target or explicit screen coordinates. Android accepts multiple relative path points; iOS accepts one path point or delta.",
      "adapters": ["android", "ios"],
      "schema": {
        "type": "object",
        "properties": {
          "target": {
            "type": ["string", "object"],
            "properties": { "x": { "type": "number" }, "y": { "type": "number" } },
            "required": ["x", "y"],
            "additionalProperties": false
          },
          "path": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "properties": { "x": { "type": "number" }, "y": { "type": "number" } },
              "required": ["x", "y"],
              "additionalProperties": false
            }
          },
          "delta": {
            "type": "object",
            "properties": { "x": { "type": "number" }, "y": { "type": "number" } },
            "required": ["x", "y"],
            "additionalProperties": false
          },
          "duration_ms": { "type": "integer", "minimum": 1 },
          "timeout_ms": { "type": "integer", "minimum": 1 },
          "settle": { "type": "boolean" }
        },
        "required": ["target", "duration_ms"],
        "additionalProperties": false
      },
      "examples": [
        {
          "action": "ui.pan",
          "intent": "Pan through the requested pointer path.",
          "target": "example-surface",
          "path": [
            { "x": 40, "y": 0 },
            { "x": 80, "y": 20 }
          ],
          "duration_ms": 400,
          "next": "done"
        }
      ]
    },
    "ui.drag": {
      "description": "Drag a grabbable test-id target or explicit screen coordinate. Android accepts multiple relative path points; iOS accepts one path point or delta.",
      "adapters": ["android", "ios"],
      "schema": {
        "type": "object",
        "properties": {
          "target": {
            "type": ["string", "object"],
            "properties": { "x": { "type": "number" }, "y": { "type": "number" } },
            "required": ["x", "y"],
            "additionalProperties": false
          },
          "path": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "properties": { "x": { "type": "number" }, "y": { "type": "number" } },
              "required": ["x", "y"],
              "additionalProperties": false
            }
          },
          "delta": {
            "type": "object",
            "properties": { "x": { "type": "number" }, "y": { "type": "number" } },
            "required": ["x", "y"],
            "additionalProperties": false
          },
          "duration_ms": { "type": "integer", "minimum": 1 },
          "timeout_ms": { "type": "integer", "minimum": 1 },
          "settle": { "type": "boolean" }
        },
        "required": ["target", "duration_ms"],
        "additionalProperties": false
      },
      "examples": [
        {
          "action": "ui.drag",
          "intent": "Drag the requested control to a new value.",
          "target": "example-slider",
          "delta": { "x": 120, "y": 0 },
          "duration_ms": 500,
          "next": "done"
        }
      ]
    },
    "ui.long_press": {
      "description": "Hold a test-id target or explicit screen coordinate for a bounded duration.",
      "adapters": ["android", "ios"],
      "schema": {
        "type": "object",
        "properties": {
          "target": {
            "type": ["string", "object"],
            "properties": { "x": { "type": "number" }, "y": { "type": "number" } },
            "required": ["x", "y"],
            "additionalProperties": false
          },
          "holdMs": { "type": "integer", "minimum": 1 },
          "timeout_ms": { "type": "integer", "minimum": 1 },
          "settle": { "type": "boolean" }
        },
        "required": ["target", "holdMs"],
        "additionalProperties": false
      },
      "examples": [
        {
          "action": "ui.long_press",
          "intent": "Hold the requested visible control.",
          "target": "example-control",
          "holdMs": 700,
          "next": "done"
        }
      ]
    },
    "ui.wait_for": {
      "description": "Wait for native accessibility content and UI stability.",
      "schema": {
        "type": "object",
        "properties": {
          "text_contains": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "timeout_ms": {
            "type": "integer"
          },
          "text": {
            "type": "string"
          },
          "target": {
            "type": "string"
          },
          "test_id": {
            "type": "string"
          },
          "visible": {
            "type": "boolean"
          },
          "event": {
            "type": "string"
          },
          "selector": {
            "type": "string"
          },
          "expected": {
            "type": "string"
          }
        },
        "additionalProperties": false
      },
      "examples": [
        {
          "action": "ui.wait_for",
          "intent": "Confirm the requested application state is visible.",
          "test_id": "example-control",
          "visible": true,
          "next": "done"
        }
      ]
    },
    "ui.screenshot": {
      "description": "Capture the assigned native simulator or device into the artifact package.",
      "schema": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string"
          },
          "label": {
            "type": "string"
          },
          "claims": {
            "type": "object",
            "properties": {
              "must_show": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "must_not_show": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            },
            "additionalProperties": false
          },
          "covers": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "note": {
            "type": "string"
          }
        },
        "additionalProperties": false
      },
      "examples": [
        {
          "action": "ui.screenshot",
          "intent": "Preserve the visible application state as review evidence.",
          "label": "example-state",
          "next": "done"
        }
      ]
    },
    "end": {
      "description": "Terminate the recipe graph with pass, fail, or unknown.",
      "examples": [
        {
          "action": "end",
          "status": "pass"
        }
      ]
    }
  },
  "observers": [
    {
      "ref": "ui.screen",
      "default_for": [
        "ui.press",
        "ui.set_input",
        "ui.scroll",
        "ui.swipe",
        "ui.pan",
        "ui.drag",
        "ui.long_press",
        "ui.wait_for"
      ]
    },
    {
      "ref": "ui.visible",
      "default_for": [
        "ui.press",
        "ui.set_input",
        "ui.scroll",
        "ui.swipe",
        "ui.pan",
        "ui.drag",
        "ui.long_press",
        "ui.wait_for"
      ]
    }
  ]
}
