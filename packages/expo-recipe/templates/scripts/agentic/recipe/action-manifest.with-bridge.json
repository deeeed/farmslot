{
  "$schema": "https://farmslot.io/schemas/action-manifest-v1.schema.json",
  "actions": {
    "end": {
      "description": "Finish recipe execution with an explicit status.",
      "examples": [
        {
          "action": "end",
          "status": "pass"
        }
      ]
    },
    "command": {
      "description": "Run a project-local command during setup, diagnostics, or headless proof. Prefer UI actions only when the recipe must prove visible interaction.",
      "schema": {
        "type": "object",
        "properties": {
          "cmd": {
            "type": "string"
          },
          "timeout_ms": {
            "type": "integer"
          },
          "cwd": {
            "type": "string"
          },
          "allow_failure": {
            "type": "boolean"
          }
        },
        "required": ["cmd"],
        "additionalProperties": false
      },
      "examples": [
        {
          "action": "command",
          "intent": "Prepare the project state needed for this proof.",
          "cmd": "true",
          "next": "done"
        }
      ]
    },
    "app.status": {
      "description": "Query the dev-only Farmslot Expo bridge to confirm the app is reachable.",
      "schema": {
        "type": "object",
        "properties": {
          "timeout_ms": {
            "type": "integer"
          }
        },
        "additionalProperties": false
      },
      "examples": [
        {
          "action": "app.status",
          "intent": "Record the resolved application state before continuing.",
          "next": "done"
        }
      ]
    },
    "app.hud": {
      "description": "Display one concise human intent line from the current recipe node.",
      "schema": {
        "type": "object",
        "properties": {
          "clear": {
            "type": "boolean"
          }
        },
        "additionalProperties": false
      },
      "examples": [
        {
          "action": "app.hud",
          "intent": "Show the current goal to the supervising human.",
          "next": "done"
        }
      ]
    },
    "app.trace": {
      "description": "Emit a lightweight bridge trace event for recipe timeline observability.",
      "schema": {
        "type": "object",
        "additionalProperties": false
      },
      "examples": [
        {
          "action": "app.trace",
          "intent": "Record the requested runtime timeline evidence.",
          "next": "done"
        }
      ]
    },
    "ui.press": {
      "description": "Press a native accessibility target on the assigned simulator or device.",
      "schema": {
        "type": "object",
        "properties": {
          "test_id": {
            "type": "string"
          },
          "text": {
            "type": "string"
          },
          "selector": {
            "type": "string"
          }
        },
        "additionalProperties": false
      },
      "examples": [
        {
          "action": "ui.press",
          "intent": "Activate the requested visible control.",
          "test_id": "example-control",
          "next": "done"
        }
      ]
    },
    "ui.set_input": {
      "description": "Set text on a native input. Values remain part of retained recipe artifacts, so recipes must not contain secrets.",
      "schema": {
        "type": "object",
        "properties": {
          "test_id": {
            "type": "string"
          },
          "value": {
            "type": "string"
          }
        },
        "additionalProperties": false
      },
      "examples": [
        {
          "action": "ui.set_input",
          "intent": "Provide the requested value in the visible form.",
          "test_id": "example-input",
          "value": "example",
          "next": "done"
        }
      ]
    },
    "ui.scroll": {
      "description": "Scroll the assigned native simulator or device and wait for stability.",
      "schema": {
        "type": "object",
        "additionalProperties": false
      },
      "examples": [
        {
          "action": "ui.scroll",
          "intent": "Expose the requested content for visible review.",
          "next": "done"
        }
      ]
    },
    "ui.wait_for": {
      "description": "Wait for native accessibility content and UI stability.",
      "schema": {
        "type": "object",
        "properties": {
          "text_contains": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "timeout_ms": {
            "type": "integer"
          },
          "text": {
            "type": "string"
          },
          "target": {
            "type": "string"
          },
          "test_id": {
            "type": "string"
          },
          "visible": {
            "type": "boolean"
          },
          "event": {
            "type": "string"
          },
          "selector": {
            "type": "string"
          },
          "expected": {
            "type": "string"
          }
        },
        "additionalProperties": false
      },
      "examples": [
        {
          "action": "ui.wait_for",
          "intent": "Confirm the requested application state is visible.",
          "test_id": "example-control",
          "visible": true,
          "next": "done"
        }
      ]
    },
    "ui.screenshot": {
      "description": "Capture the assigned native simulator or device into the artifact package.",
      "schema": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string"
          },
          "label": {
            "type": "string"
          },
          "claims": {
            "type": "object",
            "properties": {
              "must_show": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "must_not_show": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            },
            "additionalProperties": false
          },
          "covers": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "note": {
            "type": "string"
          }
        },
        "additionalProperties": false
      },
      "examples": [
        {
          "action": "ui.screenshot",
          "intent": "Preserve the visible application state as review evidence.",
          "label": "example-state",
          "next": "done"
        }
      ]
    },
    "assert_output": {
      "description": "assert_output action.",
      "schema": {
        "type": "object",
        "properties": {
          "source": {
            "type": "string"
          },
          "stream": {
            "type": "string"
          },
          "contains": {
            "type": "string"
          },
          "match": {
            "type": "string"
          },
          "assert": {
            "type": "object",
            "additionalProperties": true
          }
        },
        "required": ["source"],
        "additionalProperties": false
      },
      "examples": [
        {
          "action": "assert_output",
          "intent": "Confirm the recorded output satisfies the requested condition.",
          "source": "command",
          "contains": "ready",
          "next": "done"
        }
      ]
    },
    "wait": {
      "description": "Pause briefly for asynchronous setup work. Keep waits short and prefer deterministic assertions.",
      "schema": {
        "type": "object",
        "properties": {
          "duration_ms": {
            "type": "integer"
          }
        },
        "required": ["duration_ms"],
        "additionalProperties": false
      },
      "examples": [
        {
          "action": "wait",
          "intent": "Allow the requested asynchronous state to settle.",
          "duration_ms": 1,
          "next": "done"
        }
      ]
    }
  },
  "observers": [
    {
      "ref": "ui.screen",
      "default_for": ["ui.press", "ui.set_input", "ui.scroll", "ui.wait_for"]
    },
    {
      "ref": "ui.visible",
      "default_for": ["ui.press", "ui.set_input", "ui.scroll", "ui.wait_for"]
    }
  ]
}
