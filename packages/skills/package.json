{
  "name": "@farmslot/skills",
  "version": "0.1.1",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "farmslot-checklist": "./bin/farmslot-checklist.mjs",
    "farmslot-skills": "./bin/farmslot-skills.mjs"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./skills/*": "./skills/*/SKILL.md",
    "./schemas/*": "./schemas/*",
    "./scripts/mark-checklist-step.cjs": "./scripts/mark-checklist-step.cjs"
  },
  "scripts": {
    "typecheck": "tsc --noEmit --project tsconfig.json",
    "test": "node test/mark-checklist-step.test.cjs && node test/prepare-cooking-run.test.cjs && node test/run-cooking-lane.test.cjs && node test/validator-loop.test.cjs && node test/package-exports.test.cjs",
    "format": "prettier --write --ignore-path ../../.prettierignore .",
    "format:check": "prettier --check --ignore-path ../../.prettierignore .",
    "lint": "eslint \"src/**/*.ts\"",
    "lint:fix": "eslint \"src/**/*.ts\" --fix",
    "quality": "prettier --check --ignore-path ../../.prettierignore . && eslint \"src/**/*.ts\" && tsc --noEmit --project tsconfig.json && yarn build && yarn test",
    "build": "rm -rf dist && tsc --project tsconfig.build.json",
    "prepack": "cd ../.. && node scripts/quality/check-farmslot-package-readiness.mjs --require-changelog --packages @farmslot/skills && yarn workspace @farmslot/skills build",
    "prepublishOnly": "node ../../scripts/quality/check-farmslot-package-readiness.mjs --publish --packages @farmslot/skills"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "eslint": "^10.3.0",
    "prettier": "^3.8.3",
    "typescript": "^5.6.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deeeed/farmslot.git",
    "directory": "packages/skills"
  },
  "bugs": {
    "url": "https://github.com/deeeed/farmslot/issues"
  },
  "license": "MIT",
  "homepage": "https://farmslot.io/docs/guides/recipe-skills-adoption",
  "keywords": [
    "farmslot",
    "skills",
    "recipe",
    "validation",
    "agentic-engineering"
  ],
  "files": [
    "README.md",
    "LICENSE",
    "CHANGELOG.md",
    "bin/**/*.mjs",
    "dist/**/*.js",
    "dist/**/*.d.ts",
    "dist/**/*.d.ts.map",
    "dist/**/*.js.map",
    "schemas/**/*.json",
    "scripts/**/*.cjs",
    "skills/**/*.md",
    "templates/**/*.json"
  ],
  "publishConfig": {
    "access": "public"
  }
}
