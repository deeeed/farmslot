{
  "$schema": "https://farmslot.io/schemas/recipe-v1.schema.json",
  "title": "Example Browser App Perps market proof",
  "description": "Example v1 Extension recipe using official ui/cdp actions plus Example App custom wallet actions.",
  "paramsSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "market": {
        "type": "string",
        "default": "ETH"
      }
    }
  },
  "proofTargets": [
    {
      "id": "AC-1",
      "claim": "Capture the visible {{params.market}} Perps market row for review"
    }
  ],
  "workflow": {
    "entry": "setup-1",
    "nodes": {
      "unlock-wallet": {
        "action": "example.wallet.unlock",
        "account": "primary",
        "next": "open-perps",
        "intent": "Unlock the primary wallet account before opening Perps"
      },
      "open-perps": {
        "action": "ui.navigate",
        "target": "#/perps?market={{params.market}}",
        "next": "wait-market",
        "intent": "Open the extension Perps market screen for {{params.market}}"
      },
      "wait-market": {
        "action": "ui.wait_for",
        "selector": "[data-testid=perps-market-row-{{params.market}}]",
        "visible": true,
        "timeout_ms": 10000,
        "next": "capture-proof",
        "intent": "Confirm the {{params.market}} Perps market row is visible"
      },
      "capture-proof": {
        "action": "ui.screenshot",
        "path": "screenshots/extension-perps-market.png",
        "claims": {
          "must_show": ["{{params.market}}", "Perps"],
          "must_not_show": ["Error"]
        },
        "covers": ["perps-market-visible"],
        "next": "index-artifacts",
        "intent": "Record the visible {{params.market}} Perps market row for review",
        "proves": ["AC-1"]
      },
      "index-artifacts": {
        "action": "index_artifacts",
        "artifacts": ["recipe-issues.json"],
        "next": "done",
        "intent": "Publish the recipe issue report for review"
      },
      "done": {
        "action": "end",
        "status": "pass"
      },
      "setup-2": {
        "action": "cdp.network",
        "mode": "observe",
        "capture": ["request", "response", "failure"],
        "intent": "Start observing network traffic during the Perps proof",
        "next": "unlock-wallet"
      },
      "setup-1": {
        "action": "cdp.target",
        "role": "extension",
        "intent": "Attach CDP to the extension target before the Perps proof",
        "next": "setup-2"
      },
      "teardown-done": {
        "action": "end",
        "status": "pass"
      },
      "teardown-1": {
        "action": "cdp.network",
        "mode": "stop",
        "intent": "Stop network observation after the Perps proof",
        "next": "teardown-done"
      }
    },
    "teardown": "teardown-1"
  }
}
