{
  "schema_version": 1,
  "title": "Example Browser App Perps market proof",
  "description": "Example v1 Extension recipe using official ui/cdp actions plus Example App custom wallet actions.",
  "inputs": {
    "market": {
      "type": "string",
      "default": "ETH"
    }
  },
  "fail_on_unexpected": {
    "enabled": true,
    "levels": ["error", "exception"],
    "allow": []
  },
  "validate": {
    "workflow": {
      "pre_conditions": [
        {
          "id": "example.browser.cdp_ready",
          "description": "Approved CDP target set is reachable.",
          "required": true
        },
        {
          "id": "example.browser.profile_isolated",
          "description": "Isolated extension browser profile is active.",
          "required": true
        }
      ],
      "setup": [
        {
          "action": "cdp.target",
          "role": "extension",
          "intent": "Attach CDP to the extension target before the Perps proof"
        },
        {
          "action": "cdp.network",
          "mode": "observe",
          "capture": ["request", "response", "failure"],
          "intent": "Start observing network traffic during the Perps proof"
        }
      ],
      "entry": "unlock-wallet",
      "nodes": {
        "unlock-wallet": {
          "action": "example.wallet.unlock",
          "account": "primary",
          "next": "open-perps",
          "intent": "Unlock the primary wallet account before opening Perps"
        },
        "open-perps": {
          "action": "ui.navigate",
          "target": "#/perps?market={{market}}",
          "next": "wait-market",
          "intent": "Open the extension Perps market screen for {{market}}"
        },
        "wait-market": {
          "action": "ui.wait_for",
          "selector": "[data-testid=perps-market-row-{{market}}]",
          "visible": true,
          "timeout_ms": 10000,
          "next": "capture-proof",
          "intent": "Wait for the {{market}} Perps market row to become visible"
        },
        "capture-proof": {
          "action": "ui.screenshot",
          "path": "screenshots/extension-perps-market.png",
          "claims": {
            "must_show": ["{{market}}", "Perps"],
            "must_not_show": ["Error"]
          },
          "proofTarget": "AC-1",
          "covers": ["perps-market-visible"],
          "next": "index-artifacts",
          "intent": "Capture the visible {{market}} Perps market row for review"
        },
        "index-artifacts": {
          "action": "index_artifacts",
          "artifacts": ["screenshots/extension-perps-market.png", "recipe-issues.json"],
          "next": "done",
          "intent": "Publish the index artifacts evidence for review"
        },
        "done": {
          "action": "end",
          "status": "pass"
        }
      },
      "teardown": [
        {
          "action": "cdp.network",
          "mode": "stop",
          "intent": "Stop network observation after the Perps proof"
        }
      ],
      "playback": {
        "mode": "auto",
        "slow_ms": 2000
      }
    }
  }
}
