{
  "$schema": "https://farmslot.io/schemas/recipe-v1.schema.json",
  "title": "Live UI checkout review",
  "description": "Drives a UI checkout path slowly enough for the streaming panel and records reviewer-visible screenshots.",
  "paramsSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "base_url": {
        "type": "string",
        "default": "http://localhost:5174"
      }
    }
  },
  "workflow": {
    "entry": "open-checkout",
    "nodes": {
      "open-checkout": {
        "action": "ui.navigate",
        "next": "fill-shipping",
        "target": "{{params.base_url}}/#/checkout",
        "intent": "Open the checkout page in the browser"
      },
      "fill-shipping": {
        "action": "ui.set_input",
        "next": "submit-order",
        "test_id": "shipping-address",
        "value": "1 Recipe Protocol Way",
        "intent": "Provide the shipping details required to place the order"
      },
      "submit-order": {
        "action": "ui.press",
        "next": "wait-confirmation",
        "test_id": "submit-order",
        "intent": "Submit the order from the checkout form"
      },
      "wait-confirmation": {
        "action": "ui.wait_for",
        "next": "capture-confirmation",
        "text": "Order confirmed",
        "intent": "Confirm the order was accepted"
      },
      "capture-confirmation": {
        "action": "ui.screenshot",
        "path": "screenshots/checkout-confirmation.png",
        "next": "done",
        "intent": "Record the successful order confirmation for mobile and web reviewers"
      },
      "done": {
        "action": "end",
        "status": "pass"
      }
    }
  }
}
