{
  "$schema": "https://farmslot.io/schemas/action-manifest-v1.schema.json",
  "actions": {
    "call": {
      "description": "Invoke a named child recipe with explicit parameters.",
      "examples": [
        {
          "action": "call",
          "intent": "Reuse a shared browser setup recipe.",
          "ref": "browser.setup",
          "params": {},
          "next": "done"
        }
      ]
    },
    "end": {
      "description": "Finish recipe execution with an explicit status.",
      "examples": [
        {
          "action": "end",
          "status": "pass"
        }
      ]
    },
    "cdp.target": {
      "description": "Select extension, notification, dapp, or background CDP targets.",
      "schema": {
        "type": "object",
        "properties": {
          "role": {
            "type": "string"
          }
        },
        "additionalProperties": false
      },
      "examples": [
        {
          "action": "cdp.target",
          "role": "extension",
          "next": "open-perps",
          "intent": "Confirm the requested application target is available."
        }
      ]
    },
    "ui.navigate": {
      "description": "Navigate by extension route/hash, dapp URL, or selected CDP target page.",
      "schema": {
        "type": "object",
        "properties": {
          "target": {
            "type": "string"
          },
          "params": {
            "type": "object",
            "properties": {
              "market": {
                "type": "string"
              }
            },
            "additionalProperties": false
          }
        },
        "additionalProperties": false
      },
      "examples": [
        {
          "action": "ui.navigate",
          "target": "#/perps",
          "next": "wait-for-perps",
          "intent": "Open the requested application surface."
        }
      ]
    },
    "ui.wait_for": {
      "description": "Wait for DOM selector, text, target role, or extension screen state.",
      "schema": {
        "type": "object",
        "properties": {
          "text_contains": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "timeout_ms": {
            "type": "integer"
          },
          "text": {
            "type": "string"
          },
          "target": {
            "type": "string"
          },
          "test_id": {
            "type": "string"
          },
          "visible": {
            "type": "boolean"
          },
          "event": {
            "type": "string"
          },
          "selector": {
            "type": "string"
          },
          "expected": {
            "type": "string"
          }
        },
        "additionalProperties": false
      },
      "examples": [
        {
          "action": "ui.wait_for",
          "selector": "[data-testid=perps-market-row-ETH]",
          "visible": true,
          "timeout_ms": 10000,
          "next": "capture-proof",
          "intent": "Confirm the requested application state is visible."
        }
      ]
    },
    "cdp.network": {
      "description": "Observe/probe network and fetch activity through CDP, including request/response/failure JSONL capture.",
      "schema": {
        "type": "object",
        "properties": {
          "mode": {
            "type": "string"
          },
          "capture": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "additionalProperties": false
      },
      "examples": [
        {
          "action": "cdp.network",
          "mode": "observe",
          "capture": ["request", "response", "failure"],
          "next": "run-flow",
          "intent": "Record the requested network behavior for proof."
        }
      ]
    },
    "cdp.trace": {
      "description": "Start or stop CDP tracing/profiling capture.",
      "schema": {
        "type": "object",
        "properties": {
          "mode": {
            "type": "string"
          },
          "categories": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "additionalProperties": false
      },
      "examples": [
        {
          "action": "cdp.trace",
          "mode": "start",
          "categories": ["devtools.timeline"],
          "next": "open-perps",
          "intent": "Record the requested browser execution timeline."
        }
      ]
    },
    "ui.set_input": {
      "description": "Set text through the real UI input path.",
      "examples": [
        {
          "action": "ui.set_input",
          "test_id": "account-search-input",
          "value": "Account",
          "intent": "Provide the requested value in the visible form.",
          "next": "done"
        }
      ],
      "schema": {
        "type": "object",
        "properties": {
          "test_id": {
            "type": "string"
          },
          "value": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    "ui.press": {
      "description": "ui.press action.",
      "schema": {
        "type": "object",
        "properties": {
          "test_id": {
            "type": "string"
          },
          "text": {
            "type": "string"
          },
          "selector": {
            "type": "string"
          }
        },
        "additionalProperties": false
      },
      "examples": [
        {
          "action": "ui.press",
          "intent": "Activate the requested visible control.",
          "test_id": "example-control",
          "next": "done"
        }
      ]
    },
    "ui.key_press": {
      "description": "ui.key_press action.",
      "schema": {
        "type": "object",
        "additionalProperties": false
      },
      "examples": [
        {
          "action": "ui.key_press",
          "intent": "Continue the requested keyboard interaction.",
          "next": "done"
        }
      ]
    },
    "ui.scroll": {
      "description": "Raw scroll movement: offset_x/offset_y set an absolute position, delta_x/delta_y move relative to the current one; the two are never combined. To reveal a proof target use ui.scroll_to.",
      "schema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "test_id": {
            "type": "string",
            "description": "Scroll container; omit to move the page root."
          },
          "offset_x": {
            "type": "number",
            "description": "Absolute horizontal offset in px."
          },
          "offset_y": {
            "type": "number",
            "description": "Absolute vertical offset in px."
          },
          "delta_x": {
            "type": "number",
            "description": "Relative horizontal movement in px."
          },
          "delta_y": {
            "type": "number",
            "description": "Relative vertical movement in px."
          }
        }
      },
      "examples": [
        {
          "action": "ui.scroll",
          "intent": "Return the list to its top before the next proof step.",
          "test_id": "orders-list",
          "offset_y": 0,
          "next": "done"
        }
      ]
    },
    "ui.scroll_to": {
      "description": "Canonical scroll-to-visible: move one named scroll surface until the semantic proof target (or its measurable visibility anchor) rests inside the HUD-safe viewport, wait for geometry to settle, and verify it. The trace output is the evidence; failures are harness errors with stable SCROLL_* codes. Prove one scroll node with --stop-after-node before composing a larger flow: plan success is schema confidence only, not runtime proof.",
      "schema": {
        "type": "object",
        "additionalProperties": false,
        "required": ["surface_test_id", "target_test_id"],
        "properties": {
          "surface_test_id": {
            "type": "string",
            "description": "Test id of the scroll container whose offset moves."
          },
          "target_test_id": {
            "type": "string",
            "description": "Semantic proof target. It must be present when the node ends."
          },
          "visibility_anchor_test_id": {
            "type": "string",
            "description": "Measurable element used for positioning and the visibility verdict when the target has no measurable box, such as a flattened Text node."
          },
          "align": {
            "type": "string",
            "enum": ["start", "center", "end", "nearest"],
            "default": "nearest",
            "description": "Where the measured element should rest inside the safe viewport."
          },
          "viewport_policy": {
            "type": "string",
            "enum": ["hud_safe", "full"],
            "default": "hud_safe",
            "description": "hud_safe removes HUD and overlay occlusion from the viewport before positioning and verifying; full uses the raw surface viewport."
          },
          "verify_visible": {
            "type": "boolean",
            "default": true,
            "description": "Fail with SCROLL_TARGET_NOT_VISIBLE when the settled element is outside the safe viewport."
          },
          "settle": {
            "type": "object",
            "additionalProperties": false,
            "description": "Geometry settlement after movement: consecutive identical measurements within a budget.",
            "properties": {
              "timeout_ms": {
                "type": "number",
                "minimum": 0,
                "description": "Settlement budget in milliseconds."
              },
              "interval_ms": {
                "type": "number",
                "minimum": 1,
                "description": "Delay between measurements."
              },
              "stable_samples": {
                "type": "integer",
                "minimum": 1,
                "description": "Consecutive unchanged measurements required to call the layout settled."
              }
            }
          }
        }
      },
      "examples": [
        {
          "action": "ui.scroll_to",
          "intent": "The History row is reviewable above the recipe HUD.",
          "surface_test_id": "orders-list",
          "target_test_id": "history-row",
          "align": "center",
          "next": "capture-history"
        },
        {
          "action": "ui.scroll_to",
          "intent": "The validation message is reviewable even though its text node has no box.",
          "surface_test_id": "order-form",
          "target_test_id": "validation-text",
          "visibility_anchor_test_id": "validation-row",
          "settle": {
            "timeout_ms": 1500
          },
          "next": "capture-validation"
        }
      ]
    },
    "ui.screenshot": {
      "description": "ui.screenshot action.",
      "schema": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string"
          },
          "label": {
            "type": "string"
          },
          "claims": {
            "type": "object",
            "properties": {
              "must_show": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "must_not_show": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            },
            "additionalProperties": false
          },
          "covers": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "note": {
            "type": "string"
          }
        },
        "additionalProperties": false
      },
      "examples": [
        {
          "action": "ui.screenshot",
          "intent": "Preserve the visible application state as review evidence.",
          "label": "example-state",
          "next": "done"
        }
      ]
    },
    "cdp.storage": {
      "description": "cdp.storage action.",
      "schema": {
        "type": "object",
        "additionalProperties": false
      },
      "examples": [
        {
          "action": "cdp.storage",
          "intent": "Record the requested browser storage state for proof.",
          "next": "done"
        }
      ]
    },
    "cdp.emulation": {
      "description": "cdp.emulation action.",
      "schema": {
        "type": "object",
        "additionalProperties": false
      },
      "examples": [
        {
          "action": "cdp.emulation",
          "intent": "Apply the requested browser environment for this proof.",
          "next": "done"
        }
      ]
    },
    "cdp.metrics": {
      "description": "cdp.metrics action.",
      "schema": {
        "type": "object",
        "additionalProperties": false
      },
      "examples": [
        {
          "action": "cdp.metrics",
          "intent": "Record the requested browser performance measurements.",
          "next": "done"
        }
      ]
    },
    "state_read": {
      "description": "state_read action.",
      "schema": {
        "type": "object",
        "properties": {
          "source": {
            "type": "string"
          },
          "path": {
            "type": "string"
          }
        },
        "required": ["source"],
        "additionalProperties": false
      },
      "examples": [
        {
          "action": "state_read",
          "intent": "Record the requested application state for proof.",
          "source": "command",
          "path": "$.stdout",
          "next": "done"
        }
      ]
    },
    "watch_logs": {
      "description": "watch_logs action.",
      "schema": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string"
          },
          "contains": {
            "type": "string"
          },
          "scope": {
            "type": "string",
            "enum": ["run", "file"]
          }
        },
        "required": ["path"],
        "additionalProperties": false
      },
      "examples": [
        {
          "action": "watch_logs",
          "intent": "Observe the runtime behavior needed for this proof.",
          "path": "logs/example.log",
          "contains": "ready",
          "scope": "file",
          "next": "done"
        }
      ]
    },
    "index_artifacts": {
      "description": "index_artifacts action.",
      "schema": {
        "type": "object",
        "properties": {
          "artifacts": {
            "type": "array",
            "items": {
              "type": ["object", "string"],
              "properties": {
                "path": {
                  "type": "string"
                },
                "type": {
                  "type": "string"
                },
                "label": {
                  "type": "string"
                },
                "nodeId": {
                  "type": "string"
                },
                "mimeType": {
                  "type": "string"
                },
                "category": {
                  "type": "string"
                },
                "proofTarget": {
                  "type": "string"
                },
                "covers": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              },
              "additionalProperties": false
            }
          }
        },
        "required": ["artifacts"],
        "additionalProperties": false
      },
      "examples": [
        {
          "action": "index_artifacts",
          "intent": "Preserve generated evidence in the review package.",
          "artifacts": ["reports/example.json"],
          "next": "done"
        }
      ]
    },
    "switch": {
      "description": "Choose a graph branch when one resolved string equals another.",
      "schema": {
        "type": "object",
        "properties": {
          "value": {
            "type": "string"
          },
          "equals": {
            "type": "string"
          }
        },
        "required": ["value", "equals"],
        "additionalProperties": false
      },
      "result_cases": ["match"],
      "examples": [
        {
          "action": "switch",
          "intent": "Choose the graph path matching the observed state.",
          "value": "example",
          "equals": "example",
          "next": "done"
        }
      ]
    },
    "example.wallet.unlock": {
      "description": "Unlock a debug Example App wallet through the real extension unlock path.",
      "schema": {
        "type": "object",
        "properties": {
          "account": {
            "type": "string"
          }
        },
        "required": ["account"],
        "additionalProperties": false
      },
      "examples": [
        {
          "action": "example.wallet.unlock",
          "intent": "Ensure the primary Example App wallet is unlocked.",
          "account": "primary",
          "next": "open-perps"
        }
      ],
      "execution_capabilities": ["app-mutation"]
    },
    "example.wallet.select_network": {
      "description": "Select or configure an Example App network fixture.",
      "schema": {
        "type": "object",
        "properties": {
          "network": {
            "type": "string"
          },
          "chainId": {
            "type": "string"
          }
        },
        "additionalProperties": false
      },
      "examples": [
        {
          "action": "example.wallet.select_network",
          "intent": "Use Sepolia for the following Example App checks.",
          "network": "sepolia",
          "next": "open-perps"
        }
      ],
      "execution_capabilities": ["app-mutation"]
    },
    "example.debug.eval": {
      "description": "Debug-only CDP eval escape hatch for setup diagnostics, not primary proof.",
      "schema": {
        "type": "object",
        "properties": {
          "target": {
            "type": "string"
          },
          "expression": {
            "type": "string"
          },
          "save_as": {
            "type": "string"
          }
        },
        "required": ["expression"],
        "additionalProperties": false
      },
      "examples": [
        {
          "action": "example.debug.eval",
          "intent": "Inspect the background page URL while diagnosing setup.",
          "target": "background",
          "expression": "location.href",
          "save_as": "background_url",
          "next": "done"
        }
      ],
      "execution_capabilities": ["arbitrary-code"]
    }
  }
}
