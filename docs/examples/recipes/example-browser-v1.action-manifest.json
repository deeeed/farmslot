{
  "runner_protocol_version": 1,
  "action_registry_version": 1,
  "supported_official_actions": [
    "ui.navigate",
    "ui.press",
    "ui.key_press",
    "ui.set_input",
    "ui.scroll",
    "ui.wait_for",
    "ui.screenshot",
    "cdp.target",
    "cdp.storage",
    "cdp.network",
    "cdp.emulation",
    "cdp.metrics",
    "cdp.trace",
    "state_read",
    "watch_logs",
    "index_artifacts",
    "call",
    "switch",
    "end"
  ],
  "action_metadata": {
    "cdp.target": {
      "description": "Select extension, notification, dapp, or background CDP targets.",
      "schema": {
        "type": "object",
        "properties": {
          "role": {
            "type": "string"
          }
        },
        "additionalProperties": false
      },
      "examples": [
        {
          "description": "Select the main extension UI target.",
          "node": {
            "action": "cdp.target",
            "role": "extension",
            "next": "open-perps",
            "intent": "Select the main extension UI target"
          }
        }
      ]
    },
    "ui.navigate": {
      "description": "Navigate by extension route/hash, dapp URL, or selected CDP target page.",
      "schema": {
        "type": "object",
        "properties": {
          "target": {
            "type": "string"
          },
          "params": {
            "type": "object",
            "properties": {
              "market": {
                "type": "string"
              }
            },
            "additionalProperties": false
          }
        },
        "additionalProperties": false
      },
      "examples": [
        {
          "node": {
            "action": "ui.navigate",
            "target": "#/perps",
            "next": "wait-for-perps",
            "intent": "Navigate by extension route/hash, dapp URL, or selected CDP target page"
          }
        }
      ]
    },
    "ui.wait_for": {
      "description": "Wait for DOM selector, text, target role, or extension screen state.",
      "schema": {
        "type": "object",
        "properties": {
          "text_contains": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "timeout_ms": {
            "type": "integer"
          },
          "text": {
            "type": "string"
          },
          "target": {
            "type": "string"
          },
          "test_id": {
            "type": "string"
          },
          "visible": {
            "type": "boolean"
          },
          "event": {
            "type": "string"
          },
          "selector": {
            "type": "string"
          },
          "expected": {
            "type": "string"
          }
        },
        "additionalProperties": false
      },
      "examples": [
        {
          "node": {
            "action": "ui.wait_for",
            "selector": "[data-testid=perps-market-row-ETH]",
            "visible": true,
            "timeout_ms": 10000,
            "next": "capture-proof",
            "intent": "Wait for DOM selector, text, target role, or extension screen state"
          }
        }
      ]
    },
    "cdp.network": {
      "description": "Observe/probe network and fetch activity through CDP, including request/response/failure JSONL capture.",
      "schema": {
        "type": "object",
        "properties": {
          "mode": {
            "type": "string"
          },
          "capture": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "additionalProperties": false
      },
      "examples": [
        {
          "node": {
            "action": "cdp.network",
            "mode": "observe",
            "capture": ["request", "response", "failure"],
            "next": "run-flow",
            "intent": "Observe/probe network and fetch activity through CDP, including request/response/failure JSONL capture"
          }
        }
      ]
    },
    "cdp.trace": {
      "description": "Start or stop CDP tracing/profiling capture.",
      "schema": {
        "type": "object",
        "properties": {
          "mode": {
            "type": "string"
          },
          "categories": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "additionalProperties": false
      },
      "examples": [
        {
          "node": {
            "action": "cdp.trace",
            "mode": "start",
            "categories": ["devtools.timeline"],
            "next": "open-perps",
            "intent": "Start or stop CDP tracing/profiling capture"
          }
        }
      ]
    },
    "ui.set_input": {
      "description": "Set text through the real UI input path.",
      "examples": [
        {
          "node": {
            "action": "ui.set_input",
            "test_id": "account-search-input",
            "value": "Account",
            "intent": "Set text through the real UI input path"
          }
        }
      ],
      "schema": {
        "type": "object",
        "properties": {
          "test_id": {
            "type": "string"
          },
          "value": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    "ui.press": {
      "description": "ui.press action.",
      "schema": {
        "type": "object",
        "properties": {
          "test_id": {
            "type": "string"
          },
          "text": {
            "type": "string"
          },
          "selector": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    "ui.key_press": {
      "description": "ui.key_press action.",
      "schema": {
        "type": "object",
        "additionalProperties": false
      }
    },
    "ui.scroll": {
      "description": "ui.scroll action.",
      "schema": {
        "type": "object",
        "additionalProperties": false
      }
    },
    "ui.screenshot": {
      "description": "ui.screenshot action.",
      "schema": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string"
          },
          "label": {
            "type": "string"
          },
          "claims": {
            "type": "object",
            "properties": {
              "must_show": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "must_not_show": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            },
            "additionalProperties": false
          },
          "covers": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "note": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    "cdp.storage": {
      "description": "cdp.storage action.",
      "schema": {
        "type": "object",
        "additionalProperties": false
      }
    },
    "cdp.emulation": {
      "description": "cdp.emulation action.",
      "schema": {
        "type": "object",
        "additionalProperties": false
      }
    },
    "cdp.metrics": {
      "description": "cdp.metrics action.",
      "schema": {
        "type": "object",
        "additionalProperties": false
      }
    },
    "state_read": {
      "description": "state_read action.",
      "schema": {
        "type": "object",
        "properties": {
          "save_as": {
            "type": "string"
          },
          "assert": {
            "type": "object",
            "properties": {
              "path": {
                "type": "string"
              },
              "operator": {
                "type": "string"
              },
              "value": {
                "type": "string"
              }
            },
            "additionalProperties": false
          }
        },
        "additionalProperties": false
      }
    },
    "watch_logs": {
      "description": "watch_logs action.",
      "schema": {
        "type": "object",
        "additionalProperties": false
      }
    },
    "index_artifacts": {
      "description": "index_artifacts action.",
      "schema": {
        "type": "object",
        "properties": {
          "artifacts": {
            "type": "array",
            "items": {
              "type": ["object", "string"],
              "properties": {
                "path": {
                  "type": "string"
                },
                "type": {
                  "type": "string"
                },
                "label": {
                  "type": "string"
                }
              },
              "additionalProperties": false
            }
          }
        },
        "additionalProperties": false
      }
    },
    "switch": {
      "description": "Choose a graph branch when one resolved string equals another.",
      "schema": {
        "type": "object",
        "properties": {
          "value": { "type": "string" },
          "equals": { "type": "string" }
        },
        "required": ["value", "equals"],
        "additionalProperties": false
      },
      "result_cases": ["match"]
    }
  },
  "custom_actions": [
    {
      "name": "example.wallet.unlock",
      "owner": "example",
      "description": "Unlock a debug Example App wallet through the real extension unlock path.",
      "schema": {
        "type": "object",
        "properties": {
          "account": {
            "type": "string"
          }
        },
        "required": ["account"],
        "additionalProperties": false
      },
      "examples": [
        {
          "node": {
            "action": "example.wallet.unlock",
            "account": "primary",
            "next": "open-perps"
          }
        }
      ],
      "execution_capabilities": ["app-mutation"]
    },
    {
      "name": "example.wallet.select_network",
      "owner": "example",
      "description": "Select or configure an Example App network fixture.",
      "schema": {
        "type": "object",
        "properties": {
          "network": {
            "type": "string"
          },
          "chainId": {
            "type": "string"
          }
        },
        "additionalProperties": false
      },
      "examples": [
        {
          "node": {
            "action": "example.wallet.select_network",
            "network": "sepolia",
            "next": "open-perps"
          }
        }
      ],
      "execution_capabilities": ["app-mutation"]
    },
    {
      "name": "example.debug.eval",
      "owner": "example",
      "description": "Debug-only CDP eval escape hatch for setup diagnostics, not primary proof.",
      "schema": {
        "type": "object",
        "properties": {
          "target": {
            "type": "string"
          },
          "expression": {
            "type": "string"
          },
          "save_as": {
            "type": "string"
          }
        },
        "required": ["expression"],
        "additionalProperties": false
      },
      "examples": [
        {
          "node": {
            "action": "example.debug.eval",
            "target": "background",
            "expression": "location.href",
            "save_as": "background_url",
            "next": "done"
          }
        }
      ],
      "safety_notes": "Use cdp.*, ui.*, or state_read refs for proof. This action is debug-only.",
      "execution_capabilities": ["arbitrary-code"]
    }
  ],
  "native_bindings": [
    {
      "action": "cdp.target",
      "implementation": "example-browser/cdp/select-target"
    },
    {
      "action": "ui.wait_for",
      "implementation": "example-browser/cdp/wait-for-dom"
    },
    {
      "action": "cdp.network",
      "implementation": "example-browser/cdp/network-probe"
    },
    {
      "action": "ui.set_input",
      "implementation": "example-browser/cdp/set-input"
    }
  ]
}
