{
  "runner_protocol_version": 1,
  "action_registry_version": 1,
  "supported_official_actions": [
    "ui.navigate",
    "ui.press",
    "ui.key_press",
    "ui.set_input",
    "ui.scroll",
    "ui.wait_for",
    "ui.screenshot",
    "cdp.target",
    "cdp.storage",
    "cdp.network",
    "cdp.emulation",
    "cdp.metrics",
    "cdp.trace",
    "state_read",
    "watch_logs",
    "index_artifacts",
    "call",
    "switch",
    "end"
  ],
  "action_metadata": {
    "cdp.target": {
      "description": "Select extension, notification, dapp, or background CDP targets.",
      "schema": {
        "type": "object"
      },
      "examples": [
        {
          "description": "Select the main extension UI target.",
          "node": {
            "action": "cdp.target",
            "role": "extension",
            "next": "open-perps",
            "intent": "Select the main extension UI target"
          }
        }
      ]
    },
    "ui.navigate": {
      "description": "Navigate by extension route/hash, dapp URL, or selected CDP target page.",
      "schema": {
        "type": "object"
      },
      "examples": [
        {
          "node": {
            "action": "ui.navigate",
            "target": "#/perps",
            "next": "wait-for-perps",
            "intent": "Navigate by extension route/hash, dapp URL, or selected CDP target page"
          }
        }
      ]
    },
    "ui.wait_for": {
      "description": "Wait for DOM selector, text, target role, or extension screen state.",
      "schema": {
        "type": "object"
      },
      "examples": [
        {
          "node": {
            "action": "ui.wait_for",
            "selector": "[data-testid=perps-market-row-ETH]",
            "visible": true,
            "timeout_ms": 10000,
            "next": "capture-proof",
            "intent": "Wait for DOM selector, text, target role, or extension screen state"
          }
        }
      ]
    },
    "cdp.network": {
      "description": "Observe/probe network and fetch activity through CDP, including request/response/failure JSONL capture.",
      "schema": {
        "type": "object"
      },
      "examples": [
        {
          "node": {
            "action": "cdp.network",
            "mode": "observe",
            "capture": ["request", "response", "failure"],
            "next": "run-flow",
            "intent": "Observe/probe network and fetch activity through CDP, including request/response/failure JSONL capture"
          }
        }
      ]
    },
    "cdp.trace": {
      "description": "Start or stop CDP tracing/profiling capture.",
      "schema": {
        "type": "object"
      },
      "examples": [
        {
          "node": {
            "action": "cdp.trace",
            "mode": "start",
            "categories": ["devtools.timeline"],
            "next": "open-perps",
            "intent": "Start or stop CDP tracing/profiling capture"
          }
        }
      ]
    },
    "ui.set_input": {
      "description": "Set text through the real UI input path.",
      "examples": [
        {
          "node": {
            "action": "ui.set_input",
            "test_id": "account-search-input",
            "value": "Account",
            "intent": "Set text through the real UI input path"
          }
        }
      ]
    }
  },
  "state_refs": [
    {
      "ref": "example.browser.route",
      "description": "Current extension hash/route.",
      "schema": {
        "type": "object"
      }
    },
    {
      "ref": "example.browser.wallet_status",
      "description": "Wallet lock/account/network status from safe extension state refs.",
      "schema": {
        "type": "object"
      }
    }
  ],
  "pre_conditions": [
    {
      "id": "example.browser.cdp_ready",
      "description": "Approved CDP target set is reachable.",
      "failure_kind": "setup"
    },
    {
      "id": "example.browser.profile_isolated",
      "description": "Isolated extension browser profile is active.",
      "failure_kind": "environment"
    }
  ],
  "custom_actions": [
    {
      "name": "example.wallet.unlock",
      "owner": "example",
      "description": "Unlock a debug Example App wallet through the real extension unlock path.",
      "schema": {
        "type": "object",
        "properties": {
          "account": {
            "type": "string"
          },
          "next": {
            "type": "string"
          }
        },
        "required": ["account"],
        "additionalProperties": false
      },
      "examples": [
        {
          "node": {
            "action": "example.wallet.unlock",
            "account": "primary",
            "next": "open-perps"
          }
        }
      ]
    },
    {
      "name": "example.wallet.select_network",
      "owner": "example",
      "description": "Select or configure an Example App network fixture.",
      "schema": {
        "type": "object",
        "properties": {
          "network": {
            "type": "string"
          },
          "chainId": {
            "type": "string"
          },
          "next": {
            "type": "string"
          }
        },
        "additionalProperties": false
      },
      "examples": [
        {
          "node": {
            "action": "example.wallet.select_network",
            "network": "sepolia",
            "next": "open-perps"
          }
        }
      ]
    },
    {
      "name": "example.debug.eval",
      "owner": "example",
      "description": "Debug-only CDP eval escape hatch for setup diagnostics, not primary proof.",
      "schema": {
        "type": "object",
        "properties": {
          "target": {
            "type": "string"
          },
          "expression": {
            "type": "string"
          },
          "save_as": {
            "type": "string"
          },
          "next": {
            "type": "string"
          }
        },
        "required": ["expression"],
        "additionalProperties": false
      },
      "examples": [
        {
          "node": {
            "action": "example.debug.eval",
            "target": "background",
            "expression": "location.href",
            "save_as": "background_url",
            "next": "done"
          }
        }
      ],
      "safety_notes": "Use cdp.*, ui.*, or state_read refs for proof. This action is debug-only."
    }
  ],
  "native_bindings": [
    {
      "action": "cdp.target",
      "implementation": "example-browser/cdp/select-target"
    },
    {
      "action": "ui.wait_for",
      "implementation": "example-browser/cdp/wait-for-dom"
    },
    {
      "action": "cdp.network",
      "implementation": "example-browser/cdp/network-probe"
    },
    {
      "action": "ui.set_input",
      "implementation": "example-browser/cdp/set-input"
    }
  ]
}
