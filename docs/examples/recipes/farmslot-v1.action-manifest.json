{
  "$schema": "https://farmslot.io/schemas/action-manifest-v1.schema.json",
  "actions": {
    "end": {
      "description": "Finish recipe execution with an explicit status.",
      "examples": [
        {
          "action": "end",
          "status": "pass"
        }
      ]
    },
    "ui.navigate": {
      "description": "Navigate Command Center, Mobile Companion, or browser surfaces by route/hash/URL.",
      "examples": [
        {
          "action": "ui.navigate",
          "target": "#slot/{{slot_id}}?reviewDrawer=recipe",
          "next": "wait-for-panel",
          "intent": "Open the requested application surface."
        }
      ],
      "schema": {
        "type": "object",
        "properties": {
          "target": {
            "type": "string"
          },
          "params": {
            "type": "object",
            "properties": {
              "market": {
                "type": "string"
              }
            },
            "additionalProperties": false
          }
        },
        "additionalProperties": false
      }
    },
    "ui.wait_for": {
      "description": "Wait for selector, text, event, or UI state in Farmslot review surfaces.",
      "examples": [
        {
          "action": "ui.wait_for",
          "selector": "recipe-graph",
          "text_contains": ["VALIDATE"],
          "timeout_ms": 10000,
          "next": "capture",
          "intent": "Confirm the requested application state is visible."
        }
      ],
      "schema": {
        "type": "object",
        "properties": {
          "text_contains": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "timeout_ms": {
            "type": "integer"
          },
          "text": {
            "type": "string"
          },
          "target": {
            "type": "string"
          },
          "test_id": {
            "type": "string"
          },
          "visible": {
            "type": "boolean"
          },
          "event": {
            "type": "string"
          },
          "selector": {
            "type": "string"
          },
          "expected": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    "ui.set_input": {
      "description": "Set text through the real UI input path for Farmslot UI fixture surfaces.",
      "schema": {
        "type": "object",
        "properties": {
          "test_id": {
            "type": "string"
          },
          "selector": {
            "type": "string"
          },
          "target": {
            "type": "string"
          },
          "value": {
            "type": "string"
          }
        },
        "required": ["value"],
        "additionalProperties": false
      },
      "examples": [
        {
          "action": "ui.set_input",
          "test_id": "shipping-address",
          "value": "1 Recipe Protocol Way",
          "next": "submit-order",
          "intent": "Provide the requested value in the visible form."
        }
      ]
    },
    "ui.scroll": {
      "description": "Raw scroll movement: offset_x/offset_y set an absolute position, delta_x/delta_y move relative to the current one; the two are never combined. To reveal a proof target use ui.scroll_to.",
      "schema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "selector": {
            "type": "string"
          },
          "scroll_into_view": {
            "type": "boolean"
          },
          "test_id": {
            "type": "string",
            "description": "Scroll container; omit to move the page root."
          },
          "offset_x": {
            "type": "number",
            "description": "Absolute horizontal offset in px."
          },
          "offset_y": {
            "type": "number",
            "description": "Absolute vertical offset in px."
          },
          "delta_x": {
            "type": "number",
            "description": "Relative horizontal movement in px."
          },
          "delta_y": {
            "type": "number",
            "description": "Relative vertical movement in px."
          }
        }
      },
      "examples": [
        {
          "action": "ui.scroll",
          "intent": "Return the list to its top before the next proof step.",
          "test_id": "orders-list",
          "offset_y": 0,
          "next": "done"
        }
      ]
    },
    "ui.scroll_to": {
      "description": "Canonical scroll-to-visible: move one named scroll surface until the semantic proof target (or its measurable visibility anchor) rests inside the HUD-safe viewport, wait for geometry to settle, and verify it. The trace output is the evidence; failures are harness errors with stable SCROLL_* codes. Prove one scroll node with --stop-after-node before composing a larger flow: plan success is schema confidence only, not runtime proof.",
      "schema": {
        "type": "object",
        "additionalProperties": false,
        "required": ["surface_test_id", "target_test_id"],
        "properties": {
          "surface_test_id": {
            "type": "string",
            "description": "Test id of the scroll container whose offset moves."
          },
          "target_test_id": {
            "type": "string",
            "description": "Semantic proof target. It must be present when the node ends."
          },
          "visibility_anchor_test_id": {
            "type": "string",
            "description": "Measurable element used for positioning and the visibility verdict when the target has no measurable box, such as a flattened Text node."
          },
          "align": {
            "type": "string",
            "enum": ["start", "center", "end", "nearest"],
            "default": "nearest",
            "description": "Where the measured element should rest inside the safe viewport."
          },
          "viewport_policy": {
            "type": "string",
            "enum": ["hud_safe", "full"],
            "default": "hud_safe",
            "description": "hud_safe removes HUD and overlay occlusion from the viewport before positioning and verifying; full uses the raw surface viewport."
          },
          "verify_visible": {
            "type": "boolean",
            "default": true,
            "description": "Fail with SCROLL_TARGET_NOT_VISIBLE when the settled element is outside the safe viewport."
          },
          "settle": {
            "type": "object",
            "additionalProperties": false,
            "description": "Geometry settlement after movement: consecutive identical measurements within a budget.",
            "properties": {
              "timeout_ms": {
                "type": "number",
                "minimum": 0,
                "description": "Settlement budget in milliseconds."
              },
              "interval_ms": {
                "type": "number",
                "minimum": 1,
                "description": "Delay between measurements."
              },
              "stable_samples": {
                "type": "integer",
                "minimum": 1,
                "description": "Consecutive unchanged measurements required to call the layout settled."
              }
            }
          }
        }
      },
      "examples": [
        {
          "action": "ui.scroll_to",
          "intent": "The History row is reviewable above the recipe HUD.",
          "surface_test_id": "orders-list",
          "target_test_id": "history-row",
          "align": "center",
          "next": "capture-history"
        },
        {
          "action": "ui.scroll_to",
          "intent": "The validation message is reviewable even though its text node has no box.",
          "surface_test_id": "order-form",
          "target_test_id": "validation-text",
          "visibility_anchor_test_id": "validation-row",
          "settle": {
            "timeout_ms": 1500
          },
          "next": "capture-validation"
        }
      ]
    },
    "app.hud": {
      "description": "Reviewer proof HUD injected into the Command Center browser session during recipe playback and video capture. Automatic running/pass/fail updates come from the harness lifecycle; use explicit app.hud nodes only for extra annotations.",
      "examples": [
        {
          "action": "app.hud",
          "intent": "Show the current goal to the supervising human.",
          "status": "running",
          "next": "wait-for-panel"
        }
      ],
      "schema": {
        "type": "object",
        "properties": {
          "clear": {
            "type": "boolean"
          },
          "status": {
            "type": "string",
            "enum": ["running", "pass", "fail"]
          }
        },
        "additionalProperties": false
      }
    },
    "app.status": {
      "description": "Read the current Command Center browser location and document title via CDP.",
      "schema": {
        "type": "object",
        "properties": {
          "timeout_ms": {
            "type": "integer"
          }
        },
        "additionalProperties": false
      },
      "examples": [
        {
          "action": "app.status",
          "intent": "Record the resolved application state before continuing.",
          "next": "done"
        }
      ]
    },
    "app.lifecycle": {
      "description": "Reload or navigate back in the Command Center browser session during recipe proof.",
      "schema": {
        "type": "object",
        "properties": {
          "mode": {
            "type": "string"
          },
          "wait_for": {
            "type": "string"
          }
        },
        "additionalProperties": false
      },
      "examples": [
        {
          "action": "app.lifecycle",
          "intent": "Converge the application to the requested lifecycle state.",
          "next": "done"
        }
      ]
    },
    "command": {
      "description": "command action.",
      "schema": {
        "type": "object",
        "properties": {
          "cmd": {
            "type": "string"
          },
          "timeout_ms": {
            "type": "integer"
          },
          "cwd": {
            "type": "string"
          },
          "allow_failure": {
            "type": "boolean"
          }
        },
        "required": ["cmd"],
        "additionalProperties": false
      },
      "examples": [
        {
          "action": "command",
          "intent": "Prepare the project state needed for this proof.",
          "cmd": "true",
          "next": "done"
        }
      ]
    },
    "assert_json": {
      "description": "assert_json action.",
      "schema": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string"
          },
          "assert": {
            "type": "object",
            "additionalProperties": true
          }
        },
        "required": ["path", "assert"],
        "additionalProperties": false
      },
      "examples": [
        {
          "action": "assert_json",
          "intent": "Confirm the recorded data satisfies the requested condition.",
          "path": "artifacts/example.json",
          "assert": {
            "path": "$.status",
            "operator": "eq",
            "value": "ready"
          },
          "next": "done"
        }
      ]
    },
    "assert_output": {
      "description": "assert_output action.",
      "schema": {
        "type": "object",
        "properties": {
          "source": {
            "type": "string"
          },
          "stream": {
            "type": "string"
          },
          "contains": {
            "type": "string"
          },
          "match": {
            "type": "string"
          },
          "assert": {
            "type": "object",
            "additionalProperties": true
          }
        },
        "required": ["source"],
        "additionalProperties": false
      },
      "examples": [
        {
          "action": "assert_output",
          "intent": "Confirm the recorded output satisfies the requested condition.",
          "source": "command",
          "contains": "ready",
          "next": "done"
        }
      ]
    },
    "state_read": {
      "description": "state_read action.",
      "schema": {
        "type": "object",
        "properties": {
          "source": {
            "type": "string"
          },
          "path": {
            "type": "string"
          }
        },
        "required": ["source"],
        "additionalProperties": false
      },
      "examples": [
        {
          "action": "state_read",
          "intent": "Record the requested application state for proof.",
          "source": "command",
          "path": "$.stdout",
          "next": "done"
        }
      ]
    },
    "watch_logs": {
      "description": "watch_logs action.",
      "schema": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string"
          },
          "contains": {
            "type": "string"
          },
          "scope": {
            "type": "string",
            "enum": ["run", "file"]
          }
        },
        "required": ["path"],
        "additionalProperties": false
      },
      "examples": [
        {
          "action": "watch_logs",
          "intent": "Observe the runtime behavior needed for this proof.",
          "path": "logs/example.log",
          "contains": "ready",
          "scope": "file",
          "next": "done"
        }
      ]
    },
    "index_artifacts": {
      "description": "index_artifacts action.",
      "schema": {
        "type": "object",
        "properties": {
          "artifacts": {
            "type": "array",
            "items": {
              "type": ["object", "string"],
              "properties": {
                "path": {
                  "type": "string"
                },
                "type": {
                  "type": "string"
                },
                "label": {
                  "type": "string"
                },
                "nodeId": {
                  "type": "string"
                },
                "mimeType": {
                  "type": "string"
                },
                "category": {
                  "type": "string"
                },
                "proofTarget": {
                  "type": "string"
                },
                "covers": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              },
              "additionalProperties": false
            }
          }
        },
        "required": ["artifacts"],
        "additionalProperties": false
      },
      "examples": [
        {
          "action": "index_artifacts",
          "intent": "Preserve generated evidence in the review package.",
          "artifacts": ["reports/example.json"],
          "next": "done"
        }
      ]
    },
    "ui.press": {
      "description": "ui.press action.",
      "schema": {
        "type": "object",
        "properties": {
          "test_id": {
            "type": "string"
          },
          "text": {
            "type": "string"
          },
          "selector": {
            "type": "string"
          }
        },
        "additionalProperties": false
      },
      "examples": [
        {
          "action": "ui.press",
          "intent": "Activate the requested visible control.",
          "test_id": "example-control",
          "next": "done"
        }
      ]
    },
    "ui.screenshot": {
      "description": "ui.screenshot action.",
      "schema": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string"
          },
          "label": {
            "type": "string"
          },
          "claims": {
            "type": "object",
            "properties": {
              "must_show": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "must_not_show": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            },
            "additionalProperties": false
          },
          "covers": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "note": {
            "type": "string"
          }
        },
        "additionalProperties": false
      },
      "examples": [
        {
          "action": "ui.screenshot",
          "intent": "Preserve the visible application state as review evidence.",
          "label": "example-state",
          "next": "done"
        }
      ]
    },
    "ui.capture_surface": {
      "description": "Capture the complete current web page as one PNG while keeping ui.screenshot viewport-only.",
      "schema": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string"
          },
          "label": {
            "type": "string"
          },
          "category": {
            "type": "string"
          }
        },
        "additionalProperties": false
      },
      "examples": [
        {
          "action": "ui.capture_surface",
          "intent": "Preserve the complete application page as review evidence.",
          "label": "full-application-page",
          "next": "done"
        }
      ]
    },
    "cdp.target": {
      "description": "cdp.target action.",
      "schema": {
        "type": "object",
        "properties": {
          "role": {
            "type": "string"
          }
        },
        "additionalProperties": false
      },
      "examples": [
        {
          "action": "cdp.target",
          "intent": "Confirm the requested application target is available.",
          "role": "extension",
          "next": "done"
        }
      ]
    }
  },
  "observers": [
    {
      "ref": "ui.screen",
      "default_for": ["ui.navigate", "ui.press", "ui.set_input", "ui.wait_for"]
    },
    {
      "ref": "ui.visible",
      "default_for": ["ui.navigate", "ui.press", "ui.set_input", "ui.wait_for"]
    }
  ]
}
