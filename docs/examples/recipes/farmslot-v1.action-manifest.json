{
  "runner_protocol_version": 1,
  "action_registry_version": 1,
  "supported_official_actions": [
    "command",
    "assert_json",
    "assert_output",
    "state_read",
    "watch_logs",
    "index_artifacts",
    "ui.navigate",
    "ui.press",
    "ui.set_input",
    "ui.scroll",
    "ui.wait_for",
    "ui.screenshot",
    "app.status",
    "app.lifecycle",
    "app.hud",
    "cdp.target",
    "end"
  ],
  "action_metadata": {
    "ui.navigate": {
      "description": "Navigate Command Center, Mobile Companion, or browser surfaces by route/hash/URL.",
      "examples": [
        {
          "node": {
            "action": "ui.navigate",
            "target": "#slot/{{slot_id}}?reviewDrawer=recipe",
            "next": "wait-for-panel",
            "intent": "Navigate Command Center, Mobile Companion, or browser surfaces by route/hash/URL"
          }
        }
      ],
      "schema": {
        "type": "object",
        "properties": {
          "target": {
            "type": "string"
          },
          "params": {
            "type": "object",
            "properties": {
              "market": {
                "type": "string"
              }
            },
            "additionalProperties": false
          }
        },
        "additionalProperties": false
      }
    },
    "ui.wait_for": {
      "description": "Wait for selector, text, event, or UI state in Farmslot review surfaces.",
      "examples": [
        {
          "node": {
            "action": "ui.wait_for",
            "selector": "recipe-graph",
            "text_contains": ["VALIDATE"],
            "timeout_ms": 10000,
            "next": "capture",
            "intent": "Wait for selector, text, event, or UI state in Farmslot review surfaces"
          }
        }
      ],
      "schema": {
        "type": "object",
        "properties": {
          "text_contains": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "timeout_ms": {
            "type": "integer"
          },
          "text": {
            "type": "string"
          },
          "target": {
            "type": "string"
          },
          "test_id": {
            "type": "string"
          },
          "visible": {
            "type": "boolean"
          },
          "event": {
            "type": "string"
          },
          "selector": {
            "type": "string"
          },
          "expected": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    "ui.set_input": {
      "description": "Set text through the real UI input path for Farmslot UI fixture surfaces.",
      "schema": {
        "type": "object",
        "properties": {
          "test_id": {
            "type": "string"
          },
          "selector": {
            "type": "string"
          },
          "target": {
            "type": "string"
          },
          "value": {
            "type": "string"
          }
        },
        "required": ["value"],
        "additionalProperties": false
      },
      "examples": [
        {
          "description": "Fill a test-id backed field in a UI fixture.",
          "node": {
            "action": "ui.set_input",
            "test_id": "shipping-address",
            "value": "1 Recipe Protocol Way",
            "next": "submit-order",
            "intent": "Fill a test-id backed field in a UI fixture"
          }
        }
      ]
    },
    "ui.scroll": {
      "description": "Scroll the assigned browser, simulator, or device and wait for UI stability.",
      "schema": {
        "type": "object",
        "additionalProperties": false
      }
    },
    "app.hud": {
      "description": "Reviewer proof HUD injected into the Command Center browser session during recipe playback and video capture. Automatic running/pass/fail updates come from the harness lifecycle; use explicit app.hud nodes only for extra annotations.",
      "examples": [
        {
          "node": {
            "action": "app.hud",
            "intent": "Open the slot shell and verify the recipe drawer is visible",
            "status": "running",
            "next": "wait-for-panel"
          }
        }
      ],
      "schema": {
        "type": "object",
        "properties": {
          "clear": {
            "type": "boolean"
          },
          "status": {
            "type": "string",
            "enum": ["running", "pass", "fail"]
          }
        },
        "additionalProperties": false
      }
    },
    "app.status": {
      "description": "Read the current Command Center browser location and document title via CDP.",
      "schema": {
        "type": "object",
        "properties": {
          "timeout_ms": {
            "type": "integer"
          }
        },
        "additionalProperties": false
      }
    },
    "app.lifecycle": {
      "description": "Reload or navigate back in the Command Center browser session during recipe proof.",
      "schema": {
        "type": "object",
        "properties": {
          "mode": {
            "type": "string"
          },
          "wait_for": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    "command": {
      "description": "command action.",
      "schema": {
        "type": "object",
        "properties": {
          "description": {
            "type": "string"
          },
          "cmd": {
            "type": "string"
          },
          "timeout_ms": {
            "type": "integer"
          },
          "cwd": {
            "type": "string"
          },
          "save_as": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    "assert_json": {
      "description": "assert_json action.",
      "schema": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string"
          },
          "assert": {
            "type": "object",
            "properties": {
              "operator": {
                "type": "string"
              },
              "value": {
                "type": "integer"
              },
              "path": {
                "type": "string"
              }
            },
            "additionalProperties": false
          }
        },
        "additionalProperties": false
      }
    },
    "assert_output": {
      "description": "assert_output action.",
      "schema": {
        "type": "object",
        "properties": {
          "description": {
            "type": "string"
          },
          "source": {
            "type": "string"
          },
          "stream": {
            "type": "string"
          },
          "contains": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    "state_read": {
      "description": "state_read action.",
      "schema": {
        "type": "object",
        "properties": {
          "save_as": {
            "type": "string"
          },
          "assert": {
            "type": "object",
            "properties": {
              "path": {
                "type": "string"
              },
              "operator": {
                "type": "string"
              },
              "value": {
                "type": "string"
              }
            },
            "additionalProperties": false
          }
        },
        "additionalProperties": false
      }
    },
    "watch_logs": {
      "description": "watch_logs action.",
      "schema": {
        "type": "object",
        "additionalProperties": false
      }
    },
    "index_artifacts": {
      "description": "index_artifacts action.",
      "schema": {
        "type": "object",
        "properties": {
          "artifacts": {
            "type": "array",
            "items": {
              "type": ["object", "string"],
              "properties": {
                "path": {
                  "type": "string"
                },
                "type": {
                  "type": "string"
                },
                "label": {
                  "type": "string"
                }
              },
              "additionalProperties": false
            }
          }
        },
        "additionalProperties": false
      }
    },
    "ui.press": {
      "description": "ui.press action.",
      "schema": {
        "type": "object",
        "properties": {
          "test_id": {
            "type": "string"
          },
          "text": {
            "type": "string"
          },
          "selector": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    "ui.screenshot": {
      "description": "ui.screenshot action.",
      "schema": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string"
          },
          "label": {
            "type": "string"
          },
          "claims": {
            "type": "object",
            "properties": {
              "must_show": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "must_not_show": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            },
            "additionalProperties": false
          },
          "covers": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "note": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    "cdp.target": {
      "description": "cdp.target action.",
      "schema": {
        "type": "object",
        "properties": {
          "role": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    }
  },
  "observers": [
    {
      "ref": "ui.screen",
      "description": "Current screen, route, title, or URL digest recorded after supported UI actions.",
      "default_for": ["ui.navigate", "ui.press", "ui.set_input", "ui.wait_for"],
      "cost": "cheap",
      "redaction": "none"
    },
    {
      "ref": "ui.visible",
      "description": "Bounded list of visible actionable UI targets for authoring the next recipe node.",
      "default_for": ["ui.navigate", "ui.press", "ui.set_input", "ui.wait_for"],
      "cost": "cheap",
      "redaction": "labels-only"
    }
  ],
  "native_bindings": [
    {
      "action": "command",
      "implementation": "farmslot/local-command-runner"
    },
    {
      "action": "ui.navigate",
      "implementation": "farmslot/apps/command-center/cdp-navigate"
    },
    {
      "action": "ui.wait_for",
      "implementation": "farmslot/apps/command-center/ui-wait"
    },
    {
      "action": "ui.set_input",
      "implementation": "farmslot/apps/command-center/ui-set-input"
    }
  ]
}
