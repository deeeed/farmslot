{
  "$schema": "https://farmslot.io/schemas/recipe-v1.schema.json",
  "title": "Example Mobile App Perps market proof",
  "description": "Example v1 Mobile recipe using official ui/app actions plus Example App custom wallet actions.",
  "paramsSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "market": {
        "type": "string",
        "default": "ETH"
      }
    }
  },
  "proofTargets": [
    {
      "id": "AC-1",
      "claim": "Capture the visible {{params.market}} Perps market row for review"
    }
  ],
  "workflow": {
    "entry": "setup-1",
    "nodes": {
      "unlock-wallet": {
        "action": "example.wallet.unlock",
        "account": "primary",
        "next": "open-perps",
        "intent": "Unlock the primary wallet account before opening Perps"
      },
      "open-perps": {
        "action": "ui.navigate",
        "target": "PerpsMarkets",
        "params": {
          "market": "{{params.market}}"
        },
        "next": "wait-market",
        "intent": "Open the Perps markets screen for {{params.market}}"
      },
      "wait-market": {
        "action": "ui.wait_for",
        "test_id": "perps-market-row-{{params.market}}",
        "visible": true,
        "timeout_ms": 10000,
        "next": "capture-proof",
        "intent": "Confirm the {{params.market}} Perps market row is visible"
      },
      "capture-proof": {
        "action": "ui.screenshot",
        "path": "screenshots/mobile-perps-market.png",
        "claims": {
          "must_show": ["{{params.market}}", "Perps"],
          "must_not_show": ["Error"]
        },
        "covers": ["perps-market-visible"],
        "next": "done",
        "intent": "Record the visible {{params.market}} Perps market row for review",
        "proves": ["AC-1"]
      },
      "done": {
        "action": "end",
        "status": "pass"
      },
      "setup-1": {
        "action": "app.hud",
        "intent": "Prepare the wallet and open the Perps market proof",
        "next": "unlock-wallet"
      },
      "teardown-done": {
        "action": "end",
        "status": "pass"
      },
      "teardown-1": {
        "action": "app.hud",
        "clear": true,
        "intent": "Clear the reviewer HUD after the Perps proof run",
        "next": "teardown-done"
      }
    },
    "teardown": "teardown-1"
  }
}
