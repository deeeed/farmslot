{
  "$schema": "https://farmslot.io/schemas/action-manifest-v1.schema.json",
  "actions": {
    "call": {
      "description": "Invoke a named child recipe with explicit parameters.",
      "examples": [
        {
          "action": "call",
          "intent": "Reuse a shared mobile setup recipe.",
          "ref": "mobile.setup",
          "params": {},
          "next": "done"
        }
      ]
    },
    "end": {
      "description": "Finish recipe execution with an explicit status.",
      "examples": [
        {
          "action": "end",
          "status": "pass"
        }
      ]
    },
    "ui.navigate": {
      "description": "Navigate by React Native route name through the injected app control bridge.",
      "schema": {
        "type": "object",
        "properties": {
          "target": {
            "type": "string"
          },
          "params": {
            "type": "object"
          }
        },
        "required": ["target"],
        "additionalProperties": false
      },
      "examples": [
        {
          "action": "ui.navigate",
          "target": "PerpsMarkets",
          "next": "wait-for-markets",
          "intent": "Open the requested application surface."
        }
      ]
    },
    "ui.wait_for": {
      "description": "Wait for text, test_id, route, or visibility from the Mobile app control bridge.",
      "schema": {
        "type": "object",
        "properties": {
          "test_id": {
            "type": "string"
          },
          "text": {
            "type": "string"
          },
          "text_contains": {
            "type": ["string", "array"],
            "items": {
              "type": "string"
            }
          },
          "visible": {
            "type": "boolean"
          },
          "timeout_ms": {
            "type": "number"
          },
          "target": {
            "type": "string"
          },
          "event": {
            "type": "string"
          },
          "selector": {
            "type": "string"
          },
          "expected": {
            "type": "string"
          }
        },
        "additionalProperties": false
      },
      "examples": [
        {
          "action": "ui.wait_for",
          "test_id": "perps-market-row-ETH",
          "visible": true,
          "timeout_ms": 10000,
          "next": "capture-proof",
          "intent": "Confirm the requested application state is visible."
        }
      ]
    },
    "ui.screenshot": {
      "description": "Capture a simulator screenshot and attach reviewer claims.",
      "examples": [
        {
          "action": "ui.screenshot",
          "path": "screenshots/perps-market.png",
          "claims": {
            "must_show": ["ETH", "Perps"],
            "must_not_show": ["Error"]
          },
          "next": "index-artifacts",
          "intent": "Preserve the visible application state as review evidence."
        }
      ],
      "schema": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string"
          },
          "label": {
            "type": "string"
          },
          "claims": {
            "type": "object",
            "properties": {
              "must_show": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "must_not_show": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            },
            "additionalProperties": false
          },
          "covers": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "note": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    "app.lifecycle": {
      "description": "Control the React Native app runtime through launch, terminate, background, foreground, reload, reset, or restart.",
      "examples": [
        {
          "action": "app.lifecycle",
          "mode": "restart",
          "wait_for": "example.mobile.bridge_ready",
          "next": "unlock-wallet",
          "intent": "Converge the application to the requested lifecycle state."
        }
      ],
      "schema": {
        "type": "object",
        "properties": {
          "mode": {
            "type": "string"
          },
          "wait_for": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    "app.hud": {
      "description": "Show an optional reviewer HUD annotation; normal step progress comes from node intent.",
      "examples": [
        {
          "action": "app.hud",
          "next": "open-perps",
          "intent": "Show the current goal to the supervising human."
        }
      ],
      "schema": {
        "type": "object",
        "properties": {
          "clear": {
            "type": "boolean"
          }
        },
        "additionalProperties": false
      }
    },
    "ui.set_input": {
      "description": "Set text through the real UI input path.",
      "examples": [
        {
          "action": "ui.set_input",
          "test_id": "network-selector-network-search-input",
          "value": "Sepolia",
          "intent": "Provide the requested value in the visible form.",
          "next": "done"
        }
      ],
      "schema": {
        "type": "object",
        "properties": {
          "test_id": {
            "type": "string"
          },
          "value": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    "ui.press": {
      "description": "ui.press action.",
      "schema": {
        "type": "object",
        "properties": {
          "test_id": {
            "type": "string"
          },
          "text": {
            "type": "string"
          },
          "selector": {
            "type": "string"
          }
        },
        "additionalProperties": false
      },
      "examples": [
        {
          "action": "ui.press",
          "intent": "Activate the requested visible control.",
          "test_id": "example-control",
          "next": "done"
        }
      ]
    },
    "ui.key_press": {
      "description": "ui.key_press action.",
      "schema": {
        "type": "object",
        "additionalProperties": false
      },
      "examples": [
        {
          "action": "ui.key_press",
          "intent": "Continue the requested keyboard interaction.",
          "next": "done"
        }
      ]
    },
    "ui.scroll": {
      "description": "ui.scroll action.",
      "schema": {
        "type": "object",
        "additionalProperties": false
      },
      "examples": [
        {
          "action": "ui.scroll",
          "intent": "Expose the requested content for visible review.",
          "next": "done"
        }
      ]
    },
    "ui.gesture": {
      "description": "ui.gesture action.",
      "schema": {
        "type": "object",
        "additionalProperties": false
      },
      "examples": [
        {
          "action": "ui.gesture",
          "intent": "Complete the requested touch interaction.",
          "next": "done"
        }
      ]
    },
    "app.trace": {
      "description": "app.trace action.",
      "schema": {
        "type": "object",
        "additionalProperties": false
      },
      "examples": [
        {
          "action": "app.trace",
          "intent": "Record the requested runtime timeline evidence.",
          "next": "done"
        }
      ]
    },
    "state_read": {
      "description": "state_read action.",
      "schema": {
        "type": "object",
        "properties": {
          "source": {
            "type": "string"
          },
          "path": {
            "type": "string"
          }
        },
        "required": ["source"],
        "additionalProperties": false
      },
      "examples": [
        {
          "action": "state_read",
          "intent": "Record the requested application state for proof.",
          "source": "command",
          "path": "$.stdout",
          "next": "done"
        }
      ]
    },
    "watch_logs": {
      "description": "watch_logs action.",
      "schema": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string"
          },
          "contains": {
            "type": "string"
          },
          "scope": {
            "type": "string",
            "enum": ["run", "file"]
          }
        },
        "required": ["path"],
        "additionalProperties": false
      },
      "examples": [
        {
          "action": "watch_logs",
          "intent": "Observe the runtime behavior needed for this proof.",
          "path": "logs/example.log",
          "contains": "ready",
          "scope": "file",
          "next": "done"
        }
      ]
    },
    "index_artifacts": {
      "description": "index_artifacts action.",
      "schema": {
        "type": "object",
        "properties": {
          "artifacts": {
            "type": "array",
            "items": {
              "type": ["object", "string"],
              "properties": {
                "path": {
                  "type": "string"
                },
                "type": {
                  "type": "string"
                },
                "label": {
                  "type": "string"
                },
                "nodeId": {
                  "type": "string"
                },
                "mimeType": {
                  "type": "string"
                },
                "category": {
                  "type": "string"
                },
                "proofTarget": {
                  "type": "string"
                },
                "covers": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              },
              "additionalProperties": false
            }
          }
        },
        "required": ["artifacts"],
        "additionalProperties": false
      },
      "examples": [
        {
          "action": "index_artifacts",
          "intent": "Preserve generated evidence in the review package.",
          "artifacts": ["reports/example.json"],
          "next": "done"
        }
      ]
    },
    "switch": {
      "description": "Choose a graph branch when one resolved string equals another.",
      "schema": {
        "type": "object",
        "properties": {
          "value": {
            "type": "string"
          },
          "equals": {
            "type": "string"
          }
        },
        "required": ["value", "equals"],
        "additionalProperties": false
      },
      "result_cases": ["match"],
      "examples": [
        {
          "action": "switch",
          "intent": "Choose the graph path matching the observed state.",
          "value": "example",
          "equals": "example",
          "next": "done"
        }
      ]
    },
    "example.wallet.setup": {
      "description": "Seed/import a declared throwaway Example App wallet fixture.",
      "schema": {
        "type": "object",
        "properties": {
          "fixture": {
            "type": "string"
          }
        },
        "required": ["fixture"],
        "additionalProperties": false
      },
      "examples": [
        {
          "action": "example.wallet.setup",
          "intent": "Prepare the declared Example App wallet fixture.",
          "fixture": "primary-dev-wallet",
          "next": "unlock-wallet"
        }
      ],
      "execution_capabilities": ["app-mutation"]
    },
    "example.wallet.unlock": {
      "description": "Unlock a debug Example App wallet through the real unlock path.",
      "schema": {
        "type": "object",
        "properties": {
          "account": {
            "type": "string"
          }
        },
        "required": ["account"],
        "additionalProperties": false
      },
      "examples": [
        {
          "action": "example.wallet.unlock",
          "intent": "Ensure the primary Example App wallet is unlocked.",
          "account": "primary",
          "next": "open-perps"
        }
      ],
      "execution_capabilities": ["app-mutation"]
    },
    "example.trade.enter_amount_keypad": {
      "description": "Enter a Perps amount through the product keypad journey when raw text input would bypass product behavior.",
      "schema": {
        "type": "object",
        "properties": {
          "value": {
            "type": "string"
          },
          "field": {
            "type": "string"
          }
        },
        "required": ["value"],
        "additionalProperties": false
      },
      "examples": [
        {
          "action": "example.trade.enter_amount_keypad",
          "intent": "Enter the order amount through the visible product keypad.",
          "value": "10",
          "next": "review-order"
        }
      ],
      "execution_capabilities": ["app-mutation"]
    },
    "example.debug.eval": {
      "description": "Debug-only eval escape hatch for setup diagnostics, not primary proof.",
      "schema": {
        "type": "object",
        "properties": {
          "target": {
            "type": "string"
          },
          "expression": {
            "type": "string"
          },
          "save_as": {
            "type": "string"
          }
        },
        "required": ["expression"],
        "additionalProperties": false
      },
      "examples": [
        {
          "action": "example.debug.eval",
          "intent": "Inspect the active chain while diagnosing setup.",
          "expression": "Engine.context.NetworkController.state.providerConfig.chainId",
          "save_as": "chain_id",
          "next": "assert-chain"
        }
      ],
      "execution_capabilities": ["arbitrary-code"]
    }
  }
}
