{
  "name": "@farmslot/command-center",
  "version": "0.2.0",
  "private": true,
  "scripts": {
    "dev": "concurrently \"yarn workspace @farmslot/gateway dev\" \"yarn --cwd ui dev\"",
    "farmdev": "bash ../../scripts/dev.sh",
    "dev:gateway": "yarn workspace @farmslot/gateway dev",
    "dev:ui": "yarn --cwd ui dev",
    "dev:node": "yarn workspace @farmslot/node dev",
    "farmslot": "tsx ../../packages/cli/src/entry.ts",
    "build:ui": "yarn --cwd ui build",
    "typecheck": "yarn check:auto-recovery-authority && yarn typecheck:protocol && yarn typecheck:harness && yarn typecheck:gateway && yarn typecheck:node && yarn typecheck:ui && yarn typecheck:cli",
    "check:auto-recovery-authority": "bash scripts/check-auto-recovery-authority.sh",
    "typecheck:protocol": "tsc --noEmit -p ../../packages/protocol/tsconfig.json",
    "typecheck:harness": "tsc --noEmit -p ../../packages/recipe-harness/tsconfig.json",
    "typecheck:gateway": "yarn workspace @farmslot/gateway typecheck",
    "typecheck:node": "yarn workspace @farmslot/node typecheck",
    "typecheck:ui": "tsc --noEmit -p ui/tsconfig.json",
    "typecheck:cli": "tsc --noEmit -p ../../packages/cli/tsconfig.json",
    "lint:slot-view": "eslint \"ui/src/components/slot-view/**/*.ts\"",
    "lint:slot-view:fix": "eslint \"ui/src/components/slot-view/**/*.ts\" --fix",
    "format:extracted": "yarn format",
    "format:extracted:check": "yarn format:check",
    "quality:slot-view": "yarn lint:quality && yarn format:extracted:check && yarn test:ui && yarn typecheck",
    "test:protocol": "yarn workspace @farmslot/protocol test",
    "test:recipe-harness": "yarn workspace @farmslot/recipe-harness test",
    "test:gateway-root": "node ../../scripts/quality/run-tsx-tests.mjs --cwd ../../services/gateway --tsconfig tsconfig.json src/projects/repo-root.test.ts",
    "test:slot-view": "yarn test:ui",
    "lint:quality": "yarn lint",
    "format": "cd ../.. && yarn --cwd apps/command-center exec prettier --write --ignore-unknown .",
    "format:check": "cd ../.. && yarn --cwd apps/command-center exec prettier --check --ignore-unknown .",
    "lint": "cd ../.. && node scripts/quality/check-eslint-ratchet.mjs --strict-stale",
    "lint:fix": "cd ../.. && node scripts/quality/check-eslint-ratchet.mjs --fix --strict-stale",
    "lint:type-escapes": "node scripts/check-type-escape-ratchet.mjs --strict-stale",
    "quality": "yarn format:check && yarn lint && yarn lint:type-escapes && yarn test:protocol && yarn test:recipe-harness && yarn test:gateway-root && yarn test:ui && yarn typecheck",
    "hooks:install": "node scripts/install-git-hooks.mjs",
    "precommit:quality": "cd ../.. && node scripts/quality/precommit-quality.mjs",
    "prepush:quality": "cd ../.. && node scripts/quality/prepush-quality.mjs",
    "test:recipe-operational-gates": "node scripts/test-recipe-operational-gates.mjs",
    "test:ui": "node ../../scripts/quality/run-tsx-tests.mjs --cwd . --tsconfig ui/tsconfig.json ui/src"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "concurrently": "^9.0.0",
    "eslint": "^10.3.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-simple-import-sort": "^13.0.0",
    "globals": "^17.6.0",
    "prettier": "^3.8.3",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.59.3"
  },
  "packageManager": "yarn@4.5.3+sha512.3003a14012e2987072d244c720506549c1aab73ee728208f1b2580a9fd67b92d61ba6b08fe93f6dce68fd771e3af1e59a0afa28dd242dd0940d73b95fedd4e90",
  "license": "MIT"
}
