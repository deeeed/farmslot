# Command Center UI env. Copy to .env.local for local private values.

# Browser UI -> gateway. Usually blank in local dev because Vite proxies /ws.
# VITE_FARMSLOT_GATEWAY_URL=ws://localhost:7777/ws

# Companion on same Wi-Fi -> gateway. This must be reachable from the phone.
# Example: ws://macwork.local:7777/ws or ws://192.168.50.10:7777/ws
VITE_FARMSLOT_PAIRING_GATEWAY_URL=

# Optional public gateway reachable from the internet.
# Example: wss://farmslot.example.com/ws
VITE_FARMSLOT_REMOTE_GATEWAY_URL=

# Optional browser auth defaults. Prefer local untracked files for secrets.
# VITE_FARMSLOT_GATEWAY_TOKEN=
# VITE_FARMSLOT_GATEWAY_PASSWORD=
