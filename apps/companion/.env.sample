# Farmslot Mobile Companion - Environment Variables
#
# Copy this file to .env.development, .env.preview, or .env.production and fill
# in the values for that variant.
#
# APP_VARIANT: development | preview | production
APP_VARIANT=development

# First-party Siteed app identity. Production uses SITEED_BUNDLE_BASE;
# non-production appends .development / .preview so all variants install side by side.
SITEED_BUNDLE_BASE=net.siteed.farmslot
SITEED_SCHEME_BASE=farmslot

# Expo/EAS project ID used for EAS Update and EAS Build metadata.
EAS_PROJECT_ID=5673e87d-de68-4685-9d17-03533e7d63de

# Optional local/default gateway WebSocket URL. Leave blank for distributable
# builds so first-run users pair from Command Center by scanning a QR code.
# Put personal defaults in .env.local or .env.<variant>.local, not here.
EXPO_PUBLIC_GATEWAY_URL=

# Optional display/config value for a remote gateway. This does not create a
# default profile unless EXPO_PUBLIC_GATEWAY_URL is also set locally.
FARMSLOT_REMOTE_GATEWAY_URL=

# Optional pre-staged Sherpa ASR model. If MODEL_ID is omitted, Companion tries
# to infer it from MODEL_DIR path segments such as qwen3-asr-0.6B-int8-2026-03-25.
EXPO_PUBLIC_SHERPA_ASR_MODEL_DIR=
EXPO_PUBLIC_SHERPA_ASR_MODEL_ID=

# Optional dev-only token preset. Prefer sourcing ../.env.local-auth locally instead
# of committing a value here.
FARMSLOT_REMOTE_GATEWAY_TOKEN=
