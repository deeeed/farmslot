{
  "name": "@farmslot/mobile",
  "version": "0.10.0",
  "author": "Arthur Breton",
  "homepage": "https://siteed.net/projects/farmslot-farm",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "bash scripts/agentic/start.sh",
    "ios": "bash scripts/agentic/run-ios.sh",
    "ios:device": "IOS_DEVICE_PICK=1 DEVICE_MODE=device bash scripts/agentic/run-ios.sh",
    "android": "bash scripts/agentic/run-android.sh",
    "android:device": "ANDROID_DEVICE_PICK=1 bash scripts/agentic/run-android.sh",
    "launch": "bash scripts/agentic/launch.sh",
    "prebuild": "bash -c 'source scripts/agentic/agentic.conf && exec expo prebuild'",
    "lint": "eslint src/",
    "typecheck": "tsc --noEmit",
    "test:lib": "METRO_PORT=41234 node ../../scripts/quality/run-tsx-tests.mjs --cwd . --tsconfig tsconfig.json src && node --test scripts/agentic/*.test.mjs && node --test scripts/screenshots/build-recipe-ux-catalog.test.mjs && bash scripts/agentic/port-config.test.sh && GATEWAY_PORT=41235 METRO_PORT=41234 bash scripts/agentic/identity.test.sh && node --test scripts/release/*.test.mjs",
    "doctor:ios": "bash scripts/doctor/ios-build.sh --verbose",
    "ios:expo-go": "bash -c 'source scripts/agentic/agentic.conf && exec expo start --ios --go --port \"$METRO_PORT\" --localhost'",
    "ios:native": "bash scripts/agentic/run-ios.sh",
    "eas:project": "yarn dlx eas-cli@18.13.0 project:info",
    "build:ios:development": "bash -c 'source scripts/agentic/agentic.conf && exec env APP_VARIANT=development NODE_ENV=development yarn dlx eas-cli@18.13.0 build --platform ios --profile development --local'",
    "build:ios:preview": "APP_VARIANT=preview yarn dlx eas-cli@18.13.0 build --platform ios --profile preview",
    "build:ios:production": "APP_VARIANT=production NODE_ENV=production yarn dlx eas-cli@18.13.0 build --platform ios --profile production",
    "build:android:development": "bash -c 'source scripts/agentic/agentic.conf && exec env APP_VARIANT=development NODE_ENV=development yarn dlx eas-cli@18.13.0 build --platform android --profile development --local'",
    "build:android:preview": "APP_VARIANT=preview yarn dlx eas-cli@18.13.0 build --platform android --profile preview",
    "build:android:preview-apk": "APP_VARIANT=preview yarn dlx eas-cli@18.13.0 build --platform android --profile preview_apk",
    "build:android:production": "APP_VARIANT=production NODE_ENV=production yarn dlx eas-cli@18.13.0 build --platform android --profile production",
    "build:android:production-apk": "APP_VARIANT=production NODE_ENV=production yarn dlx eas-cli@18.13.0 build --platform android --profile production_apk",
    "update:development": "bash -c 'source scripts/agentic/agentic.conf && exec env APP_VARIANT=development yarn dlx eas-cli@18.13.0 update --channel development --environment development'",
    "update:preview": "APP_VARIANT=preview yarn dlx eas-cli@18.13.0 update --channel preview --environment preview",
    "update:production": "APP_VARIANT=production NODE_ENV=production yarn dlx eas-cli@18.13.0 update --channel production --environment production",
    "release:dry-run": "bash scripts/release/release.sh",
    "release:preview": "bash scripts/release/release.sh --variant preview",
    "release:production": "bash scripts/release/release.sh --variant production",
    "submit:preview": "bash scripts/release/release.sh --variant preview --skip-update --skip-build --submit",
    "submit:production": "bash scripts/release/release.sh --variant production --skip-update --skip-build --submit",
    "eas-build-pre-install": "bash scripts/eas-build-pre-install.sh",
    "recipe": "bash scripts/agentic/run-recipe.sh",
    "recipe:manifest": "bash scripts/agentic/run-recipe.sh manifest",
    "recipe:doctor": "bash scripts/agentic/run-recipe.sh doctor",
    "recipe:validate": "bash scripts/agentic/run-recipe.sh validate",
    "recipe:dry-run": "bash scripts/agentic/run-recipe.sh run --dry-run",
    "recipe:run": "bash scripts/agentic/run-recipe.sh run",
    "recipe:run:bridge": "bash scripts/agentic/run-recipe.sh run scripts/agentic/recipe/recipes/bridge-status.recipe.json",
    "recipe:run:before-after": "bash scripts/agentic/run-recipe.sh run scripts/agentic/recipe/recipes/before-after-comparison.recipe.json",
    "recipe:run:copilot-terminal": "bash scripts/agentic/run-recipe.sh run scripts/agentic/recipe/recipes/copilot-terminal.recipe.json",
    "recipe:run:continuous-gestures": "bash scripts/agentic/run-recipe.sh run scripts/agentic/recipe/recipes/continuous-gestures.recipe.json",
    "recipe:run:native-input-actions": "bash scripts/agentic/run-recipe.sh run scripts/agentic/recipe/recipes/native-input-actions.recipe.json",
    "recipe:run:ux-baseline:ios": "PLATFORM=ios bash scripts/agentic/run-recipe.sh run scripts/agentic/recipe/recipes/ux-catalog.recipe.json --param platform=ios",
    "recipe:run:ux-baseline:android": "PLATFORM=android bash scripts/agentic/run-recipe.sh run scripts/agentic/recipe/recipes/ux-catalog.recipe.json --param platform=android",
    "recipe:run:ux-ready-gate": "bash scripts/agentic/run-slot-ux-catalog.sh",
    "test:identity": "GATEWAY_PORT=41235 METRO_PORT=41234 bash scripts/agentic/identity.test.sh",
    "quality": "yarn typecheck && yarn test:lib && yarn quality:structure:ci",
    "quality:structure": "node ../../scripts/quality/check-companion-structure.mjs",
    "quality:structure:ci": "node ../../scripts/quality/check-companion-structure.mjs --strict --scope all",
    "recipe:run:ux-review-flow:android": "PLATFORM=android bash scripts/agentic/run-recipe.sh run scripts/agentic/recipe/recipes/ux-review-flow-android.recipe.json",
    "recipe:run:jank:android": "PLATFORM=android bash scripts/agentic/run-recipe.sh run scripts/agentic/recipe/recipes/jank.recipe.json --record-video=off \"--recording-reason=screen recording competes with the app for the frames being measured\""
  },
  "dependencies": {
    "@babel/runtime": "^7.29.2",
    "@expo/log-box": "^58.0.14",
    "@expo/vector-icons": "^15.0.3",
    "@farmslot/adapter-rn": "workspace:*",
    "@farmslot/adapter-sdk": "workspace:*",
    "@farmslot/local-store": "workspace:*",
    "@farmslot/protocol": "workspace:*",
    "@farmslot/review-dispatch": "workspace:*",
    "@farmslot/theme": "workspace:*",
    "@gorhom/bottom-sheet": "^5.2.14",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native/metro-config": "0.88.1",
    "@shopify/flash-list": "2.3.2",
    "@shopify/react-native-skia": "2.14.0",
    "@siteed/audio-studio": "3.2.1",
    "@siteed/audio-ui": "1.1.2-beta.0",
    "@siteed/sherpa-onnx.rn": "1.3.1",
    "expo": "~58.0.22",
    "expo-asset": "~58.0.19",
    "expo-camera": "~58.0.14",
    "expo-clipboard": "~58.0.4",
    "expo-constants": "~58.0.14",
    "expo-dev-client": "~58.0.18",
    "expo-file-system": "~58.0.13",
    "expo-font": "~58.0.11",
    "expo-haptics": "~58.0.7",
    "expo-linking": "~58.0.15",
    "expo-notifications": "~58.1.7",
    "expo-router": "patch:expo-router@npm%3A58.0.29#~/.yarn/patches/expo-router-npm-58.0.29-9b6d4997ff.patch",
    "expo-screen-orientation": "~58.0.3",
    "expo-secure-store": "~58.0.2",
    "expo-splash-screen": "~58.0.12",
    "expo-sqlite": "~58.0.15",
    "expo-status-bar": "~58.0.4",
    "expo-system-ui": "~58.0.7",
    "expo-updates": "~58.0.20",
    "expo-video": "~58.0.13",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.1",
    "react-native-webview": "14.0.1",
    "react-native-worklets": "0.13.0",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@babel/core": "^7.29.0",
    "@farmslot/recipe-runner": "workspace:*",
    "@types/babel__core": "^7",
    "@types/node": "^25.9.1",
    "@types/react": "~19.3.0",
    "@types/react-dom": "~19.3.0",
    "agent-device": "0.19.3",
    "dotenv-flow": "^4.1.0",
    "joi": "^17.13.3",
    "tsx": "^4.19.0",
    "typescript": "~6.0.3"
  },
  "packageManager": "yarn@4.5.3",
  "expo": {
    "doctor": {
      "reactNativeDirectoryCheck": {
        "exclude": [
          "@siteed/audio-studio",
          "@siteed/sherpa-onnx.rn",
          "expo-modules-jsi"
        ]
      }
    }
  },
  "license": "MIT"
}
