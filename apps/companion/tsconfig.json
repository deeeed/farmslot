{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "resolveJsonModule": true,
    "types": ["node"],
    "paths": {
      "@farmslot/adapter-sdk/evidence": ["../../packages/adapter-sdk/src/evidence.ts"],
      "@farmslot/recipe-runner/evidence": ["../../packages/recipe-runner/src/evidence/index.ts"],
      "@/*": ["./src/*"],
      "@farmslot/theme": ["../../packages/theme/src/index.ts"],
      "@farmslot/theme/*": ["../../packages/theme/src/*"],
      "@farmslot/protocol": ["../../packages/protocol/src/index.ts"],
      "@farmslot/review-dispatch": ["../../packages/review-dispatch/src/index.ts"],
      "@farmslot/protocol/*": ["../../packages/protocol/src/*"]
    }
  },
  "include": ["**/*.ts", "**/*.tsx"]
}
