{
  "$schema": "https://farmslot.io/schemas/recipe-v1.schema.json",
  "title": "Companion ready-gate UX catalog",
  "description": "Opens a live run through native controls and captures its complete review package and Ready Gate as full-surface feedback evidence.",
  "paramsSchema": {
    "type": "object",
    "additionalProperties": false,
    "required": ["platform", "run_id"],
    "properties": {
      "platform": { "type": "string", "enum": ["ios", "android"] },
      "run_id": { "type": "string" }
    }
  },
  "proofTargets": [
    {
      "id": "ready-gate-catalog",
      "claim": "The selected run package and its entire ready-gate workflow are available in an offline feedback catalog."
    }
  ],
  "workflow": {
    "entry": "wait-review-tab",
    "nodes": {
      "wait-review-tab": {
        "action": "ui.wait_for",
        "test_id": "companion-tab-review",
        "expected": "visible",
        "intent": "Ensure the live review workspace is available before selecting its run package.",
        "next": "open-review"
      },
      "open-review": {
        "action": "ui.press",
        "test_id": "companion-tab-review",
        "intent": "Open the live review queue through native tab navigation.",
        "next": "wait-review"
      },
      "wait-review": {
        "action": "ui.wait_for",
        "test_id": "companion-screen-review",
        "expected": "visible",
        "intent": "Keep the active run inventory visible so the requested package can be selected.",
        "next": "capture-review"
      },
      "capture-review": {
        "action": "ui.capture_surface",
        "path": "{{params.platform}}/01_review.png",
        "label": "Review queue",
        "surface_test_id": "companion-screen-review",
        "until_test_id": "companion-screen-review-end",
        "max_scrolls": 12,
        "restore_position": true,
        "intent": "Anchor the selected run branch in the app navigation tree.",
        "proves": ["ready-gate-catalog"],
        "next": "open-run"
      },
      "open-run": {
        "action": "ui.press",
        "selector": "label=\"Open run {{params.run_id}}\"",
        "intent": "Open the selected run without an external deep link.",
        "next": "wait-run"
      },
      "wait-run": {
        "action": "ui.wait_for",
        "test_id": "companion-screen-run-detail",
        "expected": "visible",
        "intent": "Confirm the review package is loaded.",
        "next": "capture-run"
      },
      "capture-run": {
        "action": "ui.capture_surface",
        "path": "{{params.platform}}/10_run_detail.png",
        "label": "Ready run package — full surface",
        "surface_test_id": "companion-screen-run-detail",
        "until_test_id": "companion-screen-run-detail-end",
        "max_scrolls": 12,
        "restore_position": true,
        "visual_review": {
          "parent": "capture-review",
          "navigation": [{ "from": "capture-review", "kind": "push" }]
        },
        "intent": "Preserve the complete run package from its summary through its final scrollable section.",
        "proves": ["ready-gate-catalog"],
        "next": "open-ready-gate"
      },
      "open-ready-gate": {
        "action": "ui.press",
        "test_id": "companion-open-run-gate",
        "intent": "Open the selected run's ready workspace after preserving its full package.",
        "next": "wait-ready-gate"
      },
      "wait-ready-gate": {
        "action": "ui.wait_for",
        "test_id": "companion-screen-decision-workspace",
        "expected": "visible",
        "intent": "Confirm the full decision workspace is loaded.",
        "next": "capture-ready-gate"
      },
      "capture-ready-gate": {
        "action": "ui.capture_surface",
        "path": "{{params.platform}}/11_ready_gate_full.png",
        "label": "Ready Gate — full surface",
        "surface_test_id": "companion-screen-decision-workspace",
        "until_test_id": "companion-screen-decision-workspace-end",
        "max_scrolls": 30,
        "restore_position": false,
        "visual_review": {
          "parent": "capture-run",
          "navigation": [{ "from": "capture-run", "kind": "tab" }]
        },
        "intent": "Preserve the complete Ready Gate from its summary through its operator actions.",
        "proves": ["ready-gate-catalog"],
        "next": "open-ready-evidence"
      },
      "open-ready-evidence": {
        "action": "ui.press",
        "test_id": "companion-run-tab-evidence",
        "intent": "Return to the run Evidence tab through the shared workspace navigation.",
        "next": "wait-ready-evidence"
      },
      "wait-ready-evidence": {
        "action": "ui.wait_for",
        "test_id": "companion-screen-run-detail",
        "expected": "visible",
        "intent": "Confirm the run Evidence surface is visible before capturing it.",
        "next": "capture-ready-evidence"
      },
      "capture-ready-evidence": {
        "action": "ui.screenshot",
        "path": "{{params.platform}}/12_ready_gate_evidence.png",
        "label": "Ready Gate — Evidence",
        "visual_review": {
          "parent": "capture-run",
          "navigation": [{ "from": "capture-ready-gate", "kind": "tab" }],
          "related": ["capture-ready-diff", "capture-ready-timeline"]
        },
        "intent": "Preserve the Evidence tab reached from the Gate tab.",
        "proves": ["ready-gate-catalog"],
        "next": "open-ready-timeline"
      },
      "open-ready-timeline": {
        "action": "ui.press",
        "test_id": "companion-run-tab-timeline",
        "intent": "Select the run Timeline tab through the shared workspace navigation.",
        "next": "wait-ready-timeline"
      },
      "wait-ready-timeline": {
        "action": "ui.wait_for",
        "test_id": "companion-screen-run-detail",
        "expected": "visible",
        "intent": "Confirm the run Timeline surface is visible before capturing it.",
        "next": "capture-ready-timeline"
      },
      "capture-ready-timeline": {
        "action": "ui.screenshot",
        "path": "{{params.platform}}/13_ready_gate_timeline.png",
        "label": "Ready Gate — Timeline",
        "visual_review": {
          "parent": "capture-run",
          "navigation": [{ "from": "capture-ready-evidence", "kind": "tab" }],
          "related": ["capture-ready-evidence", "capture-ready-diff"]
        },
        "intent": "Preserve the Timeline tab selected from the run workspace.",
        "proves": ["ready-gate-catalog"],
        "next": "open-ready-diff"
      },
      "open-ready-diff": {
        "action": "ui.press",
        "test_id": "companion-run-tab-diff",
        "intent": "Select the run Diff tab through the shared workspace navigation.",
        "next": "wait-ready-diff"
      },
      "wait-ready-diff": {
        "action": "ui.wait_for",
        "test_id": "companion-screen-run-diff",
        "expected": "visible",
        "intent": "Confirm the routed Diff surface is loaded before capturing it.",
        "next": "capture-ready-diff"
      },
      "capture-ready-diff": {
        "action": "ui.capture_surface",
        "path": "{{params.platform}}/14_ready_gate_diff_full.png",
        "label": "Ready Gate — Diff",
        "surface_test_id": "companion-screen-run-diff",
        "until_test_id": "companion-screen-run-diff-end",
        "max_scrolls": 30,
        "restore_position": false,
        "visual_review": {
          "parent": "capture-run",
          "navigation": [{ "from": "capture-ready-timeline", "kind": "tab" }],
          "related": ["capture-ready-evidence", "capture-ready-timeline"]
        },
        "intent": "Preserve the complete Diff tab selected from the run workspace.",
        "proves": ["ready-gate-catalog"],
        "next": "build-catalog"
      },
      "build-catalog": {
        "action": "command",
        "cmd": "node scripts/screenshots/build-recipe-ux-catalog.mjs \"$FARMSLOT_RECIPE_ARTIFACTS_DIR\" .agent/ux-catalog-current \"{{params.platform}}\" scripts/agentic/recipe/recipes/ux-ready-gate-catalog.recipe.json",
        "timeout_ms": 30000,
        "intent": "Refresh the offline feedback catalog from the full-surface recipe artifacts.",
        "next": "index-catalog"
      },
      "index-catalog": {
        "action": "index_artifacts",
        "intent": "Attach the deep ready-gate catalog and full-height image.",
        "artifacts": [
          {
            "path": ".agent/ux-catalog-current/index.html",
            "type": "html",
            "label": "Companion UX feedback catalog"
          },
          {
            "path": ".agent/ux-catalog-current/visual-review-source.json",
            "type": "json",
            "label": "Portable visual review source"
          },
          {
            "path": ".agent/ux-catalog-current/{{params.platform}}/01_review.png",
            "type": "image",
            "label": "Review queue navigation root"
          },
          {
            "path": ".agent/ux-catalog-current/{{params.platform}}/10_run_detail.png",
            "type": "image",
            "label": "Ready run package"
          },
          {
            "path": ".agent/ux-catalog-current/{{params.platform}}/11_ready_gate_full.png",
            "type": "image",
            "label": "Ready gate full height"
          },
          {
            "path": ".agent/ux-catalog-current/{{params.platform}}/12_ready_gate_evidence.png",
            "type": "image",
            "label": "Ready gate Evidence"
          },
          {
            "path": ".agent/ux-catalog-current/{{params.platform}}/13_ready_gate_timeline.png",
            "type": "image",
            "label": "Ready gate Timeline"
          },
          {
            "path": ".agent/ux-catalog-current/{{params.platform}}/14_ready_gate_diff_full.png",
            "type": "image",
            "label": "Ready gate Diff"
          }
        ],
        "next": "done"
      },
      "done": { "action": "end", "status": "pass" }
    }
  }
}
