{
  "$schema": "https://farmslot.io/schemas/recipe-v1.schema.json",
  "title": "Companion Android review-flow UX screenshots",
  "description": "Captures default and deep review-flow Mobile Companion Android screens for before/after UX review. Requires UX_RUN_ID, UX_SLOT_ID, UX_FAMILY_ID, UX_DECISION_ID, and a real worker target (UX_WORKER_REF or UX_WORKER_NODE_ID+UX_WORKER_SESSION+UX_WORKER_TARGET). Fails closed if worker context is missing — no fabricated demo targets.",
  "proofTargets": [
    {
      "id": "ux-baseline",
      "claim": "The current Companion Android review-flow UX is captured as reviewable screenshots before or after simplification work."
    }
  ],
  "workflow": {
    "entry": "capture-baseline",
    "nodes": {
      "capture-baseline": {
        "action": "command",
        "intent": "Capture default + review-flow Companion Android screens with a real attachable worker-terminal route.",
        "cmd": "bash -c 'if [[ -z \"${UX_WORKER_REF:-}\" && ! ( -n \"${UX_WORKER_NODE_ID:-}\" && -n \"${UX_WORKER_SESSION:-}\" && -n \"${UX_WORKER_TARGET:-}\" ) ]]; then echo \"ERROR: set UX_WORKER_REF or UX_WORKER_NODE_ID+UX_WORKER_SESSION+UX_WORKER_TARGET to a real worker before review-flow capture.\" >&2; exit 1; fi; FARMSLOT_UX_SCREENSHOT_DIR=.agent/ux-baseline-screenshots bash scripts/screenshots/capture-ux-baseline-screenshots.sh --android-only --review-flow'",
        "timeout_ms": 240000,
        "next": "index-baseline",
        "proves": ["ux-baseline"]
      },
      "index-baseline": {
        "action": "index_artifacts",
        "intent": "Attach baseline screenshots to the recipe artifact package.",
        "artifacts": [
          {
            "path": ".agent/ux-baseline-screenshots/manifest.json",
            "type": "json",
            "label": "UX baseline route manifest"
          },
          {
            "path": ".agent/ux-baseline-screenshots/android/01_review.png",
            "type": "image",
            "label": "Review tab baseline"
          },
          {
            "path": ".agent/ux-baseline-screenshots/android/02_terminals.png",
            "type": "image",
            "label": "Terminals tab baseline"
          },
          {
            "path": ".agent/ux-baseline-screenshots/android/03_advanced.png",
            "type": "image",
            "label": "Advanced hub baseline"
          },
          {
            "path": ".agent/ux-baseline-screenshots/android/04_settings.png",
            "type": "image",
            "label": "Settings tab baseline"
          },
          {
            "path": ".agent/ux-baseline-screenshots/android/05_raw_fleet.png",
            "type": "image",
            "label": "Raw fleet screen baseline"
          },
          {
            "path": ".agent/ux-baseline-screenshots/android/06_raw_prs.png",
            "type": "image",
            "label": "Raw PR dashboard baseline"
          },
          {
            "path": ".agent/ux-baseline-screenshots/android/07_raw_inbox.png",
            "type": "image",
            "label": "Raw decision inbox baseline"
          },
          {
            "path": ".agent/ux-baseline-screenshots/android/10_run_detail.png",
            "type": "image",
            "label": "Run detail review package"
          },
          {
            "path": ".agent/ux-baseline-screenshots/android/11_run_evidence.png",
            "type": "image",
            "label": "Run evidence files"
          },
          {
            "path": ".agent/ux-baseline-screenshots/android/12_run_diff.png",
            "type": "image",
            "label": "Run diff view"
          },
          {
            "path": ".agent/ux-baseline-screenshots/android/20_slot_workspace.png",
            "type": "image",
            "label": "Slot workspace"
          },
          {
            "path": ".agent/ux-baseline-screenshots/android/21_slot_terminal.png",
            "type": "image",
            "label": "Contextual slot terminal"
          },
          {
            "path": ".agent/ux-baseline-screenshots/android/22_slot_diff.png",
            "type": "image",
            "label": "Slot diff view"
          },
          {
            "path": ".agent/ux-baseline-screenshots/android/23_worker_terminal.png",
            "type": "image",
            "label": "Worker terminal (real UX_WORKER_* required; fail closed if unset)"
          },
          {
            "path": ".agent/ux-baseline-screenshots/android/30_family_workspace.png",
            "type": "image",
            "label": "Family workspace"
          },
          {
            "path": ".agent/ux-baseline-screenshots/android/40_decision.png",
            "type": "image",
            "label": "Decision workspace"
          },
          {
            "path": ".agent/ux-baseline-screenshots/index.html",
            "type": "report",
            "label": "Offline UX catalog HTML report"
          }
        ],
        "next": "done",
        "proves": ["ux-baseline"]
      },
      "done": {
        "action": "end",
        "status": "pass"
      }
    }
  }
}
