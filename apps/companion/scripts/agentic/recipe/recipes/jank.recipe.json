        "next": "idle-hold"
      },
      "idle-hold": {
        "action": "wait",
        "duration_ms": "{{params.idle_ms}}",
        "intent": "Leave Review idle on the live gateway.",
        "next": "idle-end"
      },
      "idle-end": {
        "action": "app.performance_capture",
        "phase": "end",
        "id": "review-idle",
        "budget": {
          "min_sustained_fps": "{{params.min_sustained_fps}}"
        },
        "targets": {
          "fps": "{{params.target_fps}}"
        },
        "baseline": {
          "label": "main 4da00ad80 @90Hz",
          "build": "4da00ad80",
          "device": "Pixel 6",
          "refresh_hz": 60,
          "frames": 1
        },
        "intent": "Close the idle window against its budget.",
        "next": "report"
      },
      "report": {
        "action": "app.performance_capture",
        "phase": "report",
        "title": "Companion jank",
        "intent": "Write the per-flow report; a broken budget fails the run.",
        "next": "check"
      },
      "check": {
        "action": "assert_output",
        "source": "report",
        "assert": {
          "path": "$.verdict",
          "operator": "eq",
          "value": "pass"
        },
        "intent": "Every measured flow held its budget.",
        "proves": ["jank-budget"],
        "next": "done"
      },
      "done": {
        "action": "end",
        "status": "pass"
      }
    }
  }
