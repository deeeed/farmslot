{
  "$schema": "https://farmslot.io/schemas/recipe-v1.schema.json",
  "title": "Companion jank check",
  "description": "Drives Companion's main read-only flows on an Android device and fails on jank. Native frames come from adb gfxinfo framestats: a flow fails below min_sustained_fps over any 500 ms of rendering, and tab presses fail over the p95 or max press limits (touch to the mount frame). target_fps and target_press_ms are reported, never failed on. Each flow measured on main records main's baseline in its end node (4da00ad80, Pixel 6 at 90 Hz; terminal-open runs only against a sandbox and has none); a window with a coverage gap (failed polls, overwritten frames) is inconclusive and never passes; when the median tab-press p95 of at least 3 fresh release runs on main is more than 20 ms under that baseline, lower the caps and record the new baseline. Run it on the development variant with video off: screenrecord's encoder competes with the app for the frames being measured.",
  "paramsSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "min_sustained_fps": {
        "type": "number",
        "default": 30,
        "description": "Fail a flow whose lowest FPS over any 500 ms of continuous rendering is below this."
      },
      "max_tab_press_p95_ms": {
        "type": "number",
        "default": 210,
        "description": "Fail when the 95th percentile tab press (gfxinfo, touch to the mount frame) is above this. Main 4da00ad80 measured 159 ms at 90 Hz. Ratchet: lower it when the median p95 of at least 3 fresh release runs on main is more than 20 ms under the recorded baseline."
      },
      "max_tab_press_ms": {
        "type": "number",
        "default": 250,
        "description": "Fail when any tab press is above this, or cannot be timed. Main 4da00ad80 measured 192 ms at 90 Hz."
      },
      "target_fps": {
        "type": "number",
        "default": 60,
        "description": "Reported, never failed on."
      },
      "target_press_ms": {
        "type": "number",
        "default": 100,
        "description": "Reported, never failed on."
      },
      "idle_ms": {
        "type": "integer",
        "default": 20000,
        "minimum": 1000,
        "description": "How long Review sits idle on live data, up to 60000 ms."
      },
      "run_id": {
        "type": "string",
        "default": "none",
        "description": "A run on the Review queue to open and close; none skips the run detail flow."
      },
      "terminal_open": {
        "type": "string",
        "enum": ["off", "sandbox"],
        "default": "off",
        "description": "sandbox opens a terminal and goes back. Opening resizes the tmux pane, so use it only against a sandbox gateway."
      },
      "terminal_text": {
        "type": "string",
        "default": "none",
        "description": "Visible text of the Terminals row to open when terminal_open is sandbox."
      }
    }
  },
  "proofTargets": [
    {
      "id": "jank-budget",
      "claim": "Companion's tab presses, list scrolls and idle Review hold the jank budget on this Android device.",
      "proofMode": "state"
    }
  ],
