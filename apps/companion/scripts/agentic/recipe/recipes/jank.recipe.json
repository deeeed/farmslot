      },
      "run-detail-end": {
        "action": "app.performance_capture",
        "phase": "end",
        "id": "run-detail",
        "budget": {
          "min_sustained_fps": "{{params.min_sustained_fps}}"
        },
        "targets": {
          "fps": "{{params.target_fps}}",
          "press_ms": "{{params.target_press_ms}}"
        },
        "baseline": {
          "label": "main 4da00ad80 @90Hz",
          "build": "4da00ad80",
          "device": "Pixel 6",
          "refresh_hz": 90,
          "press_max_ms": 47.9,
          "frames": 139
        },
        "intent": "Close the run detail window against its budget.",
        "next": "idle-start"
      },
      "idle-start": {
        "action": "app.performance_capture",
        "phase": "start",
        "id": "review-idle",
