      },
      "back-review-settle": {
        "action": "wait",
        "duration_ms": 1500,
        "intent": "Let Review finish rendering before the next step.",
        "next": "back-review-shown"
      },
      "back-review-shown": {
        "action": "ui.wait_for",
        "test_id": "companion-screen-review",
        "expected": "visible",
        "intent": "Confirm Review is on screen.",
        "next": "run-detail-gate"
      },
      "run-detail-gate": {
        "action": "switch",
        "value": "{{params.run_id}}",
        "equals": "none",
