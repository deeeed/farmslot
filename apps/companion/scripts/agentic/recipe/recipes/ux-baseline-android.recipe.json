{
  "schema_version": 1,
  "title": "Companion Android UX baseline screenshots",
  "description": "Captures the current Mobile Companion Android screens used for evidence-first UX simplification review.",
  "proofTargets": [
    {
      "id": "ux-baseline",
      "claim": "The current Companion Android UX baseline is captured as reviewable screenshots before simplification work."
    }
  ],
  "validate": {
    "workflow": {
      "entry": "capture-baseline",
      "nodes": {
        "capture-baseline": {
          "action": "command",
          "intent": "Capture the current default Android Companion screens for before/after UX review.",
          "cmd": "FARMSLOT_UX_SCREENSHOT_DIR=.agent/ux-baseline-screenshots bash scripts/screenshots/capture-ux-baseline-screenshots.sh --android-only",
          "timeout_ms": 240000,
          "next": "index-baseline",
          "proofTarget": "ux-baseline"
        },
        "index-baseline": {
          "action": "index_artifacts",
          "intent": "Attach baseline screenshots to the recipe artifact package.",
          "artifacts": [
            {
              "path": ".agent/ux-baseline-screenshots/manifest.json",
              "type": "json",
              "label": "UX baseline route manifest"
            },
            {
              "path": ".agent/ux-baseline-screenshots/android/01_active.png",
              "type": "image",
              "label": "Active runs tab baseline"
            },
            {
              "path": ".agent/ux-baseline-screenshots/android/02_review_inbox.png",
              "type": "image",
              "label": "Review inbox tab baseline"
            },
            {
              "path": ".agent/ux-baseline-screenshots/android/03_prs.png",
              "type": "image",
              "label": "PRs tab baseline"
            },
            {
              "path": ".agent/ux-baseline-screenshots/android/04_terminals.png",
              "type": "image",
              "label": "Terminals tab baseline"
            },
            {
              "path": ".agent/ux-baseline-screenshots/android/05_fleet.png",
              "type": "image",
              "label": "Fleet tab baseline"
            },
            {
              "path": ".agent/ux-baseline-screenshots/android/06_settings.png",
              "type": "image",
              "label": "Settings tab baseline"
            }
          ],
          "next": "done",
          "proofTarget": "ux-baseline"
        },
        "done": {
          "action": "end",
          "status": "pass"
        }
      }
    }
  }
}
