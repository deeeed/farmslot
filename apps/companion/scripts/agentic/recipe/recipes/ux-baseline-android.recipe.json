{
  "$schema": "https://farmslot.io/schemas/recipe-v1.schema.json",
  "title": "Companion Android UX baseline screenshots",
  "description": "Captures the current Mobile Companion Android screens used for evidence-first UX simplification review.",
  "proofTargets": [
    {
      "id": "ux-baseline",
      "claim": "The current Companion Android UX baseline is captured as reviewable screenshots before simplification work."
    }
  ],
  "workflow": {
    "entry": "capture-baseline",
    "nodes": {
      "capture-baseline": {
        "action": "command",
        "intent": "Capture the current default Android Companion screens for before/after UX review.",
        "cmd": "FARMSLOT_UX_SCREENSHOT_DIR=.agent/ux-baseline-screenshots bash scripts/screenshots/capture-ux-baseline-screenshots.sh --android-only",
        "timeout_ms": 240000,
        "next": "index-baseline",
        "proves": ["ux-baseline"]
      },
      "index-baseline": {
        "action": "index_artifacts",
        "intent": "Attach baseline screenshots and offline HTML catalog to the recipe artifact package.",
        "artifacts": [
          {
            "path": ".agent/ux-baseline-screenshots/manifest.json",
            "type": "json",
            "label": "UX baseline route manifest"
          },
          {
            "path": ".agent/ux-baseline-screenshots/index.html",
            "type": "report",
            "label": "Offline UX catalog HTML report"
          },
          {
            "path": ".agent/ux-baseline-screenshots/android/01_review.png",
            "type": "image",
            "label": "Review tab baseline"
          },
          {
            "path": ".agent/ux-baseline-screenshots/android/02_terminals.png",
            "type": "image",
            "label": "Terminals tab baseline"
          },
          {
            "path": ".agent/ux-baseline-screenshots/android/03_advanced.png",
            "type": "image",
            "label": "Advanced hub baseline"
          },
          {
            "path": ".agent/ux-baseline-screenshots/android/04_settings.png",
            "type": "image",
            "label": "Settings tab baseline"
          },
          {
            "path": ".agent/ux-baseline-screenshots/android/05_raw_fleet.png",
            "type": "image",
            "label": "Raw fleet screen baseline"
          },
          {
            "path": ".agent/ux-baseline-screenshots/android/06_raw_prs.png",
            "type": "image",
            "label": "Raw PR dashboard baseline"
          },
          {
            "path": ".agent/ux-baseline-screenshots/android/07_raw_inbox.png",
            "type": "image",
            "label": "Raw decision inbox baseline"
          }
        ],
        "next": "done",
        "proves": ["ux-baseline"]
      },
      "done": {
        "action": "end",
        "status": "pass"
      }
    }
  }
}
