{
  "$schema": "../../schemas/project.schema.json",
  "name": "example-app-farm",
  "type": "standalone",
  "default_branch": "main",
  "paths": {
    "runtime_dir": ".agent",
    "artifact_dir": ".agent/artifacts"
  },
  "defaults": {
    "dev": {
      "runner": "claude",
      "model": "sonnet"
    }
  },
  "hooks": {
    "post_merge_install": "true",
    "preflight": "node scripts/build.mjs --port {{port}}",
    "health_check": "cat .agent/health",
    "teardown": "true"
  },
  "health": {
    "ready_indicator": "ready",
    "parse_health": "tail -1",
    "dev_server_name": "AppServer"
  },
  "fixtures": {
    "templates": [
      {
        "src": "app.env.template",
        "dst": ".agent/app.env"
      }
    ]
  },
  "platforms": {
    "cli": {
      "device_check": "true"
    }
  },
  "recipe": {
    "adapter": "headless",
    "domain": "example",
    "provider": {
      "module": "./provider.mjs"
    }
  },
  "node_support": {
    "paths": [
      "projects/example-app-farm/provider.mjs",
      "projects/example-app-farm/recipe-library.json",
      "projects/example-app-farm/manifests",
      "projects/example-app-farm/recipes",
      "projects/example-app-farm/scripts"
    ]
  },
  "execution_templates": {
    "sources": [],
    "defaults": [
      {
        "when": {
          "flow": "qa"
        },
        "templateId": "qa/recipe-smoke"
      },
      {
        "when": {
          "flow": "dev"
        },
        "templateId": "dev/default"
      }
    ]
  },
  "qa": {
    "default_profile": "smoke",
    "profiles": [
      {
        "id": "smoke",
        "title": "Example recipe smoke",
        "template_id": "qa/recipe-smoke"
      }
    ]
  },
  "scripted": {
    "commands": {
      "recipe-smoke": {
        "command": "bash \"{{farmslot_dir}}/projects/example-app-farm/scripts/recipe-smoke.sh\" \"{{farmslot_dir}}\" \"{{repo}}\" \"{{slot_id}}\"",
        "timeout_ms": 60000
      }
    }
  }
}
