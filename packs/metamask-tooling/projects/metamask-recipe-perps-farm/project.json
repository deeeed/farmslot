{
  "$schema": "../../schemas/project.schema.json",
  "name": "metamask-recipe-perps-farm",
  "type": "standalone",
  "repo_url": "git@github.com:MetaMask/experimental-metamask-recipe-perps.git",
  "default_branch": "main",
  "paths": {
    "runtime_dir": "temp/farmslot/runtime",
    "artifact_dir": "temp/farmslot/tasks"
  },
  "defaults": {
    "dev": {
      "runner": "claude",
      "model": "opus",
      "effort": "high"
    },
    "fix-bug": {
      "runner": "claude",
      "model": "opus",
      "effort": "high"
    }
  },
  "reference_repos": {
    "mobile": {
      "repo_url": "git@github.com:MetaMask/metamask-mobile.git",
      "local_name": "mmrp-mobile",
      "branch": "main"
    }
  },
  "recipe": {
    "provider": {
      "module": "@deeeed/metamask-harness/provider",
      "package": "@deeeed/metamask-harness",
      "root": {
        "env": "MM_HARNESS_PACKAGE_ROOT"
      }
    },
    "adapter": "mobile",
    "domain": "perps",
    "libraries": [
      {
        "name": "perps",
        "source": {
          "env": "METAMASK_PERPS_LIBRARY_ROOT"
        },
        "owner": "perps",
        "revision": "85ab3b95f228eff750055ae1df5b0d052b5a87aa"
      }
    ],
    "checks": [
      {
        "recipe": "perps.smoke"
      }
    ]
  },
  "command_env": {
    "set": {
      "MM_HARNESS_NO_UPDATE_CHECK": "1",
      "METAMASK_RUNNER_PROTOCOL_ROOT": "",
      "FARMSLOT_ROOT": ""
    }
  },
  "hooks": {
    "prerequisites": "bash \"{{farmslot_dir}}/projects/metamask-recipe-perps-farm/scripts/tooling.sh\" prerequisites recipe-perps \"{{repo}}\" \"{{mobile_repo}}\"",
    "preflight": "bash \"{{farmslot_dir}}/projects/metamask-recipe-perps-farm/scripts/tooling.sh\" ready recipe-perps \"{{repo}}\"",
    "health_check": "bash \"{{farmslot_dir}}/projects/metamask-recipe-perps-farm/scripts/tooling.sh\" ready recipe-perps \"{{repo}}\"",
    "dev_server_check": "bash \"{{farmslot_dir}}/projects/metamask-recipe-perps-farm/scripts/tooling.sh\" ready recipe-perps \"{{repo}}\"",
    "teardown": "bash \"{{farmslot_dir}}/projects/metamask-recipe-perps-farm/scripts/tooling.sh\" mobile-stop recipe-perps \"{{repo}}\" \"{{mobile_repo}}\" \"{{port}}\" \"{{simulator}}\" \"{{slot_id}}\""
  },
  "health": {
    "ready_indicator": "ready",
    "parse_health": "tail -1",
    "dev_server_name": "Tooling"
  },
  "platforms": {
    "ios": {
      "device_check": "true",
      "recycle": null
    }
  },
  "ci": {
    "enabled": true,
    "repo": "MetaMask/experimental-metamask-recipe-perps",
    "local_check": "PATH=\"${FARMSLOT_NODE22_BIN:+$FARMSLOT_NODE22_BIN:}$PATH\" RECIPE_HARNESS_ROOT=\"${MM_HARNESS_PACKAGE_ROOT:?set MM_HARNESS_PACKAGE_ROOT to the published harness}\" sh -ec 'node --test tests/portability.test.mjs tests/test-accounts.test.mjs tests/proof-modes.test.mjs; node scripts/check-portability.mjs; node scripts/check-proof-modes.mjs; node --experimental-strip-types --test actions/mobile/perps/rewards_fee_fixture.test.ts actions/mobile/perps/management.test.ts checks/margin-mode-composition.test.ts; node --test actions/shared/funds/*.test.mjs; node --experimental-strip-types --test checks/management-composition.test.ts checks/advanced-order-composition.test.ts checks/funds-composition.test.mjs'"
  },
  "node_support": {
    "paths": [
      "projects/metamask-recipe-perps-farm/setup",
      "projects/metamask-recipe-perps-farm/scripts",
      "projects/metamask-recipe-perps-farm/templates"
    ]
  },
  "execution_templates": {
    "sources": [],
    "defaults": [
      {
        "when": {
          "flow": "dev"
        },
        "templateId": "dev/tooling"
      },
      {
        "when": {
          "flow": "fix-bug"
        },
        "templateId": "fix-bug/tooling"
      },
      {
        "when": {
          "flow": "qa"
        },
        "templateId": "qa/tooling"
      }
    ]
  },
  "qa": {
    "profiles": [
      {
        "id": "tooling-pr",
        "title": "Recipe library PR with Mobile after-fix proof",
        "description": "Run the frozen library checks, then prove the change on this slot's owned Mobile fixture with the candidate library selected explicitly.",
        "template_id": "qa/tooling",
        "inputs": {
          "scope": {
            "kind": "pr"
          }
        }
      }
    ]
  },
  "prepare": {
    "core": {
      "label": "Recipe library checkout",
      "description": "Sync the recipe library checkout. It has no dependency manifest. Mobile, Metro and the simulator are acquired only through the mobile-proof capability.",
      "phases": [
        "git",
        "fixtures",
        "preflight",
        "health"
      ]
    }
  },
  "resources": {
    "ios-sim": {
      "type": "device",
      "platform": "ios",
      "label": "Owned Mobile simulator",
      "streamable": true,
      "controllable": true,
      "watch": {
        "type": "process-poll",
        "provider": "ios-simulator-inventory",
        "target": "{{simulator}}",
        "cmd": "xcrun simctl list devices booted 2>/dev/null | grep -q '{{simulator}}'"
      },
      "hooks": {
        "health": "xcrun simctl list devices booted 2>/dev/null | grep -q '{{simulator}}'",
        "boot": "xcrun simctl boot '{{simulator}}' 2>/dev/null || xcrun simctl list devices booted | grep -q '{{simulator}}'",
        "shutdown": "xcrun simctl shutdown '{{simulator}}'"
      }
    },
    "mobile-runtime": {
      "type": "dev-server",
      "label": "Owned Mobile Metro and dev client",
      "streamable": false,
      "controllable": true,
      "watch": {
        "type": "port-listen",
        "port": "{{port}}"
      },
      "hooks": {
        "boot": "bash \"{{farmslot_dir}}/projects/metamask-recipe-perps-farm/scripts/tooling.sh\" mobile-boot recipe-perps \"{{repo}}\" \"{{mobile_repo}}\" \"{{port}}\" \"{{simulator}}\" \"{{slot_id}}\" \"{{farmslot_dir}}\"",
        "health": "bash \"{{farmslot_dir}}/projects/metamask-recipe-perps-farm/scripts/tooling.sh\" mobile-health recipe-perps \"{{repo}}\" \"{{mobile_repo}}\" \"{{port}}\" \"{{simulator}}\"",
        "shutdown": "bash \"{{farmslot_dir}}/projects/metamask-recipe-perps-farm/scripts/tooling.sh\" mobile-stop recipe-perps \"{{repo}}\" \"{{mobile_repo}}\" \"{{port}}\" \"{{simulator}}\" \"{{slot_id}}\""
      }
    }
  },
  "runtime_capabilities": {
    "providers": {
      "mobile-proof": {
        "label": "Owned Mobile live-proof fixture",
        "description": "Boot this slot's simulator and launch its own Mobile checkout on the slot Metro port through the published harness; the candidate library is selected per command. Release stops Metro and retains the simulator and installed dev client.",
        "version": "1",
        "share_policy": "exclusive",
        "cost": {
          "class": "high",
          "resources": [
            {
              "id": "ios-sim",
              "kind": "device",
              "access": "exclusive",
              "scope": "slot"
            },
            {
              "id": "mobile-runtime",
              "kind": "process",
              "access": "exclusive",
              "scope": "slot"
            }
          ]
        },
        "actions": {
          "acquire": {
            "kind": "resource",
            "resource_id": "mobile-runtime",
            "action": "boot"
          },
          "health": {
            "kind": "resource",
            "resource_id": "mobile-runtime",
            "action": "health"
          },
          "release": {
            "kind": "resource",
            "resource_id": "mobile-runtime",
            "action": "shutdown"
          }
        },
        "affected_resources": [
          {
            "resource_id": "mobile-runtime",
            "ownership": "capability",
            "release_effect": "stop"
          },
          {
            "resource_id": "ios-sim",
            "ownership": "slot-lifecycle",
            "release_effect": "retain"
          }
        ],
        "release_effects": [
          "Stop this slot's Metro; keep its simulator, dev client and wallet fixture for the next proof."
        ],
        "keep_warm_ms": 0
      }
    }
  },
  "worker_terminal": {
    "flows": {
      "dev": {
        "acceptance": {
          "require": true
        },
        "complete": {
          "report": "artifacts/pr-description.md",
          "artifacts": [
            "artifacts/pr-description.md",
            "artifacts/report.md",
            "artifacts/recipe-coverage.md"
          ]
        }
      },
      "fix-bug": {
        "acceptance": {
          "require": true
        },
        "complete": {
          "report": "artifacts/pr-description.md",
          "artifacts": [
            "artifacts/pr-description.md",
            "artifacts/report.md",
            "artifacts/recipe-coverage.md"
          ]
        }
      },
      "qa": {
        "complete": {
          "report": "artifacts/report.md",
          "artifacts": [
            "artifacts/report.md",
            "artifacts/recipe-coverage.md"
          ]
        }
      }
    }
  },
  "publication_review": {
    "dev": {
      "minimum_reviews": 1
    },
    "fix-bug": {
      "minimum_reviews": 1
    }
  },
  "slot_actions": {
    "mobile-deps": {
      "label": "Install owned Mobile dependencies",
      "description": "Run Mobile's own minimal JavaScript setup in this slot's Mobile checkout.",
      "command": "bash \"{{farmslot_dir}}/projects/metamask-recipe-perps-farm/scripts/tooling.sh\" mobile-deps recipe-perps \"{{repo}}\" \"{{mobile_repo}}\"",
      "timeoutMs": 3600000,
      "refresh": [
        "resources"
      ]
    },
    "mobile-dev-client": {
      "label": "Install Mobile dev client",
      "description": "Install the cached Runway iOS dev client on this slot's simulator through the published harness.",
      "command": "bash \"{{farmslot_dir}}/projects/metamask-recipe-perps-farm/scripts/tooling.sh\" mobile-client recipe-perps \"{{repo}}\" \"{{mobile_repo}}\" \"{{port}}\" \"{{simulator}}\" \"{{slot_id}}\"",
      "timeoutMs": 1800000,
      "refresh": [
        "resources"
      ]
    },
    "mobile-wallet-fixture": {
      "label": "Apply approved testnet wallet fixture",
      "description": "Install the operator-provided testnet wallet fixture into this slot's Mobile checkout.",
      "command": "bash \"{{farmslot_dir}}/projects/metamask-recipe-perps-farm/scripts/tooling.sh\" mobile-fixture recipe-perps \"{{repo}}\" \"{{mobile_repo}}\" \"{{farmslot_dir}}/projects/metamask-recipe-perps-farm/fixtures/runtime/wallet-fixture.json\" \"{{slot_id}}\"",
      "refresh": [
        "resources"
      ]
    },
    "tooling-candidate": {
      "label": "Show after-fix candidate",
      "mode": "copy",
      "command": "bash \"{{farmslot_dir}}/projects/metamask-recipe-perps-farm/scripts/tooling.sh\" candidate recipe-perps \"{{repo}}\"",
      "refresh": [
        "none"
      ]
    }
  }
}
