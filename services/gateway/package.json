{
  "name": "@farmslot/gateway",
  "version": "0.2.1",
  "private": true,
  "type": "module",
  "main": "src/index.ts",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "typecheck": "tsc --noEmit --project tsconfig.json",
    "test": "node ../../scripts/quality/run-tsx-tests.mjs --cwd . --tsconfig tsconfig.json src",
    "quality": "yarn typecheck && yarn test",
    "postinstall": "node scripts/fix-node-pty-spawn-helper.mjs"
  },
  "dependencies": {
    "@earendil-works/pi-ai": "0.74.2",
    "@farmslot/capabilities": "workspace:*",
    "@farmslot/protocol": "workspace:*",
    "@farmslot/run-bundle": "workspace:*",
    "@sinclair/typebox": "^0.34.49",
    "chokidar": "^4.0.0",
    "node-pty": "^1.0.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/ws": "^8.5.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  },
  "license": "MIT"
}
