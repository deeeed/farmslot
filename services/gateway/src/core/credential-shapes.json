{
  "$comment": "Credential value shapes. One owner: credential-redaction.ts (gateway) and blind-git.py (node, sent with the blind boundary) both read this file. Patterns use the syntax JavaScript and Python share.",
  "providerTokens": [
    "sk-ant-[A-Za-z0-9_-]{16,}",
    "sk-[A-Za-z0-9_-]{17,}",
    "gh[pos]_[A-Za-z0-9]{20,}",
    "github_pat_[A-Za-z0-9_]{20,}",
    "ATATT[A-Za-z0-9_=-]{20,}",
    "xox[bp]-[A-Za-z0-9-]{10,}",
    "AKIA[0-9A-Z]{16}(?![0-9A-Z])",
    "glpat-[A-Za-z0-9_-]{20,}",
    "npm_[A-Za-z0-9]{36}(?![A-Za-z0-9])",
    "AIza[0-9A-Za-z_-]{35}(?![0-9A-Za-z_-])",
    "hf_[A-Za-z0-9]{30,}",
    "xai-[A-Za-z0-9]{20,}",
    "fw_[A-Za-z0-9]{20,}"
  ],
  "slugOrPath": "^[~.]?/?[\\w.-]+(?:/[\\w.-]+)+/?$",
  "characterClasses": ["[a-z]", "[A-Z]", "\\d"],
  "minLength": 16,
  "minCharacterClasses": 2
}
