{
  "modelAllowlist": ["scripted", "haiku", "gpt-6-luna"],
  "budgetsS": {
    "find-slot": 10,
    "write-task": 20,
    "prepare": 90,
    "dispatch": 90,
    "monitor": 60,
    "complete": 30,
    "human-gate": 30,
    "finalize": 30,
    "ci-watch": 30,
    "release": 120,
    "native-check": 10
  },
  "knownFailures": [
    {
      "case": "review",
      "variant": "node-away",
      "signature": "No node connected for machine \\S+ after 120000ms",
      "differences": ["^REVIEW did not keep its reviewer: failed \\("],
      "ledger": "F-pending (review node-away past 120 s)"
    },
    {
      "case": "worker-survives",
      "variant": "dispatch",
      "signature": "tmux stop sent: .*(/exit|respawn-window)",
      "differences": [
        "^tmux stop sent: .*(/exit| C-c|respawn-(pane|window)|kill-(pane|window|session))",
        "^pid \\d+ exited: ",
        "^worker pane %\\d+ (is gone|is dead|was respawned)"
      ],
      "ledger": "F331"
    },
    {
      "case": "worker-survives",
      "variant": "review-fix",
      "signature": "Recovered review fix worker could not accept its prompt",
      "differences": [
        "^the run went needs-decision: Recovered review fix worker could not accept its prompt",
        "^run status: expected done, observed needs-decision$",
        "^step \\d+: expected review:done, observed review:failed$",
        "^step \\d+: expected (complete|human-gate|finalize|ci-watch):done, observed \\1:pending$",
        "^decisions: expected \\[engine_output_review:open\\], observed \\[engine_output_review:open, engine_result_decision:open\\]$",
        "^decision types: expected \\[engine_output_review\\], observed \\[engine_output_review, engine_result_decision\\]$",
        "^slot: expected ready/-, observed busy/working$",
        "^re-review: expected pass, observed none$",
        "^\\d+ reviewers ran, expected \\d+$"
      ],
      "ledger": "F332"
    }
  ],
  "live": {
    "profileHome": "~/.farmslot-automation",
    "profile": "farm-automation",
    "nodes": [
      { "machine": "macpro", "slot": "macpro-canary-1" },
      { "machine": "mini", "slot": "mini-canary-1" }
    ],
    "f324Node": "mini"
  }
}
