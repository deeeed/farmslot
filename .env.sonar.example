# Copy to .env.sonar.local and fill in local/private values.
# Never commit .env.sonar.local.

# SonarQube Server example: https://sonarqube.example.com
# SonarQube Cloud example: https://sonarcloud.io
SONAR_HOST_URL=https://sonarcloud.io

# Project key from SonarQube/SonarCloud. Keep this generic in OSS examples.
SONAR_PROJECT_KEY=

# SonarCloud only. Leave empty for self-hosted SonarQube Server.
SONAR_ORGANIZATION=farmslot

# Token with Execute Analysis permission for scanning and Browse permission for issue fetches.
SONAR_TOKEN=

# Optional local filters for issue fetching.
# SONAR_BRANCH=
# SONAR_PULL_REQUEST=
# SONAR_COMPONENT_KEYS=
